{
  "name": "blackbox-records",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "pnpm dev:stack:stripe-mock",
    "dev:web": "pnpm --filter @blackbox/web dev",
    "dev:staff": "pnpm --filter @blackbox/staff dev",
    "site:dev": "pnpm --filter @blackbox/web dev:static",
    "site:dev:bg": "pnpm --filter @blackbox/web dev:bg",
    "site:dev:status": "pnpm --filter @blackbox/web dev:status",
    "site:dev:logs": "pnpm --filter @blackbox/web dev:logs",
    "site:dev:stop": "pnpm --filter @blackbox/web dev:stop",
    "dev:clean": "pnpm --filter @blackbox/web dev:clean",
    "cms:inventory": "node scripts/inventory-cms-content.mjs",
    "dev:backend": "pnpm --filter @blackbox/backend dev",
    "dev:backend:mock": "pnpm --filter @blackbox/backend dev:mock",
    "dev:backend:mock-api": "pnpm --filter @blackbox/backend dev:mock-api",
    "dev:backend:uat": "pnpm --filter @blackbox/backend dev:uat",
    "dev:backend:sandbox": "pnpm --filter @blackbox/backend dev:sandbox",
    "stripe-mock:local": "tsx scripts/start-stripe-mock.ts",
    "dev:stack:stripe-test": "node scripts/run-local-stack.mjs stripe-test",
    "dev:stack:stripe-mock": "node scripts/run-local-stack.mjs stripe-mock",
    "dev:stack:stripe-mock-api": "node scripts/run-local-stack.mjs stripe-mock-api",
    "dev:stack:uat-connected": "node scripts/run-local-stack.mjs uat-connected",
    "checkout:preflight:stripe-test": "tsx scripts/check-stripe-test-checkout.ts",
    "stripe:catalog:verify": "tsx scripts/stripe-catalog-verify.ts",
    "store:listing-readiness:verify": "tsx scripts/verify-store-listing-readiness.ts",
    "catalog:readiness:generate": "tsx scripts/generate-catalog-readiness.ts --write",
    "prd:catalog-readiness:check": "tsx scripts/check-production-catalog-readiness.ts",
    "production:catalog-readiness:check": "pnpm prd:catalog-readiness:check",
    "catalog:checkout:pause": "tsx scripts/pause-catalog-checkout.ts",
    "runtime:config:verify": "tsx scripts/verify-runtime-config.ts",
    "environment:model:verify": "tsx scripts/verify-environment-model.ts",
    "email:previews": "tsx scripts/render-paid-order-email-previews.ts",
    "stripe:payment-methods:verify": "tsx scripts/verify-stripe-payment-method-configuration.ts",
    "stripe:webhooks:verify": "tsx scripts/verify-stripe-webhook-endpoints.ts",
    "smoke:stripe-uat": "tsx scripts/smoke-stripe-sandbox.ts",
    "smoke:stripe-sandbox": "pnpm smoke:stripe-uat",
    "smoke:resend-uat": "tsx scripts/smoke-resend-uat.ts",
    "smoke:stripe-promotion": "tsx scripts/smoke-stripe-promotion.ts",
    "smoke:uat-static": "tsx scripts/smoke-uat-static.ts",
    "stripe:webhook:simulate:local": "pnpm --filter @blackbox/backend webhook:simulate:local",
    "openspec:guard": "tsx scripts/assert-openspec-worktree.ts",
    "openspec": "tsx scripts/run-openspec.ts",
    "openspec:readonly": "pnpm openspec",
    "deploy:backend:sandbox": "pnpm deploy:backend:uat",
    "deploy:backend:uat": "pnpm --filter @blackbox/backend deploy:uat",
    "deploy:backend:prd": "pnpm --filter @blackbox/backend deploy:prd",
    "deploy:backend:production": "pnpm deploy:backend:prd",
    "worker:dev": "pnpm dev:backend",
    "worker:dev:uat": "pnpm dev:backend:uat",
    "worker:dev:sandbox": "pnpm worker:dev:uat",
    "build": "node scripts/feedback-guard.mjs build && nx run-many -t build",
    "validate": "node --import tsx scripts/validate-local.mjs",
    "agent:check": "node scripts/check-agent-guidance.mjs",
    "validate:full": "node scripts/feedback-guard.mjs validate:full && node --import tsx scripts/validate.mjs --full",
    "validate:fast": "node --import tsx scripts/validate.mjs --fast",
    "benchmark:validation": "node scripts/feedback-guard.mjs benchmark:validation && node --import tsx scripts/benchmark-validation.mjs",
    "ci:speed": "node scripts/ci-speed-measurement.mjs",
    "build:web": "pnpm --filter @blackbox/web build && tsx scripts/check-frontend-route-isolation.ts web && pnpm performance:bundles",
    "build:content-snapshot": "node scripts/build-content-snapshot.mjs",
    "cms:snapshot:export": "node --import tsx scripts/export-cms-snapshot.mjs",
    "build:staff": "pnpm --filter @blackbox/staff build && tsx scripts/check-frontend-route-isolation.ts staff && pnpm performance:bundles --scope=staff",
    "cache:policy:check": "pnpm --filter @blackbox/web cache:policy:check",
    "cache:policy:hosted-audit": "pnpm --filter @blackbox/web cache:policy:hosted-audit",
    "brand-font:check": "pnpm --filter @blackbox/web brand-font:check",
    "performance:runtime": "tsx scripts/measure-runtime-performance.ts",
    "performance:bundles": "tsx scripts/check-runtime-bundle-graphs.ts",
    "generate:api": "pnpm --filter @blackbox/backend generate:openapi && pnpm --filter @blackbox/api-client generate",
    "assets:check": "pnpm --filter @blackbox/web assets:check",
    "store:categories:check": "tsx scripts/check-store-category-output.ts",
    "prd:holding:prepare": "pnpm --filter @blackbox/web prd:holding:prepare",
    "prd:holding:check": "pnpm --filter @blackbox/web prd:holding:check",
    "audit:commerce-boundaries": "tsx scripts/audit-commerce-boundaries.ts",
    "audit:module-boundaries": "tsx scripts/audit-module-boundaries.ts",
    "audit:unused": "knip --config knip.jsonc --no-exit-code --no-config-hints",
    "renovate:validate": "pnpm dlx --allow-build=core-js-pure --allow-build=dtrace-provider --allow-build=protobufjs --allow-build=re2 --package renovate@44.115.10 renovate-config-validator --strict",
    "preview": "pnpm --filter @blackbox/web preview",
    "format": "node scripts/format-check.mjs --write",
    "format:check": "node scripts/format-check.mjs",
    "format:check:uncached": "node scripts/feedback-guard.mjs format:check:uncached && prettier . --check",
    "lint": "node scripts/feedback-guard.mjs lint && nx run-many -t lint",
    "lint:fix": "node scripts/feedback-guard.mjs lint:fix && eslint . --fix",
    "check": "node scripts/feedback-guard.mjs check && nx run-many -t lint typecheck",
    "check:boundaries": "pnpm agent:check && pnpm audit:module-boundaries && pnpm depcruise:boundaries && pnpm audit:commerce-boundaries",
    "check:types": "node scripts/feedback-guard.mjs check:types && nx run-many -t typecheck",
    "check:web": "node scripts/feedback-guard.mjs check:web && pnpm --filter @blackbox/web check",
    "check:staff": "node scripts/feedback-guard.mjs check:staff && pnpm --filter @blackbox/staff check",
    "check:backend": "node scripts/feedback-guard.mjs check:backend && pnpm --filter @blackbox/backend check",
    "check:api-client": "node scripts/feedback-guard.mjs check:api-client && pnpm --filter @blackbox/api-client check",
    "test:unit": "node scripts/feedback-guard.mjs test:unit && nx run-many -t test",
    "test:watch": "node --import tsx scripts/test-watch.mjs",
    "test:changed": "node --import tsx scripts/test-watch.mjs --changed",
    "test:contracts": "pnpm test:tooling && pnpm test:content",
    "test:tooling": "pnpm test:agent && pnpm test:release && pnpm test:runner && pnpm test:boundaries",
    "test:agent": "node --import tsx --test --test-concurrency=1 \"scripts/check-agent-guidance.test.mjs\" \"scripts/feedback-policy.test.mjs\" \"scripts/feedback-guard.test.mjs\" \"scripts/feedback-grant.test.mjs\" \"scripts/feedback-contract.test.mjs\" \"scripts/feedback-report.test.mjs\" \"scripts/run-e2e.test.mjs\" \"scripts/local-resources.test.mjs\" \"scripts/local-status.test.mjs\" \"scripts/agent-hooks/*.test.mjs\" \".codex/hooks/*.test.mjs\"",
    "test:release": "pnpm --filter @blackbox/web exec vitest --root ../.. --config scripts/vitest.contracts.config.ts run && node --import tsx --test --test-concurrency=1 \"scripts/ci-speed-measurement.test.mjs\" \"scripts/pages-public-gateway.test.mjs\" \"scripts/release-candidate.test.mjs\" \"scripts/run-release-preparation.test.mjs\"",
    "test:runner": "node --import tsx --test --test-concurrency=1 \"scripts/format-check.test.mjs\" \"scripts/machine-slots.test.mjs\" \"scripts/validate-acceptance.test.mjs\" \"scripts/validate-local.test.mjs\" \"scripts/validate.test.mjs\"",
    "test:boundaries": "node --import tsx --test --test-concurrency=1 \"scripts/check-module-projects.test.mjs\" \"scripts/module-boundaries-enforcement.test.mjs\"",
    "test:content": "node --import tsx --test --test-concurrency=1 \"scripts/apply-cms-import.test.mjs\" \"scripts/capture-cms-snapshot.test.mjs\" \"scripts/cms-content-schema.test.mjs\" \"scripts/cms-draft.test.mjs\" \"scripts/cms-markdown.test.mjs\" \"scripts/cms-snapshot-readers.test.mjs\" \"scripts/editorial-draft-creation.test.mjs\" \"scripts/inventory-cms-content.test.mjs\" \"scripts/local-publication-poll.test.mjs\" \"scripts/stage-cms-snapshot.test.mjs\" \"apps/backend/test/emdash/*.test.mjs\"",
    "validate:editor": "node scripts/feedback-guard.mjs validate:editor && node --import tsx scripts/validate.mjs --editor",
    "validate:checks": "node scripts/feedback-guard.mjs validate:checks && node --import tsx scripts/validate.mjs --checks",
    "test:app-shell": "pnpm test app-shell",
    "test:e2e": "node --import tsx scripts/run-e2e.mjs",
    "test:web": "node scripts/feedback-guard.mjs test:web && pnpm --filter @blackbox/web test:unit",
    "test:staff": "node scripts/feedback-guard.mjs test:staff && pnpm --filter @blackbox/staff test:unit",
    "test:backend": "node scripts/feedback-guard.mjs test:backend && pnpm --filter @blackbox/backend test",
    "test:api-client": "node scripts/feedback-guard.mjs test:api-client && pnpm --filter @blackbox/api-client test",
    "depcruise:boundaries": "depcruise --config .dependency-cruiser.cjs apps/web/src apps/staff/src apps/backend/src packages/api-client/src packages/content-model/src",
    "catalog:bindings:migrate": "pnpm --filter @blackbox/backend exec tsx scripts/migrate-catalog-product-bindings.ts",
    "cms:import:local": "node --import tsx scripts/import-cms-content.mjs",
    "catalog:backfill": "tsx apps/backend/scripts/backfill-runtime-catalog.ts",
    "feedback:grant-full": "node scripts/feedback-grant.mjs",
    "feedback:report": "node scripts/feedback-report.mjs",
    "local:status": "node scripts/local-status.mjs",
    "test": "node --import tsx scripts/test-watch.mjs --run"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@blackbox/content-model": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@t3-oss/env-core": "^0.13.11",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-boundaries": "^7.2.0",
    "execa": "10.0.1",
    "knip": "^6.38.0",
    "nx": "23.2.1",
    "playwright": "1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "sharp": "0.35.4",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "4.1.11",
    "yaml": "2.9.1",
    "zod": "^4.6.5"
  },
  "nx": {
    "includedScripts": []
  }
}

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "mergeConfidence:all-badges"],
  "timezone": "Europe/Bucharest",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency Dashboard",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "addLabels": ["dependencies"],
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": { "schedule": ["at any time"], "addLabels": ["security"] },
  "lockFileMaintenance": { "enabled": true, "automerge": true },
  "hostRules": [
    {
      "description": "Read the private BOX NOW widget from GitHub Packages with the Mend app secret.",
      "matchHost": "npm.pkg.github.com",
      "hostType": "npm",
      "token": "{{ secrets.BOXNOW_PACKAGES_TOKEN }}"
    }
  ],
  "packageRules": [
    {
      "description": "Automerge low-risk dev tooling once checks pass; later rules with automerge false win.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Require dashboard approval for major updates.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "addLabels": ["major"]
    },
    {
      "description": "Group Astro frontend build packages.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["astro", "@astrojs/check", "prettier-plugin-astro"],
      "groupName": "Astro frontend build packages",
      "groupSlug": "astro-frontend-build"
    },
    {
      "description": "Group React UI runtime and type packages.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom", "@astrojs/react"],
      "groupName": "React UI packages",
      "groupSlug": "react-ui"
    },
    {
      "description": "Group Tailwind and shadcn UI styling packages.",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "tailwindcss",
        "@tailwindcss/vite",
        "tailwind-merge",
        "tw-animate-css",
        "class-variance-authority",
        "shadcn"
      ],
      "groupName": "Tailwind and shadcn packages",
      "groupSlug": "tailwind-shadcn"
    },
    {
      "description": "Group TypeScript, lint, and format packages.",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "typescript",
        "@types/node",
        "@eslint/js",
        "eslint",
        "eslint-config-prettier",
        "eslint-import-resolver-typescript",
        "eslint-plugin-astro",
        "eslint-plugin-boundaries",
        "prettier",
        "typescript-eslint"
      ],
      "groupName": "TypeScript lint and format packages",
      "groupSlug": "typescript-lint-format"
    },
    {
      "description": "Keep TypeScript on 5.x until OpenAPI tooling supports newer compiler peers.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.0.0",
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Keep Node types aligned with the Node 24 LTS runtime.",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": ">=24.0.0 <25.0.0"
    },
    {
      "description": "@cloudflare/vitest-plugin supports Vitest 4.1 and 5 peers.",
      "matchPackageNames": ["vitest"],
      "allowedVersions": ">=4.1.0 <6.0.0"
    },
    {
      "description": "Keep editor providers aligned with EmDash admin's Lingui 5 and React Query dependency.",
      "matchPackageNames": ["@lingui/core", "@lingui/react"],
      "allowedVersions": ">=5.9.4 <6.0.0"
    },
    {
      "description": "EmDash admin and the staff editor must share one React Query provider instance.",
      "matchPackageNames": ["@tanstack/react-query"],
      "allowedVersions": "5.90.21"
    },
    {
      "description": "Playwright 1.64.x hangs Firefox page.setViewportSize (microsoft/playwright#43028); hold until a fixed release.",
      "matchPackageNames": ["playwright"],
      "allowedVersions": "<1.64.0"
    },
    {
      "description": "Keep the Playwright image below 1.64.0 with the npm package.",
      "matchPackageNames": ["mcr.microsoft.com/playwright"],
      "allowedVersions": "/^v(?:0\\.\\d+\\.\\d+|1\\.(?:[0-5]?\\d|6[0-3])\\.\\d+)-noble$/"
    },
    {
      "description": "Group test and browser automation packages.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["vitest", "msw", "playwright"],
      "groupName": "Test and browser automation packages",
      "groupSlug": "test-browser-automation"
    },
    {
      "description": "Group the Playwright image with its npm package.",
      "matchPackageNames": ["mcr.microsoft.com/playwright"],
      "groupName": "Test and browser automation packages",
      "groupSlug": "test-browser-automation"
    },
    {
      "description": "Group Cloudflare Worker runtime and test adapter packages.",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "wrangler",
        "@cloudflare/workers-types",
        "@cloudflare/vitest-plugin",
        "@cloudflare/flagship"
      ],
      "groupName": "Cloudflare Worker packages",
      "groupSlug": "cloudflare-worker",
      "dependencyDashboardApproval": true,
      "automerge": false,
      "addLabels": ["runtime"]
    },
    {
      "description": "Group Prisma D1 persistence packages.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["prisma", "@prisma/client", "@prisma/adapter-d1"],
      "groupName": "Prisma D1 persistence packages",
      "groupSlug": "prisma-d1",
      "ignoreUnstable": true,
      "dependencyDashboardApproval": true,
      "automerge": false,
      "addLabels": ["persistence"]
    },
    {
      "description": "Group backend API and commerce contract packages.",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "stripe",
        "hono",
        "@hono/zod-openapi",
        "zod",
        "openapi-typescript",
        "openapi-typescript-fetch"
      ],
      "groupName": "Backend API and commerce contract packages",
      "groupSlug": "backend-api-commerce-contracts",
      "dependencyDashboardApproval": true,
      "automerge": false,
      "addLabels": ["runtime"]
    },
    {
      "description": "Group local process and script runner packages.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["tsx", "execa"],
      "groupName": "Process and script runner packages",
      "groupSlug": "process-script-runners"
    },
    {
      "description": "Group GitHub Actions and workflow runtime references.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": [
        "actions/checkout",
        "actions/setup-node",
        "actions/upload-artifact",
        "actions/download-artifact",
        "actions/cache",
        "cloudflare/wrangler-action",
        "pnpm/action-setup"
      ],
      "groupName": "GitHub Actions workflow dependencies",
      "groupSlug": "github-actions-workflows",
      "dependencyDashboardApproval": true,
      "automerge": false,
      "addLabels": ["ci"]
    },
    {
      "description": "Our own BOX NOW widget: review every release, with no waiting period.",
      "matchPackageNames": ["@coding-tree-io/boxnow-widget"],
      "automerge": false,
      "minimumReleaseAge": null
    }
  ]
}

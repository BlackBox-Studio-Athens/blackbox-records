{
  "name": "staff-content",
  "tags": ["module", "scope:staff"],
  "targets": {
    "test": {
      "command": "pnpm --filter @blackbox/staff exec vitest run --project=staff-content --config vitest.modules.config.ts",
      "inputs": ["staffTests", "^default"]
    },
    "test-watch": {
      "command": "pnpm --filter @blackbox/staff exec vitest --watch --project=staff-content --config vitest.modules.config.ts",
      "cache": false,
      "continuous": true
    }
  },
  "metadata": {
    "boundaries": {
      "status": "closed",
      "exports": ["./ContentApp.tsx", "./ItemSetupApp.tsx"],
      "namedInterfaces": {},
      "dependsOn": ["staff-ui", "staff-platform", "staff-publication", "staff-stock"],
      "workspaceInterfaces": {
        "@blackbox/content-model": ["."]
      }
    }
  }
}

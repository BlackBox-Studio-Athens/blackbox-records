{
  "name": "staff-orders",
  "tags": ["module", "scope:staff"],
  "targets": {
    "test": {
      "command": "pnpm --filter @blackbox/staff exec vitest run --project=staff-orders --config vitest.modules.config.ts",
      "inputs": ["staffTests", "^default"]
    },
    "test-watch": {
      "command": "pnpm --filter @blackbox/staff exec vitest --watch --project=staff-orders --config vitest.modules.config.ts",
      "cache": false,
      "continuous": true
    }
  },
  "metadata": {
    "boundaries": {
      "status": "closed",
      "exports": ["./OrderWorkspace.tsx", "./internal-order-api.ts"],
      "namedInterfaces": {},
      "dependsOn": ["staff-ui", "staff-platform"],
      "workspaceInterfaces": {
        "@blackbox/api-client": ["./internal"]
      }
    }
  }
}

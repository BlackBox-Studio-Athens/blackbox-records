{
  "name": "staff-stock",
  "tags": ["module", "scope:staff"],
  "targets": {
    "test": {
      "command": "pnpm --filter @blackbox/staff exec vitest run --project=staff-stock --config vitest.modules.config.ts",
      "inputs": ["staffTests", "^default"]
    },
    "test-watch": {
      "command": "pnpm --filter @blackbox/staff exec vitest --watch --project=staff-stock --config vitest.modules.config.ts",
      "cache": false,
      "continuous": true
    }
  },
  "metadata": {
    "boundaries": {
      "status": "closed",
      "exports": [
        "./CatalogSelling.tsx",
        "./FormatFilter.tsx",
        "./ItemPriceEditor.tsx",
        "./ItemPublication.tsx",
        "./StockOperationsApp.tsx",
        "./ZeroStockStateControl.tsx"
      ],
      "namedInterfaces": {},
      "dependsOn": ["staff-ui", "staff-platform", "staff-publication"],
      "workspaceInterfaces": {
        "@blackbox/content-model": ["."]
      }
    }
  }
}

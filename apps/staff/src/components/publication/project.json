{
  "name": "staff-publication",
  "tags": ["module", "scope:staff"],
  "targets": {
    "test": {
      "command": "pnpm --filter @blackbox/staff exec vitest run --project=staff-publication --config vitest.modules.config.ts",
      "inputs": ["staffTests", "^default"]
    },
    "test-watch": {
      "command": "pnpm --filter @blackbox/staff exec vitest --watch --project=staff-publication --config vitest.modules.config.ts",
      "cache": false,
      "continuous": true
    }
  },
  "metadata": {
    "boundaries": {
      "status": "closed",
      "exports": [
        "./ContentPreview.tsx",
        "./PublicationHistory.tsx",
        "./PublicationReviewFlow.tsx",
        "./PublicationStatus.tsx",
        "./WebsiteChanges.tsx",
        "./content-validation.ts",
        "./content.css"
      ],
      "namedInterfaces": {},
      "dependsOn": ["staff-ui", "staff-platform"],
      "workspaceInterfaces": {
        "@blackbox/content-model": ["."]
      }
    }
  }
}

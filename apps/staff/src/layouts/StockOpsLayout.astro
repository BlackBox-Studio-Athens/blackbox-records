---
import '../styles/global.css';
import StaffShell from '../components/StaffShell';
import '../styles/staff-workspace.css';

interface Props {
  pageTitle: string;
  pageDescription: string;
}

const { pageTitle, pageDescription } = Astro.props;
const htmlTitle = pageTitle + ' | BlackBox Records';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{htmlTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Geist+Mono:wght@400;500&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    data-workspace={Astro.url.pathname.startsWith('/content/') ? 'content' : 'staff'}
    class="staff-body min-h-screen overflow-x-clip bg-background text-foreground"
  >
    <a class="accessibility-skip-to-content-link" href="#main">Skip to workspace</a>
    <StaffShell title={pageTitle} environment={import.meta.env.PUBLIC_STAFF_ENVIRONMENT} client:load>
      <slot />
    </StaffShell>
  </body>
</html>

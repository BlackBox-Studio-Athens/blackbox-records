---
import '../styles/global.css';
import { Boxes, FilePenLine, Disc3, ReceiptText } from 'lucide-react';

interface Props {
  pageTitle: string;
  pageDescription: string;
}

const { pageTitle, pageDescription } = Astro.props;
const htmlTitle = pageTitle + ' | BlackBox Records';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{htmlTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Geist+Mono:wght@400;500&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    data-workspace={Astro.url.pathname.startsWith('/content/') ? 'content' : undefined}
    class="min-h-screen overflow-x-clip bg-background text-foreground"
  >
    <a class="accessibility-skip-to-content-link" href="#main">Skip to workspace</a>
    <header class="staff-header">
      <a href="/content/" class="staff-brand" aria-label="BlackBox Records staff, content workspace"
        ><img src="/logo-horizontal.png" alt="BlackBox Records" width="1024" height="253" /></a
      >
      {
        import.meta.env.PUBLIC_STAFF_ENVIRONMENT === 'uat' && (
          <span class="rounded border border-border px-2 py-1 text-xs text-muted-foreground">Test environment</span>
        )
      }
      <nav aria-label="Staff workspace">
        <a href="/content/" aria-current={Astro.url.pathname.startsWith('/content/') ? 'page' : undefined}
          ><FilePenLine size={19} aria-hidden="true" />Content</a
        >
        <a href="/items/" aria-current={Astro.url.pathname.startsWith('/items/') ? 'page' : undefined}
          ><Disc3 size={19} aria-hidden="true" />Items</a
        >
        <a href="/stock/" aria-current={Astro.url.pathname.startsWith('/stock/') ? 'page' : undefined}
          ><Boxes size={19} aria-hidden="true" />Stock</a
        >
        <a href="/orders/" aria-current={Astro.url.pathname.startsWith('/orders/') ? 'page' : undefined}
          ><ReceiptText size={19} aria-hidden="true" />Orders</a
        >
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
  </body>
</html>

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  runtime    = "cloudflare"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
}

enum StoreItemSourceKind {
  release
  distro
}

enum ItemAvailabilityStatus {
  available
  sold_out
}

enum OrderStatus {
  pending_payment
  paid
  not_paid
  needs_review
}

enum PaidOrderDeliveryKind {
  shopper_confirmation
  ops_fulfillment
  newsletter_registration
}

enum PaidOrderDeliveryStatus {
  pending
  delivered
  needs_review
}

model StoreItemOption {
  id            String              @id @default(cuid())
  storeItemSlug String              @unique
  sourceKind    StoreItemSourceKind
  sourceId      String
  variantId     String              @unique
  cmsSourceId   String?
  itemType      String?
  priceKind     String?
  productProjection Json?
  catalogAvailability String       @default("withheld")
  catalogRevision Int              @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([sourceKind, sourceId])
  @@unique([sourceKind, cmsSourceId])
}

model CatalogOperation {
  id               String   @id
  kind             String
  inputFingerprint String
  actorEmail       String
  variantId        String
  expectedRevision Int
  step             String   @default("started")
  status           String   @default("pending")
  results          Json     @default("{}")
  claimToken       String?
  leaseUntil       String?
  safeReason       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())
  // The unresolved-item partial unique index is maintained by the SQL migration.
}

model VariantStripeMapping {
  id            String   @id @default(cuid())
  variantId     String   @unique
  stripePriceId String
  stripeProductId String? @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model StoreOfferSnapshot {
  id              String   @id @default(cuid())
  storeItemSlug   String   @unique
  variantId       String   @unique
  stripePriceId   String
  stripeLookupKey String
  amountMinor     Int?
  currencyCode    String
  priceActive     Boolean
  productActive   Boolean
  syncedAt        DateTime
  freshUntil      DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([freshUntil])
  @@index([stripeLookupKey])
}

model StripeCatalogWebhookEvent {
  eventId                 String    @id
  eventType               String
  catalogObjectId         String
  catalogObjectKind       String
  variantId               String?
  stripeCreatedAt         DateTime
  processedAt             DateTime  @default(now())
  processingStatus        String    @default("pending")
  processingCompletedAt   DateTime?
  processingFailureReason String?

  @@index([catalogObjectKind, catalogObjectId])
  @@index([variantId, stripeCreatedAt])
  @@index([processingStatus, stripeCreatedAt])
}

model ItemAvailability {
  id        String                 @id @default(cuid())
  variantId String                 @unique
  status    ItemAvailabilityStatus
  canBuy    Boolean
  updatedAt DateTime               @updatedAt
}

model Stock {
  revision       Int      @default(0)
  id             String   @id @default(cuid())
  variantId      String   @unique
  quantity       Int
  onlineQuantity Int
  restockPlanned Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model StockChange {
  id                    String   @id @default(cuid())
  variantId             String
  quantityDelta         Int
  reason                String
  notes                 String?
  actorEmail            String
  idempotencyKeyDigest  String?
  idempotencyFingerprint String?
  idempotencyEnvironment String?
  recordedAt            DateTime @default(now())

  @@index([variantId, recordedAt])
  @@index([idempotencyEnvironment, idempotencyKeyDigest, actorEmail])
}

model StockCount {
  id                    String   @id @default(cuid())
  variantId             String
  countedQuantity       Int
  onlineQuantity        Int
  notes                 String?
  actorEmail            String
  idempotencyKeyDigest  String?
  idempotencyFingerprint String?
  idempotencyEnvironment String?
  recordedAt            DateTime @default(now())

  @@index([variantId, recordedAt])
  @@index([idempotencyEnvironment, idempotencyKeyDigest, actorEmail])
}

model CheckoutOrder {
  id                           String              @id @default(cuid())
  storeItemSlug                String
  variantId                    String
  checkoutSessionId            String?             @unique
  checkoutUrl                  String?
  checkoutCancelUrl            String?
  checkoutSuccessUrl           String?
  idempotencyKeyDigest         String?
  idempotencyFingerprint       String?
  idempotencyEnvironment       String?
  checkoutProviderClaimToken   String?
  checkoutProviderLeaseUntil   String?
  checkoutExpiresAt            DateTime
  stripePaymentIntentId        String?
  amountTotalMinor             Int?
  acceptedDeliveryAmountMinor  Int?
  acceptedParcelTier           String?
  monetaryPolicyReference      String?
  merchandiseGrossMinor        Int?
  deliveryGrossMinor           Int?
  deliveryVatMinor             Int?
  totalVatMinor                Int?
  currencyCode                 String?
  recipientName                String?
  shopperEmail                 String?
  shopperPhone                 String?
  shippingAddressLine1         String?
  shippingAddressLine2         String?
  shippingAddressCity          String?
  shippingAddressPostalCode    String?
  shippingAddressState         String?
  shippingAddressCountryCode   String?
  newsletterOptIn              Boolean?
  newsletterConsentAt          DateTime?
  newsletterConsentCopyVersion String?
  shippingLockerId             String?
  shippingLockerCountryCode    String?
  shippingLockerNameOrLabel    String?
  status                       OrderStatus
  statusUpdatedAt              DateTime
  paidAt                       DateTime?
  notPaidAt                    DateTime?
  needsReviewAt                DateTime?
  needsReviewReason            String?
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
  lines                        CheckoutOrderLine[]
  deliveries                   PaidOrderDelivery[]

  @@index([variantId, status])
  @@index([idempotencyEnvironment, idempotencyKeyDigest])
  @@index([status, createdAt])
  @@index([createdAt, id])
}

model CheckoutOrderLine {
  id              String        @id @default(cuid())
  orderId         String
  storeItemSlug   String
  variantId       String
  stripePriceId   String?
  quantity        Int
  displayName     String?
  optionLabel     String?
  unitAmountMinor Int?
  lineAmountMinor Int?
  lineVatMinor    Int?
  taxRatePercent  Float?
  createdAt       DateTime      @default(now())
  order           CheckoutOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, variantId])
  @@index([orderId])
  @@index([stripePriceId])
  @@index([variantId])
}

model PaidOrderDelivery {
  id                String                  @id @default(cuid())
  orderId           String
  kind              PaidOrderDeliveryKind
  status            PaidOrderDeliveryStatus
  attemptCount      Int                     @default(0)
  nextAttemptAt     DateTime?
  leaseUntil        DateTime?
  providerMessageId String?
  safeReason        String?
  deliveredAt       DateTime?
  needsReviewAt     DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  order             CheckoutOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, kind])
  @@index([status, nextAttemptAt, createdAt])
}

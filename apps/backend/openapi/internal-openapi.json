{
  "openapi": "3.1.0",
  "info": {
    "title": "BlackBox Records Internal API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "InternalCheckoutOrder": {
        "type": "object",
        "properties": {
          "checkoutExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "checkoutSessionId": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "deliveries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "attemptCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "deliveredAt": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "shopper_confirmation",
                    "ops_fulfillment",
                    "newsletter_registration"
                  ]
                },
                "needsReviewAt": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "nextAttemptAt": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "safeReason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "delivered",
                    "needs_review"
                  ]
                },
                "updatedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "attemptCount",
                "createdAt",
                "deliveredAt",
                "kind",
                "needsReviewAt",
                "nextAttemptAt",
                "safeReason",
                "status",
                "updatedAt"
              ]
            }
          },
          "fulfillment": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "unavailable"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "incomplete"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "incomplete_paid_fulfillment"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "reason"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "amountTotalMinor": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "currencyCode": {
                    "type": "string",
                    "enum": [
                      "EUR"
                    ]
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "current"
                    ]
                  },
                  "lines": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "displayName": {
                          "type": "string",
                          "minLength": 1
                        },
                        "lineAmountMinor": {
                          "type": "integer",
                          "exclusiveMinimum": 0
                        },
                        "optionLabel": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "quantity": {
                          "type": "integer",
                          "exclusiveMinimum": 0
                        },
                        "storeItemSlug": {
                          "type": "string",
                          "minLength": 1
                        },
                        "unitAmountMinor": {
                          "type": "integer",
                          "exclusiveMinimum": 0
                        },
                        "variantId": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "displayName",
                        "lineAmountMinor",
                        "optionLabel",
                        "quantity",
                        "storeItemSlug",
                        "unitAmountMinor",
                        "variantId"
                      ]
                    }
                  },
                  "newsletterConsent": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "optedIn": {
                            "type": "boolean",
                            "enum": [
                              false
                            ]
                          }
                        },
                        "required": [
                          "optedIn"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "consentedAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "copyVersion": {
                            "type": "string",
                            "minLength": 1
                          },
                          "optedIn": {
                            "type": "boolean",
                            "enum": [
                              true
                            ]
                          }
                        },
                        "required": [
                          "consentedAt",
                          "copyVersion",
                          "optedIn"
                        ]
                      }
                    ]
                  },
                  "paidAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "recipientName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "shippingAddress": {
                    "type": "object",
                    "properties": {
                      "city": {
                        "type": "string",
                        "minLength": 1
                      },
                      "country": {
                        "type": "string",
                        "enum": [
                          "GR"
                        ]
                      },
                      "line1": {
                        "type": "string",
                        "minLength": 1
                      },
                      "line2": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "postalCode": {
                        "type": "string",
                        "minLength": 1
                      },
                      "state": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "city",
                      "country",
                      "line1",
                      "line2",
                      "postalCode",
                      "state"
                    ]
                  },
                  "shopperContact": {
                    "type": "object",
                    "properties": {
                      "email": {
                        "type": "string",
                        "format": "email"
                      },
                      "phone": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "email",
                      "phone"
                    ]
                  }
                },
                "required": [
                  "amountTotalMinor",
                  "currencyCode",
                  "kind",
                  "lines",
                  "newsletterConsent",
                  "paidAt",
                  "recipientName",
                  "shippingAddress",
                  "shopperContact"
                ]
              }
            ]
          },
          "needsReviewAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "notPaidAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "paidAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "shippingLocker": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "country_code": {
                "type": "string",
                "enum": [
                  "GR"
                ]
              },
              "locker_id": {
                "type": "string"
              },
              "locker_name_or_label": {
                "type": "string"
              }
            },
            "required": [
              "country_code",
              "locker_id",
              "locker_name_or_label"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/InternalOrderStatus"
          },
          "statusUpdatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "storeItemSlug": {
            "type": "string"
          },
          "stripePaymentIntentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "variantId": {
            "type": "string"
          }
        },
        "required": [
          "checkoutExpiresAt",
          "checkoutSessionId",
          "createdAt",
          "deliveries",
          "fulfillment",
          "needsReviewAt",
          "notPaidAt",
          "paidAt",
          "shippingLocker",
          "status",
          "statusUpdatedAt",
          "storeItemSlug",
          "stripePaymentIntentId",
          "updatedAt",
          "variantId"
        ]
      },
      "InternalOrderStatus": {
        "type": "string",
        "enum": [
          "pending_payment",
          "paid",
          "not_paid",
          "needs_review"
        ]
      },
      "BackendErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "error": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "error"
        ]
      },
      "InternalVariantSummary": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "sourceKind": {
            "type": "string",
            "enum": [
              "release",
              "distro"
            ]
          },
          "storeItemSlug": {
            "type": "string"
          },
          "variantId": {
            "type": "string"
          }
        },
        "required": [
          "sourceId",
          "sourceKind",
          "storeItemSlug",
          "variantId"
        ]
      },
      "InternalStockDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/InternalVariantSummary"
          },
          {
            "type": "object",
            "properties": {
              "stock": {
                "$ref": "#/components/schemas/InternalStockState"
              }
            },
            "required": [
              "stock"
            ]
          }
        ]
      },
      "InternalStockState": {
        "type": "object",
        "properties": {
          "onlineQuantity": {
            "type": "integer",
            "minimum": 0
          },
          "quantity": {
            "type": "integer",
            "minimum": 0
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "onlineQuantity",
          "quantity",
          "updatedAt"
        ]
      },
      "InternalStockHistoryResponse": {
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/InternalStockChangeEntry"
                },
                {
                  "$ref": "#/components/schemas/InternalStockCountEntry"
                }
              ]
            }
          },
          "variantId": {
            "type": "string"
          }
        },
        "required": [
          "entries",
          "variantId"
        ]
      },
      "InternalStockChangeEntry": {
        "type": "object",
        "properties": {
          "actorEmail": {
            "type": "string",
            "format": "email"
          },
          "id": {
            "type": "string"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "quantityDelta": {
            "type": "integer"
          },
          "reason": {
            "type": "string"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "type": "string",
            "enum": [
              "change"
            ]
          },
          "variantId": {
            "type": "string"
          }
        },
        "required": [
          "actorEmail",
          "id",
          "notes",
          "quantityDelta",
          "reason",
          "recordedAt",
          "type",
          "variantId"
        ]
      },
      "InternalStockCountEntry": {
        "type": "object",
        "properties": {
          "actorEmail": {
            "type": "string",
            "format": "email"
          },
          "countedQuantity": {
            "type": "integer",
            "minimum": 0
          },
          "id": {
            "type": "string"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "onlineQuantity": {
            "type": "integer",
            "minimum": 0
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "type": "string",
            "enum": [
              "count"
            ]
          },
          "variantId": {
            "type": "string"
          }
        },
        "required": [
          "actorEmail",
          "countedQuantity",
          "id",
          "notes",
          "onlineQuantity",
          "recordedAt",
          "type",
          "variantId"
        ]
      },
      "RecordedStockChangeResponse": {
        "type": "object",
        "properties": {
          "entry": {
            "$ref": "#/components/schemas/InternalStockChangeEntry"
          },
          "stock": {
            "$ref": "#/components/schemas/InternalStockState"
          },
          "variantId": {
            "type": "string"
          }
        },
        "required": [
          "entry",
          "stock",
          "variantId"
        ]
      },
      "InternalStockChangeBody": {
        "type": "object",
        "properties": {
          "delta": {
            "type": "integer"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 500
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "delta",
          "reason"
        ]
      },
      "RecordedStockCountResponse": {
        "type": "object",
        "properties": {
          "entry": {
            "$ref": "#/components/schemas/InternalStockCountEntry"
          },
          "stock": {
            "$ref": "#/components/schemas/InternalStockState"
          },
          "variantId": {
            "type": "string"
          }
        },
        "required": [
          "entry",
          "stock",
          "variantId"
        ]
      },
      "InternalStockCountBody": {
        "type": "object",
        "properties": {
          "countedQuantity": {
            "type": "integer",
            "minimum": 0
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 500
          },
          "onlineQuantity": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "countedQuantity",
          "onlineQuantity"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/internal/orders": {
      "get": {
        "tags": [
          "Internal Orders"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "$ref": "#/components/schemas/InternalOrderStatus"
            },
            "required": false,
            "name": "status",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Recent checkout orders for protected operator reconciliation.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InternalCheckoutOrder"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Operator authentication failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackendErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Operator authentication is temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackendErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/internal/orders/checkout-sessions/{checkoutSessionId}": {
      "get": {
        "tags": [
          "Internal Orders"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "checkoutSessionId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Checkout order state for one checkout session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalCheckoutOrder"
                }
              }
            }
          },
          "401": {
            "description": "Operator authentication failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackendErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Checkout order not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackendErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Operator authentication is temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackendErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/internal/variants": {
      "get": {
        "tags": [
          "Internal Stock"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": false,
            "name": "q",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Search variants for internal stock operations.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InternalVariantSummary"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Operator authentication failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackendErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Operator authentication is temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackendErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/internal/variants/{variantId}/stock": {
      "get": {
        "tags": [
          "Internal Stock"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "variantId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Current stock for a variant.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalStockDetail"
                }
              }
            }
          },
          "400": {
            "description": "Invalid variant id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackendErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Operator authentication failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackendErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Variant not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackendErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Operator authentication is temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackendErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/internal/variants/{variantId}/stock/history": {
      "get": {
        "tags": [
          "Internal Stock"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "variantId",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Recent stock history for a variant.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalStockHistoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid variant id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackendErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Operator authentication failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackendErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Variant not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackendErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Operator authentication is temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackendErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/internal/variants/{variantId}/stock/changes": {
      "post": {
        "tags": [
          "Internal Stock"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "variantId",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InternalStockChangeBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recorded a stock change.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordedStockChangeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid stock change.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackendErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Operator authentication failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackendErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Variant not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackendErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Operator authentication is temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackendErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/internal/variants/{variantId}/stock/counts": {
      "post": {
        "tags": [
          "Internal Stock"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,

{
  "name": "cms-runtime",
  "tags": ["module", "scope:backend"],
  "targets": {
    "test": {
      "command": "pnpm --filter @blackbox/backend exec vitest run --config vitest.modules.config.ts --project=cms-runtime --project=cms-runtime:worker",
      "inputs": ["backendTests", "^default", "backendWorkerTests"]
    },
    "test-watch": {
      "command": "pnpm --filter @blackbox/backend exec vitest --watch --config vitest.modules.config.ts --project=cms-runtime --project=cms-runtime:worker",
      "continuous": true,
      "cache": false
    }
  },
  "metadata": {
    "boundaries": {
      "status": "closed",
      "exports": ["./index.ts", "./auth.ts", "./media-upload.ts"],
      "namedInterfaces": {
        "access-auth-provider": "./auth.ts",
        "lazy-media-upload": "./media-upload.ts"
      },
      "dependsOn": ["operator-auth", "backend-platform", "commerce-persistence"],
      "workspaceInterfaces": {
        "@blackbox/content-model": ["."]
      }
    }
  }
}

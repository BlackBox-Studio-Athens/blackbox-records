---
import { PortableText } from 'emdash/ui';
import { cmsBodySchema } from '@blackbox/content-model';
import EditorialLink from './EditorialLink.astro';

interface Props {
  value: unknown;
}

const value = cmsBodySchema.parse(Astro.props.value);
---

<PortableText value={value} components={{ mark: { link: EditorialLink } }} />

---
import { cmsLinkSchema } from './content-schema';

interface Props {
  node: { markDef: { href: string; blank?: boolean } };
}

// The shared write/read constraint allows the source's route-relative links.
const href = cmsLinkSchema.parse(Astro.props.node.markDef.href);
const blank = !href.startsWith('#') && Astro.props.node.markDef.blank;
---

<a href={href} target={blank ? '_blank' : undefined} rel={blank ? 'noopener noreferrer' : undefined}><slot /></a>

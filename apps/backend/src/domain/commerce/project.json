{
  "name": "commerce-domain",
  "tags": ["module", "scope:backend"],
  "targets": {
    "test": {
      "command": "pnpm --filter @blackbox/backend exec vitest run --config vitest.modules.config.ts --project=commerce-domain --project=commerce-domain:worker",
      "inputs": ["backendTests", "^default"]
    },
    "test-watch": {
      "command": "pnpm --filter @blackbox/backend exec vitest --watch --config vitest.modules.config.ts --project=commerce-domain --project=commerce-domain:worker",
      "continuous": true,
      "cache": false
    }
  },
  "metadata": {
    "boundaries": {
      "status": "closed",
      "exports": ["./index.ts", "./request-idempotency.ts"],
      "namedInterfaces": {
        "repository-spi": "./repositories/spi.ts",
        "request-identity": "./repositories/request-identity.ts"
      },
      "dependsOn": [],
      "workspaceInterfaces": {}
    }
  }
}

{
  "name": "email-application",
  "tags": ["module", "scope:backend"],
  "targets": {
    "test": {
      "command": "pnpm --filter @blackbox/backend exec vitest run --config vitest.modules.config.ts --project=email-application --project=email-application:worker",
      "inputs": ["backendTests", "^default"]

{
  "name": "checkout-core",
  "tags": ["module", "scope:backend"],
  "targets": {
    "test": {
      "command": "pnpm --filter @blackbox/backend exec vitest run --config vitest.modules.config.ts --project=checkout-core --project=checkout-core:worker",
      "inputs": ["backendTests", "^default", "backendWorkerTests"]
    },
    "test-watch": {
      "command": "pnpm --filter @blackbox/backend exec vitest --watch --config vitest.modules.config.ts --project=checkout-core --project=checkout-core:worker",
      "continuous": true,
      "cache": false
    }
  },
  "metadata": {
    "boundaries": {
      "status": "closed",
      "exports": ["./index.ts", "./reconcile-checkout-session.ts", "./readers/index.ts", "./feature-flags/index.ts"],
      "namedInterfaces": {
        "checkout-spi": "./spi.ts"
      },
      "dependsOn": ["catalog-sync", "commerce-domain", "orders", "stock", "backend-platform"],
      "workspaceInterfaces": { "@blackbox/api-client": ["./public"] }
    }
  }
}

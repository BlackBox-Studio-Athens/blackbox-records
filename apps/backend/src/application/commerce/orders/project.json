{
  "name": "orders",
  "tags": ["module", "scope:backend"],
  "targets": {
    "test": {
      "command": "pnpm --filter @blackbox/backend exec vitest run --config vitest.modules.config.ts --project=orders --project=orders:worker",
      "inputs": ["backendTests", "^default"]
    },
    "test-watch": {
      "command": "pnpm --filter @blackbox/backend exec vitest --watch --config vitest.modules.config.ts --project=orders --project=orders:worker",
      "continuous": true,
      "cache": false
    }
  },
  "metadata": {
    "boundaries": {
      "status": "closed",
      "exports": ["./index.ts", "./register-internal-order-routes.ts", "./run-paid-order-delivery-schedule.ts"],
      "namedInterfaces": {
        "internal-order-routes": "./register-internal-order-routes.ts",
        "scheduled-paid-order-delivery": "./run-paid-order-delivery-schedule.ts"
      },
      "dependsOn": [
        "commerce-domain",
        "checkout-core",
        "stock",
        "commerce-persistence",
        "email-application",
        "resend-integration",
        "backend-platform"
      ],
      "workspaceInterfaces": {}
    }
  }
}

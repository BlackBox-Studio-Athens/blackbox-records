{
  "name": "backend-platform",
  "tags": ["module", "scope:backend"],
  "targets": {
    "test": {
      "command": "pnpm --filter @blackbox/backend exec vitest run --config vitest.modules.config.ts --project=backend-platform --project=backend-platform:worker",
      "inputs": ["backendTests", "^default", "backendWorkerTests"]
    },
    "test-watch": {
      "command": "pnpm --filter @blackbox/backend exec vitest --watch --config vitest.modules.config.ts --project=backend-platform --project=backend-platform:worker",
      "continuous": true,
      "cache": false
    }
  },
  "metadata": {
    "boundaries": {
      "status": "closed",
      "exports": [
        "./observability/index.ts",
        "./env.ts",
        "./interfaces/http/responses.ts",
        "./interfaces/http/error-handler.ts",
        "./interfaces/http/not-found-handler.ts"
      ],
      "namedInterfaces": {},
      "dependsOn": [],
      "workspaceInterfaces": {
        "@blackbox/api-client": ["./public"],
        "@blackbox/content-model": ["."]
      }
    }
  }
}

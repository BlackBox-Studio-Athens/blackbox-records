{
  "name": "operator-stock",
  "tags": ["module", "scope:backend"],
  "targets": {
    "test": {
      "command": "pnpm --filter @blackbox/backend exec vitest run --config vitest.modules.config.ts --project=operator-stock",
      "inputs": ["backendTests", "^default"],
      "dependsOn": [
        {
          "projects": ["public-commerce-http"],
          "target": "test"
        }
      ]
    },
    "test-watch": {
      "command": "pnpm --filter @blackbox/backend exec vitest --watch --config vitest.modules.config.ts --project=operator-stock",
      "continuous": true,
      "cache": false
    }
  },
  "metadata": {
    "boundaries": {
      "status": "closed",
      "exports": ["./internal-contracts.ts", "./register-internal-stock-routes.ts"],
      "namedInterfaces": {
        "internal-contracts": "./internal-contracts.ts"
      },
      "dependsOn": ["stock", "orders", "commerce-domain", "commerce-persistence", "backend-platform", "cms-runtime"],
      "workspaceInterfaces": {}
    }
  }
}

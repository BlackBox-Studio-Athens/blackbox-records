{
  "name": "public-commerce-http",
  "tags": ["module", "scope:backend"],
  "targets": {
    "test": {
      "command": "pnpm --filter @blackbox/backend exec vitest run --config vitest.modules.config.ts --project=public-commerce-http --project=public-commerce-http:worker",
      "inputs": ["backendTests", "^default", "backendWorkerTests"]
    },
    "test-watch": {
      "command": "pnpm --filter @blackbox/backend exec vitest --watch --config vitest.modules.config.ts --project=public-commerce-http --project=public-commerce-http:worker",
      "continuous": true,
      "cache": false
    }
  },
  "metadata": {
    "boundaries": {
      "status": "closed",
      "exports": [
        "./contracts/public-contracts.ts",
        "./routes/register-public-routes.ts",
        "./routes/register-internal-routes.ts",
        "./app.ts"
      ],
      "namedInterfaces": {
        "public-contracts": "./contracts/public-contracts.ts"
      },
      "dependsOn": [
        "checkout-core",
        "orders",
        "operator-stock",
        "stock",
        "catalog-sync",
        "email-application",
        "commerce-domain",
        "commerce-persistence",
        "stripe-integration",
        "resend-integration",
        "operator-auth",
        "backend-platform"
      ],
      "workspaceInterfaces": {}
    }
  }
}

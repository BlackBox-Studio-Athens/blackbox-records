{
  "name": "commerce-persistence",
  "tags": ["module", "scope:backend"],
  "targets": {
    "test": {
      "command": "pnpm --filter @blackbox/backend exec vitest run --config vitest.modules.config.ts --project=commerce-persistence --project=commerce-persistence:worker",
      "inputs": ["backendTests", "^default", "backendWorkerTests"]
    },
    "test-watch": {
      "command": "pnpm --filter @blackbox/backend exec vitest --watch --config vitest.modules.config.ts --project=commerce-persistence --project=commerce-persistence:worker",
      "continuous": true,
      "cache": false
    }
  },
  "metadata": {
    "boundaries": {
      "status": "closed",
      "exports": [
        "./d1-order-withdrawal-repository.ts",
        "./d1-availability-alert-repository.ts",
        "./d1-checkout-stock-hold-repository.ts",
        "./d1-paid-order-delivery-repository.ts",
        "./d1-preorder-estimate-delivery-repository.ts",
        "./prisma/index.ts"
      ],
      "namedInterfaces": {},
      "dependsOn": ["commerce-domain", "backend-platform", "generated-prisma"],
      "workspaceInterfaces": {}
    }
  }
}

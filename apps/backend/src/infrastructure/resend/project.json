{
  "name": "resend-integration",
  "tags": ["module", "scope:backend"],
  "targets": {
    "test": {
      "command": "pnpm --filter @blackbox/backend exec vitest run --config vitest.modules.config.ts --project=resend-integration --project=resend-integration:worker",
      "inputs": ["backendTests", "^default", "backendWorkerTests"]
    },
    "test-watch": {
      "command": "pnpm --filter @blackbox/backend exec vitest --watch --config vitest.modules.config.ts --project=resend-integration --project=resend-integration:worker",
      "continuous": true,
      "cache": false
    }
  }
}

{
  "name": "backend-tooling",
  "tags": ["integration", "scope:backend"],
  "targets": {
    "test": {
      "command": "pnpm --filter @blackbox/backend exec vitest run --config vitest.modules.config.ts --project=backend-tooling",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/scripts/**/*",
        "{workspaceRoot}/apps/backend/scripts/**/*",
        "{workspaceRoot}/apps/backend/vitest*.ts",
        "{workspaceRoot}/apps/backend/package.json",
        "{workspaceRoot}/apps/backend/wrangler.jsonc",
        "{workspaceRoot}/apps/backend/cms-resources.json",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/.github/workflows/**/*",
        "backendWorkerTests",
        "{workspaceRoot}/openspec/specs/module-boundaries/**/*"
      ]
    }
  }
}

{
  "name": "stock-integration",
  "tags": ["integration", "scope:backend"],
  "targets": {
    "test": {
      "command": "pnpm --filter @blackbox/backend exec vitest run --config vitest.modules.config.ts --project=stock-integration --project=stock-integration:worker",
      "inputs": ["backendTests", "^default", "backendWorkerTests"]
    },
    "test-watch": {
      "command": "pnpm --filter @blackbox/backend exec vitest --watch --config vitest.modules.config.ts --project=stock-integration --project=stock-integration:worker",
      "cache": false,
      "continuous": true
    }
  }
}

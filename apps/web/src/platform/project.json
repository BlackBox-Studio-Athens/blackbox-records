{
  "name": "web-platform",
  "tags": ["module", "scope:web"],
  "targets": {
    "test": {
      "command": "pnpm --filter @blackbox/web exec vitest run --config vitest.modules.config.ts --project=web-platform",
      "inputs": ["default", "^default", "{workspaceRoot}/apps/web/vitest*.ts", "{workspaceRoot}/apps/web/src/test/**/*"]
    },
    "test-watch": {
      "command": "pnpm --filter @blackbox/web exec vitest --watch --config vitest.modules.config.ts --project=web-platform",
      "cache": false,
      "continuous": true
    }
  },
  "metadata": {
    "boundaries": {
      "status": "closed",
      "exports": [
        "./config/site.ts",
        "./components/Prose.tsx",
        "./components/PurchaseInformation.tsx",
        "./components/PurchaseDocument.tsx",
        "./lib/purchase-information.ts",
        "./lib/backend/public-backend-config.ts",
        "./lib/private-preview.ts",
        "./lib/lenis-scroll.ts",
        "./lib/editorial-image.ts",
        "./lib/public-image-fallback.ts",
        "./lib/preorder-estimate.ts",
        "./utils/urls.ts"
      ],
      "namedInterfaces": {},
      "dependsOn": [],
      "workspaceInterfaces": {
        "@blackbox/api-client": ["./public"],
        "@blackbox/content-model": ["."]
      }
    }
  }
}

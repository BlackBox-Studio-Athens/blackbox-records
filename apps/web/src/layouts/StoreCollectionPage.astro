---
import InternalPageHero from '@/components/InternalPageHero.astro';
import { priceDisclosure } from '@blackbox/api-client/public';
import StoreItemCard from '@/components/store/StoreItemCard.astro';
import InternationalOrderNotice from '@/components/store/cart/InternationalOrderNotice';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { createProjectRelativeUrl } from '@/platform/config/site';
import type { StoreCatalogCategory } from '@/lib/store-categories';
import {
  createStoreDistroGroupHeadingId,
  getStoreDistroFormatGroup,
  groupStoreDistroCollectionEntries,
  selectStoreCollectionEntries,
  type StoreCollectionEntry,
} from '@/lib/store-collection';
import StoreCategoryNavigation from '@/components/store/StoreCategoryNavigation.astro';
import StoreBrowsePane from '@/components/store/StoreBrowsePane.astro';
import StoreCrate from '@/components/store/StoreCrate.astro';
import { StoreSearchToolbar } from '@/components/store/StoreDistroSearch';
import StoreListingPricePrefetch from './StoreListingPricePrefetch.astro';
interface Props {
  category: StoreCatalogCategory;
  entries: StoreCollectionEntry[];
  discoverableCategories: readonly StoreCatalogCategory[];
}
const { category, entries, discoverableCategories } = Astro.props;
const distroGroups =
  category.id === 'all' ? groupStoreDistroCollectionEntries(selectStoreCollectionEntries(entries, 'distro')) : [];
const catalogId = 'all-store-catalog';
---

<SiteLayout pageTitle={category.title} pageDescription={category.description} mainClass="store-collection-page">
  {entries.length > 0 && <StoreListingPricePrefetch pathname={category.path} />}
  <div data-tone="store">
    <div id="store-page-top">
      <InternalPageHero sectionLabel="Store" title={category.heading} />
    </div>
    <StoreCategoryNavigation activeCategoryId={category.id} categories={discoverableCategories} />
    <p class="layout-container store-purchase-note">
      {priceDisclosure}{' '}
      <a class="underline" href={createProjectRelativeUrl('/terms/')}>
        Delivery rates and terms
      </a>
      .
    </p>
    <div class="layout-container has-[aside]:mb-4 md:has-[aside]:mb-6">
      <InternationalOrderNotice variant="strip" client:load />
    </div>
    {category.id === 'distro' ? (
      <slot name="distro" />
    ) : (
      <div class="layout-container store-browse-layout" data-store-search-root>
        <StoreBrowsePane entries={entries} resultsId={catalogId}>
          {distroGroups.length > 0 && (
            <nav slot="formats" aria-label="Browse Distro formats" class="store-format-links">
              <h2>Browse Distro formats</h2>
              {distroGroups.map((group) => (
                <a
                  href={createProjectRelativeUrl('/store/distro/#' + createStoreDistroGroupHeadingId(group.groupName))}
                >
                  <span>{group.groupName}</span>
                  <span>{group.entries.length}</span>
                </a>
              ))}
            </nav>
          )}
        </StoreBrowsePane>
        <section class="store-browse-results" aria-label={category.label + ' Store collection'}>
          {category.id !== 'all' && <p class="store-category-description">{category.description}</p>}
          <div data-store-search>
            <StoreSearchToolbar resultsId={catalogId} />
          </div>
          <p data-store-result-total hidden>
            {entries.length} {entries.length === 1 ? 'item' : 'items'}
          </p>
          <StoreCrate
            catalogId={catalogId}
            formatGroups={entries.map(getStoreDistroFormatGroup)}
            binRow
            label={category.label}
          >
            <div id={catalogId} class="store-catalog-chunks">
              {entries.map((entry, index) => (
                <StoreItemCard
                  entry={entry}
                  searchable
                  imageLoadingMode={index === 0 ? 'priority' : index < 4 ? 'eager' : 'lazy'}
                />
              ))}
            </div>
          </StoreCrate>
          {entries.length === 0 && <p>No Store items currently available.</p>}
        </section>
      </div>
    )}
  </div>
</SiteLayout>

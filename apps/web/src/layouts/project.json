{
  "name": "web-layouts",
  "tags": ["application", "scope:web"],
  "implicitDependencies": ["app-shell", "storefront-catalog", "web-editorial", "web-platform", "web-store"],
  "targets": {
    "test": {
      "command": "pnpm --filter @blackbox/web exec vitest run --config vitest.modules.config.ts --project=web-layouts",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/apps/web/vitest*.ts",
        "{workspaceRoot}/apps/web/src/styles/**/*"
      ]
    }
  },
  "metadata": {
    "boundaries": {
      "status": "closed",
      "exports": ["./SiteLayout.astro", "./RedirectLayout.astro", "./StoreCollectionPage.astro"],
      "namedInterfaces": {},
      "dependsOn": [
        "app-shell",
        "player",
        "ui-foundation",
        "storefront-catalog",
        "store-cart",
        "checkout-web",
        "web-platform",
        "web-editorial",
        "web-pages",
        "web-store"
      ],
      "workspaceInterfaces": {
        "@blackbox/content-model": ["."],
        "@blackbox/api-client": ["./public"]
      }
    }
  }
}

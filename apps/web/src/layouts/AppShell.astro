---
import AppShellRoot from '@/components/app-shell/AppShellRoot';
import { getLabelSettings, getMainNavigation, getServicesContent } from '@/lib/site-data';

const [navigation, labelSettings, servicesContent] = await Promise.all([
  getMainNavigation(),
  getLabelSettings(),
  getServicesContent(),
]);
---

<AppShellRoot
  client:load
  initialPathname={Astro.url.pathname}
  navigation={navigation}
  servicesInquirySubmitText={servicesContent.inquiry.submit_text}
  siteTitle={labelSettings.label_name}
/>

---
import '@/styles/global.css';
import veneerFontUrl from '@/assets/fonts/brand/veneer_regular.woff2?url';
import interFontUrl from '@/assets/fonts/ui/inter-latin.woff2?url';
import geistMonoFontUrl from '@/assets/fonts/ui/geist-mono-latin.woff2?url';

import AppShell from '@/layouts/AppShell.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import {
  createAbsoluteSiteUrl,
  createCanonicalUrl,
  createProjectRelativeUrl,
  siteBrandAssets,
  siteConfig,
  siteThemeColor,
} from '@/platform/config/site';
import { getLabelSettings, getSocialItems } from '@/lib/site-data';
import { getPurchaseInformation, inlinesPurchaseInformation } from '@/platform/lib/purchase-information';
import {
  createOrganizationStructuredData,
  createWebSiteStructuredData,
  serializeStructuredData,
} from '@/platform/lib/structured-data';

interface Props {
  pageTitle?: string;
  pageDescription?: string;
  pageSummary?: string;
  bodyClass?: string;
  mainClass?: string;
  layoutType?: string;
  pageDate?: Date;
  redirectUrl?: string;
  robots?: string;
  /** A page entity (MusicAlbum, MusicGroup) published beside the Organization data. */
  structuredData?: Record<string, unknown>;
}

const {
  pageTitle,
  pageDescription,
  pageSummary,
  bodyClass,
  mainClass,
  layoutType,
  pageDate,
  redirectUrl,
  robots,
  structuredData,
} = Astro.props;

const [labelSettings, socialItems] = await Promise.all([getLabelSettings(), getSocialItems()]);

const metadataTitle = pageTitle || siteConfig.title;
const metadataDescription = pageDescription || pageSummary || siteConfig.description;
const metadataUrl = createCanonicalUrl(Astro.url, Astro.site);
// Every page shares the one brand card; the page title and description still vary per link.
const metadataImage = createAbsoluteSiteUrl(siteConfig.socialImage);
const metadataType = layoutType === 'news' ? 'article' : 'website';
const configuredPublicBackendBaseUrl = import.meta.env.PUBLIC_BACKEND_BASE_URL?.trim();
const publicBackendOrigin = configuredPublicBackendBaseUrl ? new URL(configuredPublicBackendBaseUrl).origin : null;
const orgName = labelSettings.label_name || siteConfig.title;
const orgUrl = createAbsoluteSiteUrl('/');
const orgLogo = labelSettings.logo?.includes('://') ? labelSettings.logo : createAbsoluteSiteUrl(labelSettings.logo);
const sameAs = socialItems.filter((item) => item.url && item.url !== '#').map((item) => item.url);
const showReviewSiteMarker = import.meta.env.SHOW_REVIEW_SITE_MARKER === 'true';
const baseHtmlTitle = pageTitle ? `${pageTitle} | ${siteConfig.title}` : siteConfig.title;
const htmlTitle = showReviewSiteMarker ? `[UAT] ${baseHtmlTitle}` : baseHtmlTitle;
const preloadGeistMono = Astro.url.pathname === createProjectRelativeUrl('/releases/');
const pageEntity =
  structuredData ??
  (Astro.url.pathname === createProjectRelativeUrl('/') ? createWebSiteStructuredData(orgName, orgUrl) : undefined);
const resolvedBodyClass = ['min-h-screen flex flex-col overflow-x-clip bg-background text-foreground', bodyClass]
  .filter(Boolean)
  .join(' ');
const resolvedMainClass = ['page-main-content-region', 'pt-[var(--header-height)]', mainClass]
  .filter(Boolean)
  .join(' ');
---

<!doctype html>
<html lang="en">
  <head>
    <script>
      import { connectPrivatePreview } from '@/platform/lib/private-preview';
      import { connectPublicImageFallback } from '@/platform/lib/public-image-fallback';
      connectPrivatePreview();
      connectPublicImageFallback();
      // Delegation also handles videos inserted by shell navigation and release overlays.
      // Private preview's capture handler keeps shared previews inert until the staff handshake.
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const trigger = event.target.closest<HTMLButtonElement>('[data-editorial-video-load]');
        const root = trigger?.closest('[data-editorial-video]');
        if (!root || !trigger?.dataset.src) return;
        const frame = document.createElement('iframe');
        frame.src = trigger.dataset.src;
        frame.title = trigger.dataset.title!;
        frame.className = 'size-full border-0';
        frame.allow = 'fullscreen; picture-in-picture';
        frame.allowFullscreen = true;
        frame.referrerPolicy = 'no-referrer';
        frame.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-presentation');
        root.replaceChildren(frame);
      });
    </script>
    <meta charset="utf-8" />
    {inlinesPurchaseInformation && (
      <script
        is:inline
        type="application/json"
        id="purchase-information"
        set:html={JSON.stringify(getPurchaseInformation()).replaceAll('<', '\\u003c')}
      />
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Before first paint: the Home hero keeps its still unpainted until the film plays (shell visits to Home too).
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && !navigator.connection?.saveData)
        document.documentElement.setAttribute('data-hero-film', '');
    </script>
    <meta name="theme-color" content={siteThemeColor} />
    <meta name="color-scheme" content="dark" />
    <title>{htmlTitle}</title>
    <meta name="description" content={metadataDescription} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="icon" href={createProjectRelativeUrl(siteBrandAssets.faviconSvg)} type="image/svg+xml" sizes="any" />
    <link rel="icon" href={createProjectRelativeUrl(siteBrandAssets.faviconPng96)} type="image/png" sizes="96x96" />
    <link rel="icon" href={createProjectRelativeUrl(siteBrandAssets.faviconIco)} sizes="any" />
    <link rel="apple-touch-icon" href={createProjectRelativeUrl(siteBrandAssets.appleTouchIcon)} />
    <link rel="manifest" href={createProjectRelativeUrl(siteBrandAssets.webManifest)} />
    {redirectUrl && <meta content={`0; url=${redirectUrl}`} http-equiv="refresh" />}

    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:title" content={metadataTitle} />
    <meta property="og:description" content={metadataDescription} />
    <meta property="og:type" content={metadataType} />
    <meta property="og:url" content={metadataUrl} />
    <meta property="og:image" content={metadataImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(siteConfig.socialImageWidth)} />
    <meta property="og:image:height" content={String(siteConfig.socialImageHeight)} />
    <meta property="og:image:alt" content={siteConfig.socialImageAlt} />
    <meta property="og:locale" content="en_US" />
    {layoutType === 'news' && pageDate && <meta property="article:published_time" content={pageDate.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metadataTitle} />
    <meta name="twitter:description" content={metadataDescription} />
    <meta name="twitter:image" content={metadataImage} />
    <meta name="twitter:image:alt" content={siteConfig.socialImageAlt} />

    <link rel="canonical" href={redirectUrl || metadataUrl} />

    <script
      is:inline
      type="application/ld+json"
      set:html={serializeStructuredData(
        createOrganizationStructuredData(
          {
            name: orgName,
            url: orgUrl,
            logo: orgLogo,
            description: siteConfig.description,
            foundingDate: String(labelSettings.established_year),
            address: {
              addressLocality: labelSettings.location.locality,
              addressCountry: labelSettings.location.country,
            },
            sameAs,
          },
          createAbsoluteSiteUrl('/terms/'),
        ),
      )}
    />
    {pageEntity && <script is:inline type="application/ld+json" set:html={serializeStructuredData(pageEntity)} />}
    <link rel="preload" href={veneerFontUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={interFontUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    {preloadGeistMono && (
      <link rel="preload" href={geistMonoFontUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    )}
    {publicBackendOrigin && <link rel="dns-prefetch" href={publicBackendOrigin} />}
    {inlinesPurchaseInformation && <link rel="preconnect" href="https://images.blackboxrecordsathens.com" />}
    {publicBackendOrigin && <link rel="preconnect" href={publicBackendOrigin} crossorigin="anonymous" />}
  </head>
  <body class={resolvedBodyClass}>
    <a class="accessibility-skip-to-content-link" href="#main">
      Skip to content
    </a>
    <Header pathname={Astro.url.pathname} />
    <main class={resolvedMainClass} id="main" tabindex="-1" data-app-shell-main>
      <slot />
    </main>
    <AppShell />
    <Footer />
  </body>
</html>

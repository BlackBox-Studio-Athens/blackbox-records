---
import { createProjectRelativeUrl } from '@/platform/config/site';
import { getMainNavigation } from '@/lib/site-data';
import HeaderBrand from '@/components/header/HeaderBrand.astro';
import HeaderDesktopNav from '@/components/header/HeaderDesktopNav.astro';
import HeaderShell from '@/components/header/HeaderShell.astro';
import { Menu } from 'lucide-react';

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const { sections } = await getMainNavigation();
const showReviewSiteMarker = import.meta.env.SHOW_REVIEW_SITE_MARKER === 'true';
---

<HeaderShell hasBanner={showReviewSiteMarker}>
  {showReviewSiteMarker && (
    <aside slot="banner" class="uat-site-banner" aria-label="UAT environment">
      <strong>UAT · TESTING ONLY</strong>
      <span>Data here is separate and does not transfer to or from the production site.</span>
      <a href="https://blackbox-records-web.pages.dev/" target="_blank" rel="noopener noreferrer">
        Open production site <span aria-hidden="true">↗</span>
      </a>
    </aside>
  )}
  <div class="header-brand-group">
    <HeaderBrand href={createProjectRelativeUrl('/')} />
  </div>
  <HeaderDesktopNav items={sections} pathname={pathname} />

  <div class="flex items-center gap-1">
    <div data-store-cart-header-root></div>
    <button
      type="button"
      class="site-nav-link site-nav-link--header site-menu-button lg:hidden"
      aria-haspopup="dialog"
      aria-expanded="false"
      data-app-shell-mobile-navigation-trigger
    >
      <Menu className="size-4" aria-hidden="true" />
      <span class="site-nav-link__label">Menu</span>
    </button>
  </div>
</HeaderShell>

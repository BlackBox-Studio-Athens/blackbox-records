{
  "name": "ui-foundation",
  "tags": ["module", "scope:web"],
  "targets": {
    "test": {
      "command": "pnpm --filter @blackbox/web exec vitest run --project=ui-foundation --project=ui-foundation:worker --project=ui-foundation:request --config vitest.modules.config.ts",
      "inputs": ["webTests", "^default"]
    },
    "test-watch": {
      "command": "pnpm --filter @blackbox/web exec vitest --watch --project=ui-foundation --project=ui-foundation:worker --project=ui-foundation:request --config vitest.modules.config.ts",
      "cache": false,
      "continuous": true
    }
  },
  "implicitDependencies": [],
  "metadata": {
    "boundaries": {
      "status": "closed",
      "exports": [
        "./badge.tsx",
        "./button.tsx",
        "./card.tsx",
        "./grid-pattern.astro",
        "./input.tsx",
        "./loading-feedback.tsx",
        "./sheet.tsx",
        "./spinner.tsx",
        "./textarea.tsx",
        "./utils.ts"
      ],
      "namedInterfaces": {},
      "dependsOn": [],
      "workspaceInterfaces": {}
    }
  }
}

---
import Prose from '@/components/Prose.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import MusicStreamingServiceListenTrigger from '@/components/music/MusicStreamingServiceListenTrigger.astro';
import { Card, CardContent } from '@/components/ui/card';
import { buttonVariants } from '@/components/ui/button';
import { getReleasePresentationEntry, type ReleaseCommerceLink } from './release-commerce';
import { neutralReleasePresentation } from './release-presentation';
import { createArtistDetailPath, createReleaseDetailPath } from '@/lib/catalog-data';
import { formatMonthYear } from '@/utils/content';
import { buildEmbeddedPlayerData } from '@/components/music/music';
import { editorialImageQuality, largestImageWidth } from '@/platform/lib/editorial-image';

interface Props {
  release: CollectionEntry<'releases'>;
  artist: CollectionEntry<'artists'> | undefined;
  imageLoading?: 'eager' | 'lazy';
  variant?: 'default' | 'framed-artwork' | 'artist-discography' | 'releases';
  commerceLink?: ReleaseCommerceLink | null | undefined;
  imagePriority?: boolean;
  role?: 'lead' | 'supporting' | 'catalog';
  singleColumn?: boolean;
}

const {
  release,
  artist,
  imageLoading = 'lazy',
  variant = 'default',
  commerceLink,
  imagePriority = false,
  role = 'catalog',
  singleColumn = false,
} = Astro.props;
const artistFallbackName = release.data.artist.id ? release.data.artist.id.replace(/-/g, ' ') : 'Artist';
const artistName = artist?.data.title || artistFallbackName;
const releaseCardTitle = `${release.data.title} — ${artistName}`;
const embeddedPlayerData = buildEmbeddedPlayerData(release.id, release.data, releaseCardTitle);
const bandcampProvider = embeddedPlayerData?.providers.find((provider) => provider.id === 'bandcamp');
const tidalProvider = embeddedPlayerData?.providers.find((provider) => provider.id === 'tidal');
const isReleaseShowcase = variant === 'releases';
const isPrincipal = isReleaseShowcase && role !== 'catalog';
const featureClass = role === 'lead' ? 'releases-latest-feature' : 'releases-latest-feature__upcoming';
const featurePartPrefix = role === 'lead' ? 'releases-latest-feature__' : 'releases-latest-feature__upcoming-';
const HeadingTag = isPrincipal ? 'h2' : 'h3';
const ArtworkTag = isReleaseShowcase ? 'a' : 'div';
const isFramedArtwork = variant === 'framed-artwork' || isReleaseShowcase;
const isArtistDiscography = variant === 'artist-discography';
const usesFramedArtworkLayout = isFramedArtwork || isArtistDiscography;
const releaseCardImageWidths = isArtistDiscography
  ? [240, 320, 480, 640]
  : isReleaseShowcase
    ? [320, 480, 720, 1080, 1440, 1800]
    : [320, 480, 640, 800, 960];
// Desktop catalog slots include showcase padding, grid gaps, frame borders and the resting scale.
// Narrow Releases slots use one 16px gutter and complete, unscaled artwork.
const leadRegion = singleColumn ? '(100vw - 4.125rem)' : '((100vw - 4.125rem) * 0.75 - 1px)';
const cappedLeadRegion = leadRegion.replace('100vw', '87rem');
const releaseCardImageSizes = isPrincipal
  ? role === 'lead'
    ? `(min-width: 87rem) calc((${cappedLeadRegion} - 5.5rem) * 0.95 / 1.95 - 2px), (min-width: 83.333333rem) calc((${leadRegion} - 5.5rem) * 0.95 / 1.95 - 2px), (min-width: 80rem) calc((${leadRegion} - 3rem - 3vw) * 0.95 / 1.95 - 2px), (min-width: 64rem) calc((${leadRegion} - 4.5rem) * 0.9 / 1.9 - 2px), (min-width: 40rem) calc((100vw - 3.5rem) * 0.9 / 1.9 - 2px), calc(100vw - 2rem - 2px)`
    : '(min-width: 87rem) calc((87rem - 4.125rem) / 4 - 3rem - 2px), (min-width: 64rem) calc((100vw - 4.125rem) / 4 - 3rem - 2px), (min-width: 40rem) calc((100vw - 3.5rem) * 0.9 / 1.9 - 2px), calc(100vw - 2rem - 2px)'
  : isFramedArtwork
    ? `(min-width: 87rem) calc(((87rem - 9.5rem) / 3 - 2px) * 1.026), (min-width: 80rem) calc(((100vw - 9.5rem) / 3 - 2px) * 1.026), (min-width: 64rem) calc(((100vw - 8.25rem) / 2 - 2px) * 1.026), ${isReleaseShowcase ? '(min-width: 48rem) calc((100vw - 3.25rem) / 2 - 2px), calc(100vw - 2rem - 2px)' : '(min-width: 60rem) calc(((100vw - 7.25rem) / 2 - 2px) * 1.026), (min-width: 48rem) calc(((95vw - 4.25rem) / 2 - 2px) * 1.026), (min-width: 40rem) calc((95vw - 3rem - 2px) * 1.026), calc((100vw - 4rem - 2px) * 1.026)'}`
    : '(min-width: 1280px) 260px, (min-width: 768px) 50vw, 100vw';
const releaseDate = formatMonthYear(release.data.release_date);
const releaseDateMachineValue = release.data.release_date?.toISOString().slice(0, 10);
const detailPath = createReleaseDetailPath(release);
const presentationEntry = getReleasePresentationEntry(release, commerceLink);
const physicalFormat = presentationEntry.edition.kind !== 'none' ? presentationEntry.edition.format : undefined;
const storeSlug = presentationEntry.edition.kind === 'native' ? presentationEntry.edition.storeSlug : undefined;
const neutralPresentation = neutralReleasePresentation(presentationEntry);

const dataAttributes = embeddedPlayerData
  ? {
      'data-music-streaming-service-embedded-player-card': true,
      'data-music-streaming-service-embedded-player-release-id': embeddedPlayerData.releaseId,
      'data-music-streaming-service-embedded-player-title': embeddedPlayerData.title,
      'data-music-streaming-service-embedded-player-bandcamp-embed-url': bandcampProvider?.embedUrl,
      'data-music-streaming-service-embedded-player-tidal-embed-url': tidalProvider?.embedUrl,
    }
  : {};
---

<div
  class={
    isPrincipal
      ? featureClass
      : isReleaseShowcase
        ? 'block h-full'
        : 'release-card-link prose-link-card group block h-full'
  }
  data-release-id={isReleaseShowcase ? release.id : undefined}
  data-release-role={isReleaseShowcase ? role : undefined}
  data-release-priority={isReleaseShowcase ? release.data.releases_priority : undefined}
  data-release-date={isReleaseShowcase ? releaseDateMachineValue : undefined}
  data-release-stage={isReleaseShowcase ? release.data.release_stage : undefined}
  data-release-store-slug={isReleaseShowcase ? storeSlug : undefined}
  data-release-physical-format={
    isReleaseShowcase && (!commerceLink || commerceLink.isNativeStoreLink) ? physicalFormat : undefined
  }
  {...dataAttributes}
>
  {!isReleaseShowcase && (
    <a class="prose-card-link" href={detailPath} data-astro-prefetch>
      <span class="sr-only">{releaseCardTitle}</span>
    </a>
  )}
  <Card
    style={isPrincipal ? { display: 'contents' } : undefined}
    className={
      usesFramedArtworkLayout
        ? `rounded-none border-0 bg-transparent shadow-none ${isArtistDiscography ? 'release-card-tile--artist-discography' : 'release-card-tile--framed'}`
        : 'catalog-tile-card rounded-none border-[#2b2b2b] bg-[#141414] shadow-none'
    }
  >
    <div
      class={
        isPrincipal
          ? `release-card-image-shell ${featurePartPrefix}artwork-link`
          : usesFramedArtworkLayout
            ? `release-card-image-shell release-card-image-shell--framed${isReleaseShowcase ? ' relative' : ''}`
            : 'relative aspect-square overflow-hidden border-b border-[#2b2b2b]'
      }
    >
      <ArtworkTag
        href={isReleaseShowcase ? detailPath : undefined}
        tabindex={isReleaseShowcase ? -1 : undefined}
        data-release-artwork={isReleaseShowcase ? true : undefined}
        data-astro-prefetch={isReleaseShowcase ? true : undefined}
        class={
          isPrincipal
            ? 'release-card-image-frame release-card-artwork-link block'
            : usesFramedArtworkLayout
              ? `release-card-image-frame release-card-image-frame--framed${isReleaseShowcase ? ' release-card-artwork-link block' : ''}`
              : 'relative h-full w-full overflow-hidden'
        }
      >
        <Image
          src={release.data.cover_image}
          alt={release.data.cover_image_alt || release.data.title}
          class={
            isPrincipal
              ? `release-card-artwork w-full ${featurePartPrefix}artwork`
              : usesFramedArtworkLayout
                ? 'release-card-artwork release-card-artwork--framed h-full w-full object-cover'
                : 'release-card-artwork h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]'
          }
          widths={releaseCardImageWidths}
          width={largestImageWidth(release.data.cover_image, releaseCardImageWidths)}
          sizes={releaseCardImageSizes}
          quality={editorialImageQuality}
          loading={imageLoading}
          priority={isReleaseShowcase && imagePriority}
        />
        <div
          data-release-artwork-scrim={isReleaseShowcase ? true : undefined}
          class="absolute inset-0 bg-gradient-to-t from-black/85 via-transparent to-transparent"
          hidden={isPrincipal}
        ></div>
        {!isReleaseShowcase && (
          <div class="release-card-meta-row absolute inset-x-0 bottom-0 px-2.5 py-3">
            {embeddedPlayerData && (
              <MusicStreamingServiceListenTrigger embeddedPlayerData={embeddedPlayerData} includePlayerData={false} />
            )}
            <span class="release-card-view-release-text release-card-view-release-desktop-reveal uppercase text-foreground">
              View release
            </span>
          </div>
        )}
      </ArtworkTag>
      {isReleaseShowcase && !isPrincipal && (
        <div class="release-card-meta-row pointer-events-none absolute inset-x-0 bottom-0 px-2.5 py-3">
          {embeddedPlayerData && (
            <MusicStreamingServiceListenTrigger
              class="pointer-events-auto"
              embeddedPlayerData={embeddedPlayerData}
              includePlayerData={false}
            />
          )}
        </div>
      )}
    </div>
    <CardContent
      className={
        isPrincipal
          ? `release-card-copy ${featurePartPrefix}copy`
          : usesFramedArtworkLayout
            ? `release-card-copy space-y-2.5 p-0 pt-4 ${isArtistDiscography ? 'release-card-copy--artist-discography' : 'release-card-copy--framed'}`
            : 'release-card-copy space-y-2 p-5'
      }
    >
      {isReleaseShowcase && (
        <div class="flex flex-wrap gap-2" data-release-badges>
          {neutralPresentation.badges.map((badge) => (
            <span class="store-item-card__release-status">{badge}</span>
          ))}
        </div>
      )}
      <p class="release-card-year-text">
        {releaseDateMachineValue ? (
          <time datetime={releaseDateMachineValue}>{releaseDate}</time>
        ) : (
          <span>{releaseDate}</span>
        )}
      </p>
      <HeadingTag
        class={`brand-card-title text-foreground${isPrincipal ? ` ${featurePartPrefix}title` : ''}`}
        data-release-title={isReleaseShowcase ? true : undefined}
      >
        {isReleaseShowcase ? (
          <a class="release-card-title-link" href={detailPath} data-release-detail data-astro-prefetch>
            {release.data.title.toUpperCase()}
          </a>
        ) : (
          release.data.title.toUpperCase()
        )}
      </HeadingTag>
      {isArtistDiscography ? (
        release.data.summary ? (
          <Prose
            class="release-card-summary-text text-sm leading-relaxed text-muted-foreground"
            value={release.data.summary}
            rich={release.data.summary_rich}
            data-content-path="summary"
          />
        ) : null
      ) : (
        <p class="release-card-artist-text text-sm tracking-[0.03em] text-muted-foreground">
          {artist ? (
            <a class="release-card-artist-link" href={createArtistDetailPath(artist)} data-astro-prefetch>
              {artistName}
            </a>
          ) : (
            artistName
          )}
        </p>
      )}
      {isReleaseShowcase && (
        <>
          {release.data.formats?.length && (
            <p class="releases-latest-feature__upcoming-formats">{release.data.formats.join(' / ')}</p>
          )}
          {release.data.summary && (
            <div
              data-release-summary
              hidden={!isPrincipal}
              class={isPrincipal ? `${featurePartPrefix}summary` : undefined}
            >
              <Prose value={release.data.summary} rich={release.data.summary_rich} />
            </div>
          )}
          <p class="text-sm text-muted-foreground" data-release-shipping hidden></p>
          <div class="releases-latest-feature__actions" data-release-actions>
            {commerceLink && (
              <a
                class={buttonVariants({ variant: 'outline', size: 'lg' })}
                href={commerceLink.href}
                rel={commerceLink.rel}
                target={commerceLink.target}
                data-astro-prefetch={commerceLink.isNativeStoreLink}
                data-release-purchase
                data-release-neutral-class={buttonVariants({ variant: 'outline', size: 'lg' })}
              >
                {commerceLink.isNativeStoreLink
                  ? physicalFormat === 'vinyl'
                    ? 'View vinyl details'
                    : 'View edition'
                  : commerceLink.label}
              </a>
            )}
            {isPrincipal && embeddedPlayerData && (
              <MusicStreamingServiceListenTrigger embeddedPlayerData={embeddedPlayerData} includePlayerData={false} />
            )}
          </div>
        </>
      )}
    </CardContent>
  </Card>
</div>

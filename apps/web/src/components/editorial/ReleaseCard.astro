---
import Prose from '@/components/Prose.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import MusicStreamingServiceListenTrigger from '@/components/music/MusicStreamingServiceListenTrigger.astro';
import StoreBuyIcon from '@/components/store/StoreBuyIcon';
import { Card, CardContent } from '@/components/ui/card';
import { buttonVariants } from '@/components/ui/button';
import { getReleasePresentationEntry, type ReleaseCommerceLink } from './release-commerce';
import {
  physicalBadgeState,
  projectedListing,
  releaseActionClassName,
  releasePresentation,
} from './release-presentation';
import { readOpenPreorders } from '@/lib/open-preorders';
import { createArtistDetailPath, createReleaseDetailPath, resolveReleaseArtistDisplayName } from '@/lib/catalog-data';
import { createProjectRelativeUrl } from '@/platform/config/site';
import { formatMonthYear } from '@/utils/content';
import { buildEmbeddedPlayerData } from '@/components/music/music';
import {
  createImageSizes,
  editorialImageQuality,
  largestImageWidth,
  PAGE_MAX_WIDTH,
} from '@/platform/lib/editorial-image';

interface Props {
  release: CollectionEntry<'releases'>;
  artist: CollectionEntry<'artists'> | undefined;
  imageLoading?: 'eager' | 'lazy';
  variant?: 'default' | 'framed-artwork' | 'artist-discography' | 'releases';
  commerceLink?: ReleaseCommerceLink | null | undefined;
  imagePriority?: boolean;
  role?: 'lead' | 'supporting' | 'catalog';
}

const {
  release,
  artist,
  imageLoading = 'lazy',
  variant = 'default',
  commerceLink,
  imagePriority = false,
  role = 'catalog',
} = Astro.props;
const artistName = resolveReleaseArtistDisplayName(release, artist);
const releaseCardTitle = `${release.data.title} — ${artistName}`;
const embeddedPlayerData = buildEmbeddedPlayerData(release.id, release.data, releaseCardTitle);
const bandcampProvider = embeddedPlayerData?.providers.find((provider) => provider.id === 'bandcamp');
const tidalProvider = embeddedPlayerData?.providers.find((provider) => provider.id === 'tidal');
const isReleaseShowcase = variant === 'releases';
const isPrincipal = isReleaseShowcase && role !== 'catalog';
const HeadingTag = isPrincipal ? 'h2' : 'h3';
const ArtworkTag = isReleaseShowcase ? 'a' : 'div';
const isFramedArtwork = variant === 'framed-artwork' || isReleaseShowcase;
const isArtistDiscography = variant === 'artist-discography';
const usesFramedArtworkLayout = isFramedArtwork || isArtistDiscography;
const releaseCardImageWidths = isArtistDiscography
  ? [240, 320, 480, 640]
  : isReleaseShowcase
    ? [320, 480, 720, 1080, 1440, 1800]
    : [320, 480, 640, 800, 960];
// Releases slots follow global.css: the page frame (PAGE_MAX_WIDTH less 2rem gutters from 64rem, 1.5rem from 40rem,
// 1rem below), featured covers of 29rem from 64rem or half the frame less a 1.5rem gap from 40rem, catalog columns
// with 1.5rem gaps, and 1px frames. Every cover is contained in a square frame.
const releaseCardImageSizes = isPrincipal
  ? createImageSizes(release.data.cover_image, [
      { media: '(min-width: 64rem)', width: '29rem - 2px', frameAspectRatio: 1 },
      { media: '(min-width: 40rem)', width: '(100vw - 4.5rem) / 2 - 2px', frameAspectRatio: 1 },
      { width: '100vw - 2rem - 2px', frameAspectRatio: 1 },
    ])
  : isReleaseShowcase
    ? createImageSizes(release.data.cover_image, [
        {
          media: `(min-width: ${PAGE_MAX_WIDTH})`,
          width: `(${PAGE_MAX_WIDTH} - 7rem) / 3 - 2px`,
          frameAspectRatio: 1,
        },
        { media: '(min-width: 64rem)', width: '(100vw - 7rem) / 3 - 2px', frameAspectRatio: 1 },
        { media: '(min-width: 40rem)', width: '(100vw - 4.5rem) / 2 - 2px', frameAspectRatio: 1 },
        { width: '100vw - 2rem - 2px', frameAspectRatio: 1 },
      ])
    : isFramedArtwork
      ? '(min-width: 87rem) calc(((87rem - 9.5rem) / 3 - 2px) * 1.026), (min-width: 80rem) calc(((100vw - 9.5rem) / 3 - 2px) * 1.026), (min-width: 64rem) calc(((100vw - 8.25rem) / 2 - 2px) * 1.026), (min-width: 60rem) calc(((100vw - 7.25rem) / 2 - 2px) * 1.026), (min-width: 48rem) calc(((95vw - 4.25rem) / 2 - 2px) * 1.026), (min-width: 40rem) calc((95vw - 3rem - 2px) * 1.026), calc((100vw - 4rem - 2px) * 1.026)'
      : '(min-width: 1280px) 260px, (min-width: 768px) 50vw, 100vw';
const releaseDate = formatMonthYear(release.data.release_date);
const releaseDateMachineValue = release.data.release_date?.toISOString().slice(0, 10);
const detailPath = createReleaseDetailPath(release);
const presentationEntry = getReleasePresentationEntry(release, commerceLink);
const physicalFormat = presentationEntry.edition.kind !== 'none' ? presentationEntry.edition.format : undefined;
const storeSlug = presentationEntry.edition.kind === 'native' ? presentationEntry.edition.storeSlug : undefined;
// The HTML carries the open pre-order projection; the live offer read only corrects it.
const projected =
  isReleaseShowcase && storeSlug ? readOpenPreorders().find((item) => item.storeItemSlug === storeSlug) : undefined;
const presentation = releasePresentation(presentationEntry, projected && projectedListing(projected));
const physicalState = physicalBadgeState(presentation);
// A native edition's Store path is the one destination the artwork and the edition action share, together with
// their hover and focus feedback; without one the artwork keeps the release detail link and nothing is shared.
const editionHref = isReleaseShowcase && commerceLink?.isNativeStoreLink ? commerceLink.href : undefined;
// Buy carries the Store card's record mark for its format; it shows only while the action reads Buy.
const buyIconFormatGroup = physicalFormat === 'cd' ? 'CDs' : physicalFormat === 'cassette' ? 'Tapes' : 'Vinyl 12-inch';
// Below 40rem a featured summary longer than about three phone lines starts clamped; the native disclosure expands it
// without script, and wider screens show it whole.
const summaryDisclosure = isPrincipal && (release.data.summary?.length ?? 0) > 140;

const dataAttributes = embeddedPlayerData
  ? {
      'data-music-streaming-service-embedded-player-card': true,
      'data-music-streaming-service-embedded-player-release-id': embeddedPlayerData.releaseId,
      'data-music-streaming-service-embedded-player-title': embeddedPlayerData.title,
      'data-music-streaming-service-embedded-player-bandcamp-embed-url': bandcampProvider?.embedUrl,
      'data-music-streaming-service-embedded-player-tidal-embed-url': tidalProvider?.embedUrl,
    }
  : {};
---

<div
  class={
    isPrincipal
      ? 'releases-feature'
      : isReleaseShowcase
        ? 'block h-full'
        : 'release-card-link prose-link-card group block h-full'
  }
  data-release-id={isReleaseShowcase ? release.id : undefined}
  data-release-role={isReleaseShowcase ? role : undefined}
  data-release-name={isReleaseShowcase ? release.data.title : undefined}
  data-release-priority={isReleaseShowcase ? release.data.releases_priority : undefined}
  data-release-date={isReleaseShowcase ? releaseDateMachineValue : undefined}
  data-release-store-slug={isReleaseShowcase ? storeSlug : undefined}
  data-release-physical-format={
    isReleaseShowcase && (!commerceLink || commerceLink.isNativeStoreLink) ? physicalFormat : undefined
  }
  data-release-edition-link={editionHref ? true : undefined}
  data-release-projected={projected ? JSON.stringify(projected) : undefined}
  {...dataAttributes}
>
  {!isReleaseShowcase && (
    <a class="prose-card-link" href={detailPath} data-astro-prefetch>
      <span class="sr-only">{releaseCardTitle}</span>
    </a>
  )}
  <Card
    style={isPrincipal ? { display: 'contents' } : undefined}
    className={
      usesFramedArtworkLayout
        ? `rounded-none border-0 bg-transparent shadow-none ${isArtistDiscography ? 'release-card-tile--artist-discography' : 'release-card-tile--framed'}`
        : 'catalog-tile-card rounded-none border-flint-850 bg-[#141414] shadow-none'
    }
  >
    <div
      class={
        isReleaseShowcase
          ? 'release-card-image-shell releases-cover'
          : usesFramedArtworkLayout
            ? 'release-card-image-shell release-card-image-shell--framed'
            : 'relative aspect-square overflow-hidden border-b border-flint-850'
      }
    >
      <ArtworkTag
        href={isReleaseShowcase ? (editionHref ?? detailPath) : undefined}
        aria-label={editionHref ? `${release.data.title}, ${presentation.action}` : undefined}
        tabindex={isReleaseShowcase ? -1 : undefined}
        data-release-artwork={isReleaseShowcase ? true : undefined}
        data-astro-prefetch={isReleaseShowcase ? true : undefined}
        class={
          isReleaseShowcase
            ? 'release-card-image-frame release-card-artwork-link block'
            : usesFramedArtworkLayout
              ? 'release-card-image-frame release-card-image-frame--framed'
              : 'relative h-full w-full overflow-hidden'
        }
      >
        <Image
          src={release.data.cover_image}
          alt={release.data.cover_image_alt || release.data.title}
          class={
            isReleaseShowcase
              ? 'release-card-artwork releases-cover__image'
              : usesFramedArtworkLayout
                ? 'release-card-artwork release-card-artwork--framed h-full w-full object-cover'
                : 'release-card-artwork h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]'
          }
          widths={releaseCardImageWidths}
          width={largestImageWidth(release.data.cover_image, releaseCardImageWidths)}
          sizes={releaseCardImageSizes}
          quality={editorialImageQuality}
          loading={imageLoading}
          priority={isReleaseShowcase && imagePriority}
        />
        {!isReleaseShowcase && (
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-transparent to-transparent"></div>
        )}
        {!isReleaseShowcase && (
          <div class="release-card-meta-row absolute inset-x-0 bottom-0 px-2.5 py-3">
            {embeddedPlayerData && (
              <MusicStreamingServiceListenTrigger embeddedPlayerData={embeddedPlayerData} includePlayerData={false} />
            )}
            <span class="release-card-view-release-text release-card-view-release-desktop-reveal uppercase text-foreground">
              View release
            </span>
          </div>
        )}
      </ArtworkTag>
    </div>
    <CardContent
      className={
        isPrincipal
          ? 'release-card-copy releases-feature__copy p-0'
          : isReleaseShowcase
            ? 'release-card-copy releases-tile__copy p-0'
            : usesFramedArtworkLayout
              ? `release-card-copy space-y-2.5 p-0 pt-4 ${isArtistDiscography ? 'release-card-copy--artist-discography' : 'release-card-copy--framed'}`
              : 'release-card-copy space-y-2 p-5'
      }
    >
      {isReleaseShowcase && (
        <div class="release-card-actions" data-release-actions>
          {editionHref ? (
            <a
              class={releaseActionClassName(presentation)}
              href={editionHref}
              aria-label={`${presentation.action}, ${release.data.title}`}
              data-astro-prefetch
              data-release-purchase
            >
              <StoreBuyIcon formatGroup={buyIconFormatGroup} />
              <span data-release-purchase-label>{presentation.action}</span>
            </a>
          ) : (
            commerceLink && (
              <a
                class={buttonVariants({ variant: 'outline' })}
                href={commerceLink.href}
                rel={commerceLink.rel}
                target={commerceLink.target}
                data-release-purchase
              >
                {commerceLink.label}
              </a>
            )
          )}
          {embeddedPlayerData && (
            <MusicStreamingServiceListenTrigger
              embeddedPlayerData={embeddedPlayerData}
              includePlayerData={false}
              context={`${release.data.title} by ${artistName}`}
            />
          )}
        </div>
      )}
      <p class="release-card-year-text whitespace-normal">
        <span class="whitespace-nowrap">
          {releaseDateMachineValue ? (
            <time datetime={releaseDateMachineValue}>{releaseDate}</time>
          ) : (
            <span>{releaseDate}</span>
          )}
        </span>{' '}
        <span class="whitespace-nowrap" data-release-catalog-number>
          <span aria-hidden="true">· </span>
          <span class="sr-only">Catalog number </span>
          {release.data.catalog_number}
        </span>
      </p>
      <HeadingTag
        class={`brand-card-title text-foreground${isPrincipal ? ' releases-feature__title' : ''}`}
        data-release-title={isReleaseShowcase ? true : undefined}
      >
        {isReleaseShowcase ? (
          <a class="release-card-title-link" href={detailPath} data-release-detail data-astro-prefetch>
            {release.data.title.toUpperCase()}
          </a>
        ) : (
          release.data.title.toUpperCase()
        )}
      </HeadingTag>
      {isArtistDiscography ? (
        release.data.summary ? (
          <Prose
            class="release-card-summary-text text-sm leading-relaxed text-muted-foreground"
            value={release.data.summary}
            rich={release.data.summary_rich}
            data-content-path="summary"
          />
        ) : null
      ) : (
        <p class="release-card-artist-text text-sm tracking-[0.03em] text-muted-foreground">
          {artist ? (
            <a class="release-card-artist-link" href={createArtistDetailPath(artist)} data-astro-prefetch>
              {artistName}
            </a>
          ) : (
            artistName
          )}
        </p>
      )}
      {isReleaseShowcase && (
        <>
          <div class="release-card-format-row">
            {release.data.formats?.length && <p class="release-card-formats">{release.data.formats.join(' / ')}</p>}
            {editionHref && (
              <p class="release-card-price" data-release-price hidden={!presentation.price}>
                {presentation.price}
              </p>
            )}
          </div>
          <div class="flex flex-wrap gap-2" data-release-badges>
            {presentation.badges.map((badge, index) => (
              <span
                class={badge.startsWith('Pre-order') ? 'preorder-badge' : 'store-item-card__release-status'}
                data-availability-state={
                  physicalState && index === presentation.badges.length - 1 ? physicalState : undefined
                }
              >
                {badge}
              </span>
            ))}
          </div>
          <p class="text-sm text-muted-foreground" data-release-shipping hidden={!presentation.shipping}>
            {presentation.shipping}
          </p>
          {release.data.summary && (
            <div
              data-release-summary
              hidden={!isPrincipal}
              class={isPrincipal ? 'releases-feature__summary' : undefined}
            >
              <Prose value={release.data.summary} rich={release.data.summary_rich} />
            </div>
          )}
          {isPrincipal && (summaryDisclosure || editionHref) && (
            <div class="releases-feature__links">
              {summaryDisclosure && (
                <details class="releases-feature__more" data-release-more>
                  <summary>
                    <span>Read more</span>
                    <span>Show less</span>
                  </summary>
                </details>
              )}
              {editionHref && (
                <a
                  class="releases-feature__terms"
                  href={createProjectRelativeUrl('/terms/')}
                  data-astro-prefetch
                  data-release-terms
                  inert={presentation.state !== 'preorder'}
                >
                  Pre-order &amp; delivery information
                </a>
              )}
            </div>
          )}
        </>
      )}
    </CardContent>
  </Card>
</div>

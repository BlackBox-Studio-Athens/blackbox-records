---
import Prose from '@/components/Prose.astro';
import { getImage, Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

import MusicStreamingServiceListenTrigger from '@/components/music/MusicStreamingServiceListenTrigger.astro';
import StoreImageGallery from '@/components/store/StoreImageGallery';
import { Badge } from '@/components/ui/badge';
import { Card, CardContent } from '@/components/ui/card';
import { buttonVariants } from '@/components/ui/button';
import { createProjectRelativeUrl } from '@/platform/config/site';
import { resolveArtistProfileForRelease, resolveReleaseArtistDisplayName } from '@/lib/catalog-data';
import { getReleaseCommerceLink } from './release-commerce';
import { formatDayMonthYear } from '@/utils/content';
import { buildEmbeddedPlayerData } from '@/components/music/music';

interface Props {
  release: CollectionEntry<'releases'>;
  showRouteNavigation?: boolean;
}

const { release, showRouteNavigation = true } = Astro.props;
const releaseArtist = await resolveArtistProfileForRelease(release);
const artistName = resolveReleaseArtistDisplayName(release, releaseArtist);
const artistUrl = releaseArtist
  ? createProjectRelativeUrl(`/artists/${releaseArtist.data.slug}/`)
  : createProjectRelativeUrl('/artists/');
const releaseDate = formatDayMonthYear(release.data.release_date);
const releaseDateMachineValue = release.data.release_date?.toISOString().slice(0, 10);
const embeddedPlayerTitle = `${release.data.title} — ${artistName}`;
const embeddedPlayerData = buildEmbeddedPlayerData(release.id, release.data, embeddedPlayerTitle);
const commerceLink = await getReleaseCommerceLink(release);
const singles = release.data.singles ?? [];
const clips = release.data.clips ?? [];
const gallery = release.data.gallery ?? [];
const galleryImages =
  gallery.length > 0
    ? await Promise.all(
        [
          { image: release.data.cover_image, image_alt: release.data.cover_image_alt || release.data.title },
          ...gallery,
        ].map(async ({ image, image_alt }) => {
          const optimized = await getImage({ src: image, widths: [96, 480, 720, 960, 1200], format: 'webp' });
          return {
            src: optimized.src,
            srcSet: optimized.srcSet.attribute,
            alt: image_alt,
            width: image.width,
            height: image.height,
          };
        }),
      )
    : [];
---

<section class="layout-container pt-14">
  <Card className="surface-card overflow-hidden">
    <CardContent className="grid gap-8 p-0 lg:grid-cols-[0.85fr_1.15fr]">
      <div class="relative overflow-hidden border-b border-border/70 lg:border-r lg:border-b-0">
        {galleryImages.length > 1 ? (
          <StoreImageGallery client:load images={galleryImages} title={release.data.title} />
        ) : (
          <>
            <Image
              src={release.data.cover_image}
              alt={release.data.cover_image_alt || release.data.title}
              class="release-detail-cover__image h-full w-full object-cover"
              widths={[720, 1080, 1440, 1800]}
              sizes="(min-width: 1024px) 36vw, 100vw"
              loading="eager"
              priority={showRouteNavigation}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
          </>
        )}
      </div>
      <div class="space-y-5 p-7 sm:p-9">
        <Badge variant="outline" className="border-border/70 bg-background/80 text-xs tracking-[0.15em] uppercase">
          Release
        </Badge>
        <h1 class="release-detail-page-title uppercase text-foreground">{release.data.title.toUpperCase()}</h1>
        <p class="text-sm uppercase tracking-[0.13em] text-muted-foreground">
          <a
            href={artistUrl}
            data-astro-prefetch
            class="underline decoration-border underline-offset-4 transition-colors hover:text-foreground"
          >
            {artistName}
          </a>
        </p>
        <p class="text-sm uppercase tracking-[0.12em] text-muted-foreground">
          <span>Release date</span>
          <span aria-hidden="true"> / </span>
          {releaseDateMachineValue ? (
            <time datetime={releaseDateMachineValue}>{releaseDate}</time>
          ) : (
            <span>{releaseDate}</span>
          )}
        </p>
        {release.data.summary && (
          <Prose
            class="max-w-2xl text-sm leading-relaxed text-muted-foreground"
            value={release.data.summary}
            rich={release.data.summary_rich}
            data-content-path="summary"
          />
        )}
        {release.data.formats && (
          <ul class="flex flex-wrap items-center gap-2">
            {release.data.formats.map((format) => (
              <li>
                <Badge variant="secondary" className="text-[11px] tracking-[0.12em] uppercase">
                  {format}
                </Badge>
              </li>
            ))}
          </ul>
        )}
        <div class="flex flex-wrap items-center gap-3 pt-1">
          {commerceLink && (
            <a
              href={commerceLink.href}
              target={commerceLink.target}
              rel={commerceLink.rel}
              class={buttonVariants({ size: 'lg', className: commerceLink.target ? 'pr-6' : undefined })}
            >
              {commerceLink.label}
              {commerceLink.target && (
                <span class="site-button-external-mark" aria-hidden="true">
                  ↗
                </span>
              )}
            </a>
          )}
          {embeddedPlayerData && (
            <MusicStreamingServiceListenTrigger
              embeddedPlayerData={embeddedPlayerData}
              includeCardAttribute
              tone="accent"
              variant="standalone"
            />
          )}
        </div>
      </div>
    </CardContent>
  </Card>
</section>

{(singles.length > 0 || clips.length > 0) && (
  <section class="layout-container mt-12" aria-labelledby="release-media-title">
    <Card className="surface-card">
      <CardContent className="space-y-8 p-7 sm:p-9">
        <h2 id="release-media-title" class="font-display text-4xl tracking-[0.08em] uppercase text-foreground">
          Singles & clips
        </h2>
        {singles.length > 0 && (
          <div>
            <h3 class="mb-3 text-xs tracking-[0.14em] text-muted-foreground uppercase">Singles</h3>
            <ul>
              {singles.map((single) => (
                <li class="flex flex-wrap items-center justify-between gap-3 border-t border-border/70 py-3">
                  <span class="text-sm text-foreground">{single.title}</span>
                  <a
                    href={single.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="min-h-11 content-center text-sm underline underline-offset-4 hover:text-foreground"
                  >
                    Listen <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        {clips.length > 0 && (
          <div>
            <h3 class="mb-4 text-xs tracking-[0.14em] text-muted-foreground uppercase">Clips</h3>
            <div class="artist-video-grid">
              {clips.map((clip) => (
                <article class="artist-video-card">
                  <iframe
                    class="artist-video-card__frame"
                    src={`https://www.youtube-nocookie.com/embed/${clip.youtube_video_id}`}
                    title={`${artistName} - ${clip.title}`}
                    loading="lazy"
                    allow="encrypted-media; picture-in-picture"
                    allowfullscreen
                  />
                  <h4 class="artist-video-card__title">{clip.title}</h4>
                </article>
              ))}
            </div>
          </div>
        )}
      </CardContent>
    </Card>
  </section>
)}

{release.data.credits && (
  <section class="layout-container mt-12">
    <Card className="surface-card">
      <CardContent className="p-7 sm:p-9">
        <h2 class="font-display text-4xl tracking-[0.08em] uppercase text-foreground">Credits</h2>
        <ul class="mt-5 grid gap-3">
          {release.data.credits.map((credit) => (
            <li class="grid gap-1 rounded-md border border-border/70 bg-background/70 px-4 py-3 sm:grid-cols-[1fr_2fr] sm:items-center sm:gap-3">
              <span class="text-xs tracking-[0.12em] text-muted-foreground uppercase">{credit.role}</span>
              <span class="text-sm uppercase tracking-[0.12em] text-foreground">{credit.name}</span>
            </li>
          ))}
        </ul>
      </CardContent>
    </Card>
  </section>
)}

{showRouteNavigation && (
  <section class="layout-container mt-12">
    <Card className="surface-card">
      <CardContent className="flex flex-wrap items-center justify-between gap-4 p-6">
        <p class="text-xs uppercase tracking-[0.14em] text-muted-foreground">Back to catalog</p>
        <div class="flex flex-wrap gap-3">
          <a
            href={createProjectRelativeUrl('/releases/')}
            data-astro-prefetch
            class={buttonVariants({ variant: 'outline' })}
          >
            All Releases
          </a>
          <a href={artistUrl} data-astro-prefetch class={buttonVariants({ variant: 'ghost' })}>
            Artist Page
          </a>
        </div>
      </CardContent>
    </Card>
  </section>
)}

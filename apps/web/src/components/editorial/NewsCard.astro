---
import Prose from '@/components/Prose.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { createProjectRelativeUrl } from '@/platform/config/site';
import { Card, CardContent } from '@/components/ui/card';
import { formatMonthYear } from '@/utils/content';
import { getEntry } from '@/lib/content-reader';
import { editorialImageQuality, largestImageWidth } from '@/platform/lib/editorial-image';

interface Props {
  item: CollectionEntry<'news'>;
  imageLoading?: 'eager' | 'lazy';
  /** The expected LCP card: eager with high fetch priority. */
  imagePriority?: boolean;
  /** The grid the card sits in: the News index (`grid gap-5 md:grid-cols-2 xl:grid-cols-3`) or home's `.home-news-grid`. */
  grid?: 'index' | 'home';
  showSummary?: boolean;
}

const { item, imageLoading = 'lazy', imagePriority = false, grid = 'index', showSummary = true } = Astro.props;
const artist = item.data.artist ? await getEntry(item.data.artist) : undefined;
const newsCardImageWidths = [360, 540, 720, 960, 1200];
// Card width (minus its 1px borders) in .layout-container: one column, then two (from 48rem on the index, 40rem on
// home), then three 21.75rem columns from 80rem.
const newsCardImageSizes = {
  index:
    '(min-width: 80rem) 21.75rem, (min-width: 64rem) calc(50vw - 2.75rem), (min-width: 48rem) calc(50vw - 2.25rem), (min-width: 40rem) calc(100vw - 3.125rem), calc(100vw - 2.125rem)',
  home: '(min-width: 80rem) 21.75rem, (min-width: 64rem) calc(50vw - 2.75rem), (min-width: 40rem) calc(50vw - 2.25rem), calc(100vw - 2.125rem)',
}[grid];
---

<div class="prose-link-card group block h-full">
  <a class="prose-card-link" href={createProjectRelativeUrl(`/news/${item.id}/`)} data-astro-prefetch>
    <span class="sr-only">{item.data.title}</span>
  </a>
  <Card className="catalog-tile-card rounded-none border-[#2b2b2b] bg-[#141414] shadow-none">
    <div class="aspect-[16/10] overflow-hidden border-b border-[#2b2b2b]">
      <Image
        src={item.data.image}
        alt={item.data.image_alt || item.data.title}
        class="news-card__image h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        widths={newsCardImageWidths}
        width={largestImageWidth(item.data.image, newsCardImageWidths)}
        sizes={newsCardImageSizes}
        quality={editorialImageQuality}
        loading={imagePriority ? 'eager' : imageLoading}
        priority={imagePriority}
      />
    </div>
    <CardContent className="space-y-3 p-5">
      <div class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-2 text-[11px] tracking-[0.18em] uppercase text-muted-foreground">
        <p>{formatMonthYear(item.data.date)}</p>
        {artist?.data.genre && (
          <span class="news-card__genre max-w-full border border-border px-2 py-1 text-xs leading-relaxed tracking-[0.12em] text-foreground [overflow-wrap:anywhere]">
            {artist.data.genre}
          </span>
        )}
      </div>
      <h3 class="brand-card-title text-foreground">{item.data.title}</h3>
      {showSummary && (
        <Prose
          class="text-sm leading-relaxed text-muted-foreground"
          value={item.data.summary}
          rich={item.data.summary_rich}
          data-content-path="summary"
        />
      )}
    </CardContent>
  </Card>
</div>

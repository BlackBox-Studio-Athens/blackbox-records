---
import Prose from '@/components/Prose.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import EditorialContent from '@/components/detail/EditorialContent.astro';

import InternalPageHero from '@/components/InternalPageHero.astro';
import { Badge } from '@/components/ui/badge';
import { Card, CardContent } from '@/components/ui/card';
import { formatMonthYear } from '@/utils/content';
import { editorialImageQuality, largestImageWidth } from '@/platform/lib/editorial-image';

interface Props {
  item: CollectionEntry<'news'>;
  imagePriority?: boolean;
}

const { item, imagePriority = true } = Astro.props;
const sectionLabel = item.data.section_label || 'News';
const leadImageWidths = [720, 1080, 1440, 1800];
// .layout-container, the card border and its p-7 / sm:p-9 padding, and the image frame border.
const leadImageSizes =
  '(min-width: 72rem) 63.25rem, (min-width: 64rem) calc(100vw - 8.75rem), (min-width: 40rem) calc(100vw - 7.75rem), calc(100vw - 5.75rem)';
---

<InternalPageHero sectionLabel={sectionLabel} title={item.data.title} />
<section class="layout-container">
  <Card className="surface-card">
    <CardContent className="space-y-6 p-7 sm:p-9">
      <Badge
        variant="outline"
        className="border-border/70 bg-background/80 text-xs tracking-[0.14em] uppercase text-muted-foreground"
      >
        {formatMonthYear(item.data.date)}
      </Badge>
      {item.data.image && (
        <div class="overflow-hidden rounded-lg border border-border/70">
          <Image
            src={item.data.image}
            alt={item.data.image_alt || item.data.title}
            class="news-detail-lead__image h-auto w-full object-cover"
            widths={leadImageWidths}
            width={largestImageWidth(item.data.image, leadImageWidths)}
            sizes={leadImageSizes}
            quality={editorialImageQuality}
            loading="eager"
            priority={imagePriority}
          />
        </div>
      )}
      {item.data.summary && (
        <Prose
          class="font-display text-3xl tracking-[0.06em] uppercase text-foreground"
          value={item.data.summary}
          rich={item.data.summary_rich}
          data-content-path="summary"
        />
      )}
      <div class="news-markdown-content text-sm leading-relaxed text-muted-foreground">
        <EditorialContent entry={item} />
      </div>
    </CardContent>
  </Card>
</section>

---
import Prose from '@/components/Prose.astro';
import MottoWordCycleLoader from './MottoWordCycleLoader';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { editorialImageQuality, largestImageWidth } from '@/platform/lib/editorial-image';
interface Props {
  tagline: import('@blackbox/content-model').Prose;
  image: ImageMetadata;
  imageAlt: string;
  scrollIndicatorText?: string;
}

const { tagline, image, imageAlt, scrollIndicatorText = 'Scroll' } = Astro.props;
const heroImageWidths = [900, 1400];
---

<section class="homepage-hero-section border-b border-border/70" id="homepage-hero-section">
  <div class="homepage-hero-section__media-layer" aria-hidden="true">
    <Image
      src={image}
      alt={imageAlt}
      class="homepage-hero-section__media-image"
      priority
      widths={heroImageWidths}
      width={largestImageWidth(image, heroImageWidths)}
      sizes="100vw"
      quality={editorialImageQuality}
    />
  </div>
  <div class="homepage-hero-section__shade-layer" aria-hidden="true"></div>

  <div class="homepage-hero-section__content-block page-content-width-constrained-container">
    <h1 class="sr-only">BlackBox Records</h1>
    <motto-word-cycle data-words="records art noise">
      <Prose class="homepage-hero-section__tagline-text" value={tagline} data-content-path="hero.tagline" />
    </motto-word-cycle>
    <MottoWordCycleLoader client:load />
  </div>

  <div class="homepage-hero-section__scroll-indicator" aria-hidden="true">
    <span>{scrollIndicatorText}</span>
    <div class="homepage-hero-section__scroll-indicator-line">
      <span></span>
    </div>
  </div>
</section>

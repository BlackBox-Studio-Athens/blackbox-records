---
import Prose from '@/components/Prose.astro';
import HomeHeroLoader from './HomeHeroLoader';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { buttonVariants } from '@/components/ui/button';
import { createProjectRelativeUrl } from '@/platform/config/site';
import { editorialImageQuality, largestImageWidth } from '@/platform/lib/editorial-image';
interface Props {
  tagline: import('@blackbox/content-model').Prose;
  image: ImageMetadata;
  imageAlt: string;
  /**
   * Prepared silent loop over the still: a centre portrait crop for phones and a landscape file for wider screens, each
   * as a sharper AV1 file and a lighter-resolution H.264 file for browsers without AV1.
   */
  film?: {
    portrait: { av1Url: string; h264Url: string };
    landscape: { av1Url: string; h264Url: string };
  };
}

const { tagline, image, imageAlt, film } = Astro.props;
const heroImageWidths = [900, 1400];
---

<section class="homepage-hero-section" id="homepage-hero-section">
  <div class="homepage-hero-section__media-layer" aria-hidden="true">
    <Image
      src={image}
      alt={imageAlt}
      class="homepage-hero-section__media-image"
      priority
      widths={heroImageWidths}
      width={largestImageWidth(image, heroImageWidths)}
      sizes="100vw"
      quality={editorialImageQuality}
    />
    {film && (
      <video
        class="homepage-hero-section__film"
        data-home-hero-film
        data-portrait-src={film.portrait.h264Url}
        data-portrait-av1-src={film.portrait.av1Url}
        data-landscape-src={film.landscape.h264Url}
        data-landscape-av1-src={film.landscape.av1Url}
        muted
        playsinline
        loop
        preload="none"
        disablepictureinpicture
        disableRemotePlayback
      />
    )}
  </div>
  <div class="homepage-hero-section__shade-layer" aria-hidden="true"></div>

  <div class="homepage-hero-section__content-block page-content-width-constrained-container">
    <h1 class="sr-only">BlackBox Records</h1>
    <motto-word-cycle data-words="records art noise">
      <Prose class="homepage-hero-section__tagline-text" value={tagline} data-content-path="hero.tagline" />
    </motto-word-cycle>
    <HomeHeroLoader client:load />
    <div class="homepage-hero-section__actions">
      <a
        href={createProjectRelativeUrl('/store/')}
        data-astro-prefetch
        class={buttonVariants({
          variant: 'outline',
          size: 'sm',
          class:
            'min-h-7 px-2 text-xs border-control-ink/48 bg-background/35 text-[#d8d8d8] pointer-coarse:before:-inset-[9px]',
        })}
      >
        Browse the Store
      </a>
    </div>
  </div>

  {film && <home-hero-film />}

  <div class="homepage-hero-section__scroll-indicator" aria-hidden="true">
    <div class="homepage-hero-section__scroll-indicator-line">
      <span></span>
    </div>
  </div>
</section>

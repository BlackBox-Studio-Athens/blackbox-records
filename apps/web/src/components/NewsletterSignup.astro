---
import Prose from '@/components/Prose.astro';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { PrivacyLink } from '@/platform/components/PurchaseInformation';
import { getNewsletterContent } from '@/lib/site-data';

interface Props {
  id?: string;
  formId?: string;
}

const { id, formId = 'newsletter-email' } = Astro.props;
const newsletterContent = await getNewsletterContent();
---

<section class="layout-container mt-16" id={id}>
  <div class="border border-border/70 bg-card/45">
    <Card className="border-none bg-transparent shadow-none">
      <CardHeader className="pb-2">
        <p class="text-xs tracking-[0.2em] text-muted-foreground uppercase">{newsletterContent.section_label}</p>
        <CardTitle className="font-display text-4xl tracking-[0.09em] uppercase">
          {newsletterContent.title.toUpperCase()}
        </CardTitle>
      </CardHeader>
      <CardContent className="pb-8">
        <Prose
          class="max-w-2xl text-sm leading-relaxed text-muted-foreground"
          value={newsletterContent.description}
          rich={newsletterContent.description_rich}
          data-content-path="description"
        />
        <div
          data-newsletter-form
          data-form-id={formId}
          data-button-label={newsletterContent.button_label}
          data-placeholder={newsletterContent.placeholder}
        ></div>
        <Prose
          class="mt-3 text-xs uppercase tracking-[0.08em] text-muted-foreground"
          value={newsletterContent.note}
          rich={newsletterContent.note_rich}
        />
        <div class="text-xs text-muted-foreground">
          <PrivacyLink />
        </div>
      </CardContent>
    </Card>
  </div>
</section>

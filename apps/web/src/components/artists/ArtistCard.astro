---
import Prose from '@/components/Prose.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { createProjectRelativeUrl } from '@/platform/config/site';
import type { ArtistRosterReleaseContext } from '@/lib/catalog-data';
import { Card, CardContent } from '@/components/ui/card';
import { cn } from '@/components/ui/utils';
import { editorialImageQuality, largestImageWidth } from '@/platform/lib/editorial-image';

interface Props {
  artist: CollectionEntry<'artists'>;
  imageLoading?: 'eager' | 'lazy';
  imagePriority?: boolean;
  releaseContext?: ArtistRosterReleaseContext;
  variant: 'featured-roster' | 'roster-detailed';
}

const { artist, imageLoading = 'lazy', imagePriority = false, releaseContext, variant } = Astro.props;
const artistName = artist.data.title || 'Artist';
const artistUrl = createProjectRelativeUrl(`/artists/${artist.data.slug}/`);
const isRosterDetailedVariant = variant === 'roster-detailed';
const releaseCount = releaseContext?.releaseCount ?? 0;
const latestReleaseTitle = releaseContext?.latestReleaseTitle || 'No releases yet';
const latestReleaseDate = releaseContext?.latestReleaseDate || '';
const hasLatestRelease = Boolean(releaseContext?.latestReleaseTitle);
const artistCardImageWidths = [480, 720, 960, 1200, 1440];
---

<div class="prose-link-card group block h-full">
  <a class="prose-card-link" href={artistUrl} data-astro-prefetch>
    <span class="sr-only">{artistName}</span>
  </a>
  <Card
    className={cn(
      'catalog-tile-card relative rounded-none border-[#2b2b2b] bg-[#141414] shadow-none',
      isRosterDetailedVariant ? 'artist-roster-card' : 'catalog-tile-card--featured-roster',
    )}
  >
    <div class="artist-photo-frame aspect-[3/4] border-b border-[#2b2b2b]">
      <Image
        src={artist.data.image}
        alt=""
        aria-hidden="true"
        class="artist-photo-fill"
        width={160}
        loading={imageLoading}
        quality={40}
      />
      <Image
        src={artist.data.image}
        alt={artist.data.image_alt || artistName}
        class="artist-roster-card__image relative h-full w-full object-contain object-center motion-safe:transition-transform motion-safe:duration-500 motion-safe:group-hover:scale-[1.03]"
        widths={artistCardImageWidths}
        width={largestImageWidth(artist.data.image, artistCardImageWidths)}
        sizes="(min-width: 1280px) 31vw, (min-width: 768px) 48vw, 100vw"
        loading={imageLoading}
        fetchpriority={imagePriority ? 'high' : 'auto'}
        quality={editorialImageQuality}
      />
    </div>
    <CardContent
      className={
        isRosterDetailedVariant
          ? 'artist-roster-card__body space-y-4 p-5 pt-5'
          : 'home-featured-roster-card__content p-5 sm:p-6'
      }
    >
      <div class="space-y-3">
        {artist.data.genre && <p class="text-[11px] tracking-[0.18em] uppercase text-[#d0d0d0]">{artist.data.genre}</p>}
        <h3 class="brand-card-title text-foreground">{artistName.toUpperCase()}</h3>
      </div>
      {isRosterDetailedVariant && (
        <>
          {artist.data.bio && (
            <Prose
              class="artist-roster-card__bio text-sm leading-relaxed text-muted-foreground"
              value={artist.data.bio}
              rich={artist.data.bio_rich}
              data-content-path="bio"
            />
          )}
          <div class="artist-roster-card__context border-t border-[#2b2b2b] pt-4">
            <div class="artist-release-stat artist-release-stat--roster">
              <span class="artist-release-stat__value">{releaseCount}</span>
              <span class="artist-release-stat__label">Releases</span>
            </div>
            <div class="artist-latest-teaser artist-latest-teaser--roster">
              <p class="artist-latest-teaser__label">Latest</p>
              {hasLatestRelease ? (
                <>
                  <p class="artist-latest-teaser__title">{latestReleaseTitle}</p>
                  {latestReleaseDate && <p class="artist-latest-teaser__meta">{latestReleaseDate}</p>}
                </>
              ) : (
                <p class="artist-latest-teaser__title artist-latest-teaser__title--muted">{latestReleaseTitle}</p>
              )}
            </div>
          </div>
        </>
      )}
    </CardContent>
  </Card>
</div>

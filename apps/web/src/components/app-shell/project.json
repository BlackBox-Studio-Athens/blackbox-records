{
  "name": "app-shell",
  "tags": ["module", "scope:web"],
  "targets": {
    "test": {
      "command": "pnpm --filter @blackbox/web exec vitest run --project=app-shell --project=app-shell:worker --project=app-shell:request --config vitest.modules.config.ts",
      "inputs": ["webTests", "^default"]
    },
    "test-watch": {
      "command": "pnpm --filter @blackbox/web exec vitest --watch --project=app-shell --project=app-shell:worker --project=app-shell:request --config vitest.modules.config.ts",
      "cache": false,
      "continuous": true
    }
  }
}

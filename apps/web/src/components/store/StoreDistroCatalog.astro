---
import Prose from '@/components/Prose.astro';
import StoreItemCard from './StoreItemCard.astro';
import { getDistroPageContent } from '@/lib/site-data';
import {
  createStoreDistroGroupHeadingId,
  getStoreDistroFormatGroup,
  groupStoreDistroCollectionEntries,
  isRecentBlackboxRelease,
  sortStoreDistroCollectionEntries,
  type StoreCollectionEntry,
} from '@/lib/store-collection';
import StoreBrowsePane from './StoreBrowsePane.astro';
import StoreCoverflowControls from './StoreCoverflowControls.astro';
import { StoreSearchToolbar } from './StoreDistroSearch';
interface Props {
  entries: StoreCollectionEntry[];
}
const { entries: sourceEntries } = Astro.props;
const referenceDate = new Date();
const entries = sortStoreDistroCollectionEntries(sourceEntries, referenceDate);
const content = await getDistroPageContent();
const groups = groupStoreDistroCollectionEntries(entries);
const enrolled = entries.length > 6;
const catalogId = 'distro-catalog';
const formats = [
  { key: 'all', target: 'distro-search-results', label: 'All formats', count: entries.length },
  ...groups.map((group) => ({
    key: createStoreDistroGroupHeadingId(group.groupName),
    target: createStoreDistroGroupHeadingId(group.groupName),
    label: group.groupName,
    count: group.entries.length,
  })),
];
---

<div class="layout-container store-browse-layout">
  <StoreBrowsePane entries={entries} resultsId="distro-search-results">
    <nav slot="formats" aria-label="Browse Distro formats" class="store-format-links" data-distro-format-navigation>
      <h2>Browse Distro formats</h2>
      {formats.map((format) => (
        <a
          href={'#' + format.target}
          data-distro-format-link
          data-distro-format-key={format.key}
          data-distro-format-current={format.key === 'all' ? '' : undefined}
          aria-current={format.key === 'all' ? 'true' : undefined}
        >
          <>
            <span>{format.label}</span>
            <span>{format.count}</span>
          </>
        </a>
      ))}
    </nav>
  </StoreBrowsePane>
  <section class="store-browse-results" aria-label="Distro">
    <Prose class="store-category-description" value={content.hero.intro} data-content-path="hero.intro" />
    <div data-distro-search>
      <StoreSearchToolbar resultsId="distro-search-results" />
    </div>
    <p data-store-result-total hidden>
      {entries.length} {entries.length === 1 ? 'item' : 'items'}
    </p>
    <div id="distro-search-results" class="distro-page-groups relative" data-distro-search-root tabindex="-1">
      {groups.map((group) => (
        <span
          id={createStoreDistroGroupHeadingId(group.groupName)}
          class="absolute top-0 scroll-mt-40"
          aria-hidden="true"
        />
      ))}
      <div
        data-store-coverflow-group={enrolled ? '' : undefined}
        data-store-coverflow-mode={enrolled ? 'catalog' : undefined}
        data-store-coverflow-total={enrolled ? entries.length : undefined}
      >
        {enrolled && <StoreCoverflowControls catalogId={catalogId} total={entries.length} />}
        <div class="store-coverflow-shell">
          {enrolled && <span class="store-coverflow-reveal" data-store-coverflow-reveal-mask aria-hidden="true" />}
          <div id={catalogId} class="distro-group-grid" data-store-coverflow-stage={enrolled ? '' : undefined}>
            {entries.map((entry, index) => (
              <StoreItemCard
                entry={entry}
                searchable
                formatKey={createStoreDistroGroupHeadingId(getStoreDistroFormatGroup(entry))}
                promoted={isRecentBlackboxRelease(entry.storeItem, referenceDate)}
                coverflowEnrolled={enrolled}
                imageLoadingMode={index === 0 ? 'priority' : index < 4 ? 'eager' : 'lazy'}
              />
            ))}
          </div>
        </div>
      </div>
      {entries.length === 0 && <p>No Store items currently available.</p>}
    </div>
  </section>
</div>

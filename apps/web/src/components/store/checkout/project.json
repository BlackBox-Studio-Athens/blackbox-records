{
  "name": "checkout-web",
  "tags": ["module", "scope:web"],
  "targets": {
    "test": {
      "command": "pnpm --filter @blackbox/web exec vitest run --project=checkout-web --project=checkout-web:worker --project=checkout-web:request --config vitest.modules.config.ts",
      "inputs": ["webTests", "^default"]
    },
    "test-watch": {
      "command": "pnpm --filter @blackbox/web exec vitest --watch --project=checkout-web --project=checkout-web:worker --project=checkout-web:request --config vitest.modules.config.ts",
      "cache": false,
      "continuous": true
    }
  },
  "metadata": {
    "boundaries": {
      "status": "closed",
      "exports": [
        "./WithdrawalForm.tsx",
        "./public-checkout-api.ts",
        "./public-checkout-presentation.ts",
        "./CheckoutOrderSummary.tsx",
        "./DeliverySummary.tsx",
        "./DeliveryRates.tsx",
        "./StoreItemPurchaseActions.tsx",
        "./CheckoutOfferStatus.tsx",
        "./CheckoutReturnStatus.tsx"
      ],
      "namedInterfaces": {
        "browser-checkout-api": "./public-checkout-api.ts"
      },
      "dependsOn": ["storefront-catalog", "store-cart", "public-commerce-http", "ui-foundation", "web-platform"],
      "workspaceInterfaces": {
        "@blackbox/api-client": ["./public"]
      }
    }
  }
}

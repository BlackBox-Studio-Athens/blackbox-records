{
  "name": "checkout-web",
  "tags": ["module", "scope:web"],
  "targets": {
    "test": {
      "command": "pnpm --filter @blackbox/web exec vitest run --project=checkout-web --project=checkout-web:worker --project=checkout-web:request --config vitest.modules.config.ts",
      "inputs": ["webTests", "^default"]
    },
    "test-watch": {
      "command": "pnpm --filter @blackbox/web exec vitest --watch --project=checkout-web --project=checkout-web:worker --project=checkout-web:request --config vitest.modules.config.ts",
      "cache": false,
      "continuous": true
    }
  }
}

---
import { Image } from 'astro:assets';
import { DIGITAL_RELEASE_BADGE } from '@blackbox/content-model';
import { buttonVariants } from '@/components/ui/button';
import { Card, CardContent } from '@/components/ui/card';
import MusicStreamingServiceListenTrigger from '@/components/music/MusicStreamingServiceListenTrigger.astro';
import StoreBuyIcon from '@/components/store/StoreBuyIcon';
import { createPricedCartSeedForStorePage } from '@/components/store/store-page-data';
import {
  getStoreDistroFormatGroup,
  type StoreCardImageLoadingMode,
  type StoreCollectionEntry,
} from '@/lib/store-collection';
import { largestImageWidth } from '@/platform/lib/editorial-image';
interface Props {
  coverflowEnrolled?: boolean;
  entry: StoreCollectionEntry;
  imageLoadingMode?: StoreCardImageLoadingMode;
  searchable?: boolean;
  formatKey?: string;
}
const { coverflowEnrolled = false, entry, imageLoadingMode = 'lazy', searchable = false, formatKey } = Astro.props;
const { storeItem, primaryAvailability, previewImage } = entry;
const priority = imageLoadingMode === 'priority';
const option = primaryAvailability?.optionLabel || entry.distro?.format || entry.distro?.group;
const cartSeed = await createPricedCartSeedForStorePage(storeItem, primaryAvailability, storeItem.image.src);
const sizes =
  '(min-width: 1440px) 16.9375rem, (min-width: 1280px) calc((100vw - 356px) / 4), (min-width: 1024px) calc((100vw - 336px) / 3), (min-width: 640px) calc((100vw - 80px) / 3), (min-width: 360px) calc((100vw - 48px) / 2), calc(100vw - 32px)';
const widths = [240, 360, 480, 640, 720];
---

<div
  class="store-item-card--listing prose-link-card group flex flex-col"
  role="group"
  aria-label={storeItem.title + ' by ' + storeItem.subtitle}
  data-distro-search-item={searchable ? '' : undefined}
  data-store-artist={searchable ? storeItem.subtitle : undefined}
  data-distro-format-key={formatKey}
  data-distro-search-text={
    searchable
      ? [storeItem.title, storeItem.subtitle, ...storeItem.metadata, entry.distro?.group].filter(Boolean).join(' ')
      : undefined
  }
  data-store-coverflow-card={coverflowEnrolled ? '' : undefined}
>
  <Card className="store-item-card__surface flex flex-1 flex-col rounded-none border-border bg-card shadow-none">
    <div class="store-item-card__image-frame">
      <Image
        src={storeItem.image}
        alt={storeItem.imageAlt}
        class="store-item-card__image"
        widths={widths}
        width={largestImageWidth(storeItem.image, widths)}
        sizes={sizes}
        data-store-grid-sizes={sizes}
        loading={priority ? 'eager' : imageLoadingMode}
        fetchpriority={priority ? 'high' : 'auto'}
      />
      {previewImage && (
        <Image
          src={previewImage.image}
          alt=""
          aria-hidden="true"
          class="store-item-card__preview"
          data-store-preview-image
          widths={widths}
          width={largestImageWidth(previewImage.image, widths)}
          sizes={sizes}
          data-store-grid-sizes={sizes}
          loading="lazy"
          fetchpriority="low"
        />
      )}
    </div>
    <a
      class="prose-card-link"
      href={storeItem.storePath}
      aria-label={storeItem.title + ' by ' + storeItem.subtitle}
      data-astro-prefetch
    ></a>
    {storeItem.embeddedPlayerData && (
      <div class="store-item-card__listen">
        <MusicStreamingServiceListenTrigger embeddedPlayerData={storeItem.embeddedPlayerData} />
      </div>
    )}
    <CardContent className="store-item-card__content">
      <h2 class="brand-card-title">{storeItem.title}</h2>
      <p class="store-item-card__artist">
        by{' '}
        <span class="store-item-card__artist-name">
          {storeItem.artistPath ? (
            <a class="store-item-card__artist-link" href={storeItem.artistPath} data-astro-prefetch>
              {storeItem.subtitle}
            </a>
          ) : (
            storeItem.subtitle
          )}
        </span>
      </p>
      {option && <p class="store-item-card__option">{option}</p>}
      <span class="store-item-card__release-status" data-store-listing-release-status hidden>
        {DIGITAL_RELEASE_BADGE}
      </span>
      <span class="store-item-card__preorder" data-store-listing-preorder hidden></span>
      <div class="store-item-card__price">
        <span
          aria-busy="true"
          class="font-display"
          data-store-item-slug={storeItem.slug}
          data-store-listing-price
          data-store-listing-price-state="loading"
        >
          Checking price
        </span>
        <span
          aria-busy="true"
          class="store-item-card__availability"
          data-store-item-slug={storeItem.slug}
          data-store-listing-availability
          data-store-listing-availability-state="pending"
          data-store-release-date={storeItem.releaseDate?.toISOString().slice(0, 10)}
        >
          Checking availability
        </span>
        {cartSeed && (
          <button
            type="button"
            class={buttonVariants({ size: 'lg', className: 'ml-auto min-w-[4.5rem] gap-1.5 px-3' })}
            data-store-card-buy={JSON.stringify(cartSeed)}
            data-store-card-buy-label="Buy"
            data-store-item-slug={storeItem.slug}
            hidden
          >
            <StoreBuyIcon formatGroup={getStoreDistroFormatGroup(entry)} />
            <span data-store-card-buy-label>Buy</span>
          </button>
        )}
      </div>
    </CardContent>
  </Card>
</div>

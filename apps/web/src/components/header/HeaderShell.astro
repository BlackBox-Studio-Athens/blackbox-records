---
interface Props {
  class?: string;
  hasBanner?: boolean;
}

const { class: className, hasBanner = false } = Astro.props;
---

<header
  class:list={[
    'fixed inset-x-0 top-0 z-[1000] border-b border-[#2b2b2b] bg-[#0d0d0d]/90 backdrop-blur-[10px]',
    hasBanner ? 'uat-site-header' : 'h-[var(--header-height)]',
    className,
  ]}
>
  <slot name="banner" />
  <div
    class:list={['layout-container flex items-center justify-between gap-4 md:gap-6', hasBanner ? 'h-20' : 'h-full']}
  >
    <slot />
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.uat-site-header');
  if (header) {
    const updateHeight = () =>
      document.documentElement.style.setProperty('--header-height', `${header.offsetHeight}px`);
    updateHeight();
    new ResizeObserver(updateHeight).observe(header);
  }
</script>

---
import type { MainNavigation } from '@/lib/site-data';
import { navigationLinkAttributes } from '@/platform/utils/urls';

interface Props {
  items: MainNavigation['sections'];
  pathname: string;
}

const { items, pathname } = Astro.props;
---

<nav class="hidden lg:block" aria-label="Primary">
  <ul class="flex items-center gap-[var(--header-nav-gap)]">
    {items.map((item) => (
      <li>
        <a class="site-nav-link site-nav-link--header" {...navigationLinkAttributes(item.url, pathname)}>
          <span class="site-nav-link__label">{item.title}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

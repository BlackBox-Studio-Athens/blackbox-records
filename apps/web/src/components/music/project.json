{
  "name": "player",
  "tags": ["module", "scope:web"],
  "targets": {
    "test": {
      "command": "pnpm --filter @blackbox/web exec vitest run --project=player --project=player:worker --project=player:request --config vitest.modules.config.ts",
      "inputs": ["webTests", "^default"]
    },
    "test-watch": {
      "command": "pnpm --filter @blackbox/web exec vitest --watch --project=player --project=player:worker --project=player:request --config vitest.modules.config.ts",
      "cache": false,
      "continuous": true
    }
  },
  "implicitDependencies": ["ui-foundation"],
  "metadata": {
    "boundaries": {
      "status": "closed",
      "exports": [
        "./MusicStreamingServiceListenTrigger.astro",
        "./MusicEqualizer.tsx",
        "./player-provider-data.ts",
        "./player-provider-warmup.ts",
        "./player-iframe-session.ts",
        "./player-session-machine.ts",
        "./player-session-ui.ts",
        "./music.ts"
      ],
      "namedInterfaces": {},
      "dependsOn": ["ui-foundation", "web-platform"],
      "workspaceInterfaces": {
        "@blackbox/content-model": ["."]
      }
    }
  }
}

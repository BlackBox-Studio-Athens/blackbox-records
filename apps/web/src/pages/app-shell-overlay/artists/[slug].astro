---
export const partial = true;

import ArtistDetailContent from '@/components/artists/ArtistDetailContent.astro';
import { getEntry } from '@/lib/content-reader';
import { createArtistDetailStaticPaths, type ArtistProfileEntry } from '@/lib/catalog-data';

export async function getStaticPaths() {
  return createArtistDetailStaticPaths();
}

interface Props {
  artist: ArtistProfileEntry;
}

const artist = Astro.props.artist ?? (await getEntry('artists', Astro.params.slug ?? ''));
if (!artist) return new Response('Not found', { status: 404 });
---

<div
  data-app-shell-overlay-fragment
  data-app-shell-overlay-kind="artists"
  data-app-shell-overlay-slug={artist.data.slug}
  data-app-shell-overlay-title={artist.data.title || 'Artist'}
>
  <ArtistDetailContent artist={artist} showRouteNavigation={false} />
</div>

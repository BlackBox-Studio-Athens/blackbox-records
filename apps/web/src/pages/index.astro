---
import ArtistCard from '@/components/artists/ArtistCard.astro';
import HomeHero from '@/components/editorial/HomeHero.astro';
import NewsCard from '@/components/editorial/NewsCard.astro';
import StorePreorderShowcase from '@/components/store/StorePreorderShowcase';
import NewsletterSignup from '@/components/NewsletterSignup.astro';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { buttonVariants } from '@/components/ui/button';
import { SwipeRowDots } from '@/components/ui/swipe-row-dots';
import { createProjectRelativeUrl } from '@/platform/config/site';
import { listArtistRosterProfiles, listNewsArticles } from '@/lib/catalog-data';
import { getHomeContent } from '@/lib/site-data';
import { readOpenPreorders } from '@/lib/open-preorders';
import { preorderDemoClip, preorderShowcaseItems } from './_preorder-showcase';
import heroFilmLandscapeUrl from './_assets/home-hero/home-hero-intro-landscape.mp4?url';
import heroFilmPortraitUrl from './_assets/home-hero/home-hero-intro-portrait.mp4?url';

const artistProfiles = await listArtistRosterProfiles();
const newsArticles = await listNewsArticles();
const latestNewsArticles = newsArticles.slice(0, 3);
const featuredArtistProfiles = artistProfiles.slice(0, 3);
const homeContent = await getHomeContent();
const homeNews = homeContent.news;
const homeArtists = homeContent.artists;
// Pre-orders are in this HTML or absent; nothing is inserted after paint.
const preorderItems = await preorderShowcaseItems(readOpenPreorders());
// DRAFT: demo film for the phone-layout drafts; delete at finalize.
const demoClip = preorderItems.length > 0 ? await preorderDemoClip() : undefined;
---

<SiteLayout mainClass="!pt-0">
  <HomeHero
    tagline={homeContent.hero.tagline}
    image={homeContent.hero.image}
    imageAlt={homeContent.hero.image_alt}
    film={{ portraitUrl: heroFilmPortraitUrl, landscapeUrl: heroFilmLandscapeUrl }}
  />

  {preorderItems.length > 0 && (
    <StorePreorderShowcase
      client:idle
      items={preorderItems}
      storeUrl={createProjectRelativeUrl('/store/')}
      demoClip={demoClip}
    />
  )}

  {homeNews && latestNewsArticles.length > 0 && (
    <section class="home-news-section layout-container mt-16" id="news">
      <div class="home-section-header home-section-header--split mb-6 sm:mb-8">
        <div class="home-section-header__lead">
          <h2 class="home-section-header__title">{homeNews.title}</h2>
          <span class="home-section-header__rule" aria-hidden="true" />
        </div>
        <a
          href={createProjectRelativeUrl(homeNews.link_url)}
          data-astro-prefetch
          class={buttonVariants({ variant: 'inverse' })}
        >
          {homeNews.link_text}
        </a>
      </div>
      <div class="home-news-grid home-swipe-row" id="home-news-row">
        {latestNewsArticles.map((newsArticle) => (
          <NewsCard item={newsArticle} grid="home" />
        ))}
      </div>
      <SwipeRowDots
        client:load
        rowId="home-news-row"
        count={latestNewsArticles.length}
        label="News position"
        className="mt-3 sm:hidden"
      />
    </section>
  )}

  {homeArtists && (
    <section class="artists-surface-section mt-12 py-14 sm:mt-20 sm:py-24" id="artists">
      <div class="layout-container">
        <div class="home-section-header home-section-header--centered mb-6 sm:mb-8">
          <span class="home-section-header__rule" aria-hidden="true" />
          <h2 class="home-section-header__title">{homeArtists.title}</h2>
          <span class="home-section-header__rule" aria-hidden="true" />
        </div>
        <div class="home-featured-roster-grid home-swipe-row" id="home-artists-row">
          {featuredArtistProfiles.map((artistProfile) => (
            <ArtistCard artist={artistProfile} variant="featured-roster" />
          ))}
        </div>
        <SwipeRowDots
          client:load
          rowId="home-artists-row"
          count={featuredArtistProfiles.length}
          label="Artists position"
          className="mt-3 sm:hidden"
        />
        <div class="mt-8 text-center">
          <a
            href={createProjectRelativeUrl(homeArtists.button_link)}
            data-astro-prefetch
            class={buttonVariants({ variant: 'inverse' })}
          >
            {homeArtists.button_text}
          </a>
        </div>
      </div>
    </section>
  )}

  <NewsletterSignup id="newsletter-signup-area" />
</SiteLayout>

---
import ArtistPrint from '@/components/artists/ArtistPrint.astro';
import HomeHero from '@/components/editorial/HomeHero.astro';
import NewsCard from '@/components/editorial/NewsCard.astro';
import NewsletterSignup from '@/components/NewsletterSignup.astro';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { buttonVariants } from '@/components/ui/button';
import { createProjectRelativeUrl } from '@/platform/config/site';
import { listArtistProfiles, listNewsArticles } from '@/lib/catalog-data';
import { getHomeContent } from '@/lib/site-data';

const artistProfiles = await listArtistProfiles();
const newsArticles = await listNewsArticles();
const latestNewsArticles = newsArticles.slice(0, 3);
const featuredArtistProfiles = artistProfiles.slice(0, 3);
const homeContent = await getHomeContent();
const homeNews = homeContent.news;
const homeArtists = homeContent.artists;
---

<SiteLayout pageTitle="Home" pageDescription="BlackBox Records home." mainClass="!pt-0">
  <HomeHero
    tagline={homeContent.hero.tagline}
    image={homeContent.hero.image}
    imageAlt={homeContent.hero.image_alt}
    scrollIndicatorText={homeContent.hero.scroll_indicator_text}
  />

  {homeNews && latestNewsArticles.length > 0 && (
    <section class="home-news-section layout-container mt-16" id="news">
      <div class="home-section-header home-section-header--split mb-6 sm:mb-8">
        <div class="home-section-header__lead">
          <h2 class="home-section-header__title">{homeNews.title}</h2>
          <span class="home-section-header__rule" aria-hidden="true" />
        </div>
        <a
          href={createProjectRelativeUrl(homeNews.link_url)}
          data-astro-prefetch
          class={buttonVariants({ variant: 'ghost' })}
        >
          {homeNews.link_text}
        </a>
      </div>
      <div class="home-news-grid">
        {latestNewsArticles.map((newsArticle) => (
          <NewsCard item={newsArticle} />
        ))}
      </div>
    </section>
  )}

  {homeArtists && (
    <section class="artists-surface-section mt-20 border-t border-border py-20 sm:py-24" id="artists">
      <div class="layout-container">
        <div class="home-section-header home-section-header--centered mb-6 sm:mb-8">
          <span class="home-section-header__rule" aria-hidden="true" />
          <h2 class="home-section-header__title">{homeArtists.title}</h2>
          <span class="home-section-header__rule" aria-hidden="true" />
        </div>
        <div class="home-featured-roster-grid">
          {featuredArtistProfiles.map((artistProfile, index) => {
            const artistName = artistProfile.data.title || 'Artist';
            return (
              <div class="prose-link-card home-featured-roster-card group">
                <a
                  class="prose-card-link"
                  href={createProjectRelativeUrl(`/artists/${artistProfile.data.slug}/`)}
                  data-astro-prefetch
                >
                  <span class="sr-only">{artistName}</span>
                </a>
                <ArtistPrint
                  role="preview"
                  image={artistProfile.data.image}
                  alt={artistProfile.data.image_alt || artistName}
                  name={artistName}
                  tiltIndex={index}
                />
                <div class="home-featured-roster-card__label">
                  {artistProfile.data.genre && (
                    <p class="text-[11px] tracking-[0.18em] uppercase text-[#d0d0d0]">{artistProfile.data.genre}</p>
                  )}
                  <h3 class="brand-card-title text-foreground">{artistName.toUpperCase()}</h3>
                </div>
              </div>
            );
          })}
        </div>
        <div class="mt-8 text-center">
          <a
            href={createProjectRelativeUrl(homeArtists.button_link)}
            data-astro-prefetch
            class={buttonVariants({ variant: 'outline' })}
          >
            {homeArtists.button_text}
          </a>
        </div>
      </div>
    </section>
  )}

  <NewsletterSignup id="newsletter-signup-area" />
</SiteLayout>

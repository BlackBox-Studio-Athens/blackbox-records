---
import ArtistCard from '@/components/artists/ArtistCard.astro';
import HomeHero from '@/components/editorial/HomeHero.astro';
import NewsCard from '@/components/editorial/NewsCard.astro';
import StorePreorderShowcase from '@/components/store/StorePreorderShowcase';
import NewsletterSignup from '@/components/NewsletterSignup.astro';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { buttonVariants } from '@/components/ui/button';
import { SwipeRowDots } from '@/components/ui/swipe-row-dots';
import { createProjectRelativeUrl } from '@/platform/config/site';
import { listArtistRosterProfiles, listNewsArticles } from '@/lib/catalog-data';
import { getHomeContent, getLabelSettings } from '@/lib/site-data';
import { readOpenPreorders } from '@/lib/open-preorders';
import { preorderShowcaseItems } from './_preorder-showcase';
import heroFilmLandscapeUrl from './_assets/home-hero/home-hero-intro-landscape.mp4?url';
import heroFilmPortraitUrl from './_assets/home-hero/home-hero-intro-portrait.mp4?url';

const artistProfiles = await listArtistRosterProfiles();
const newsArticles = await listNewsArticles();
const latestNewsArticles = newsArticles.slice(0, 3);
const featuredArtistProfiles = artistProfiles.slice(0, 3);
const homeContent = await getHomeContent();
const labelSettings = await getLabelSettings();
const homeNews = homeContent.news;
const homeArtists = homeContent.artists;
// Pre-orders are in this HTML or absent; nothing is inserted after paint.
const videoTest = import.meta.env.SHOW_REVIEW_SITE_MARKER === 'true';
const preorderItems = videoTest
  ? (await import('./_preorder-video-test')).preorderVideoTestItems()
  : await preorderShowcaseItems(readOpenPreorders());
---

<SiteLayout
  mainClass="!pt-0"
  pageTitle={`Independent Record Label in ${labelSettings.location.locality}`}
  pageDescription={`${labelSettings.label_name} is an independent record label in ${labelSettings.location.locality}, ${labelSettings.location.country}. Discover our artists, releases, vinyl and CDs, news and services.`}
>
  {videoTest && <script is:inline>
    (() => {
      const mode = new URLSearchParams(location.search).get('scroll-check');
      const labels = {
        normal: 'Normal rendering',
        'no-video': 'Videos disabled',
        'no-ghost': 'Fixed background disabled',
        'no-timelines': 'Scroll animations disabled',
        report: 'Record normal scrolling',
      };
      if (!Object.hasOwn(labels, mode)) return;
      document.documentElement.dataset.homeScrollCheck = mode;
      if (mode === 'no-video') {
        if (navigator.connection) {
          // Exercise Home's existing data-saving media rules before its players start.
          Object.defineProperty(navigator.connection, 'saveData', { value: true, configurable: true });
          document.documentElement.removeAttribute('data-hero-film');
        } else labels[mode] = 'Video comparison unavailable in this browser';
      }
      if (mode === 'no-ghost') {
        const style = document.createElement('style');
        style.textContent = '.homepage-hero-section__media-layer { position: absolute !important; }';
        document.head.append(style);
      }
      if (mode === 'no-timelines') {
        const style = document.createElement('style');
        // Keep the existing coarse hero fade; isolate both native scroll timelines from normal rendering.
        style.textContent = `
          .homepage-hero-section__media-layer,
          .homepage-hero-section__media-layer::after,
          .home-swipe-row > * { animation: none !important; }
        `;
        document.head.append(style);
      }
      document.addEventListener(
        'DOMContentLoaded',
        () => {
          const note = document.querySelector('[data-home-scroll-check-note]');
          if (note) {
            note.hidden = false;
            note.textContent = `Scroll check: ${labels[mode]}.`;
          }
          if (mode !== 'report') return;
          const panel = document.querySelector('[data-home-scroll-report]');
          const button = panel.querySelector('button');
          const output = panel.querySelector('textarea');
          const status = panel.querySelector('[role="status"]');
          panel.hidden = false;
          let started = 0,
            visibleSince = 0,
            previous = 0,
            frame = 0,
            observer;
          let gesture, timer;
          const events = new AbortController();
          const timingType = ['long-animation-frame', 'longtask'].find((type) =>
            window.PerformanceObserver?.supportedEntryTypes?.includes(type),
          );
          const report = {
            version: 1,
            userAgent: navigator.userAgent,
            timingType: timingType ?? null,
            frameSamples: 0,
            maxFrameGapMs: 0,
            stallsOver250Ms: 0,
            scrollEvents: 0,
            minScrollY: scrollY,
            maxScrollY: scrollY,
            hiddenCount: 0,
            frameStalls: [],
            longFrames: [],
            gestures: [],
            resizes: [],
          };
          const boundedPush = (list, item) => {
            list.push(item);
            if (list.length > 24) list.shift();
          };
          const position = () => ({ y: Math.round(scrollY), height: innerHeight, width: innerWidth });
          const collectTimings = (entries) => {
            if (document.hidden) return;
            for (const entry of entries) {
              if (entry.startTime < visibleSince) continue;
              report.longFrames.push({
                atMs: Math.round(entry.startTime - started),
                durationMs: Math.round(entry.duration),
                blockingMs: entry.blockingDuration === undefined ? null : Math.round(entry.blockingDuration),
                styleLayoutMs: entry.styleAndLayoutStart
                  ? Math.round(entry.startTime + entry.duration - entry.styleAndLayoutStart)
                  : null,
                scripts: [...(entry.scripts ?? [])]
                  .sort((a, b) => b.duration - a.duration)
                  .slice(0, 3)
                  .map((script) => ({
                    file: (script.sourceURL?.split(/[?#]/)[0].split('/').pop() || '(inline)').slice(0, 160),
                    function: script.sourceFunctionName?.slice(0, 80),
                    position: script.sourceCharPosition,
                    durationMs: Math.round(script.duration),
                    forcedLayoutMs: Math.round(script.forcedStyleAndLayoutDuration),
                  })),
              });
            }
            report.longFrames.sort((a, b) => b.durationMs - a.durationMs);
            report.longFrames.length = Math.min(report.longFrames.length, 5);
          };
          const stop = () => {
            clearTimeout(timer);
            cancelAnimationFrame(frame);
            observer?.disconnect();
            events.abort();
          };
          const finish = () => {
            if (observer) collectTimings(observer.takeRecords());
            stop();
            report.durationMs = Math.round(performance.now() - started);
            report.end = position();
            report.videos = [...document.querySelectorAll('video')].map((video) => ({
              loaded: Boolean(video.getAttribute('src')),
              paused: video.paused,
              ready: video.readyState,
            }));
            output.value = JSON.stringify(report);
            output.hidden = false;
            button.disabled = true;
            status.textContent = 'Report ready. Select and copy the text below, then paste it into our chat.';
          };
          // shortcut: frame callbacks cannot prove compositor presentation; touch and scroll samples narrow that gap.
          const sample = (time) => {
            if (!panel.isConnected) return stop();
            if (!document.hidden) {
              if (previous) {
                const gap = Math.round(time - previous);
                report.frameSamples++;
                report.maxFrameGapMs = Math.max(report.maxFrameGapMs, gap);
                if (gap >= 250) {
                  report.stallsOver250Ms++;
                  boundedPush(report.frameStalls, {
                    atMs: Math.round(time - started),
                    gapMs: gap,
                    y: Math.round(scrollY),
                  });
                }
              }
              previous = time;
            }
            frame = requestAnimationFrame(sample);
          };
          const touch = (event) => {
            const point = event.touches[0] ?? event.changedTouches[0];
            if (!point || document.hidden) return;
            if (event.type === 'touchstart') {
              gesture = {
                atMs: Math.round(performance.now() - started),
                startY: Math.round(scrollY),
                target: event.target.tagName,
                moves: 0,
                dx: 0,
                dy: 0,
                maxEventDelayMs: 0,
                lastX: point.clientX,
                lastY: point.clientY,
              };
            } else if (gesture) {
              gesture.dx += Math.abs(point.clientX - gesture.lastX);
              gesture.dy += Math.abs(point.clientY - gesture.lastY);
              gesture.lastX = point.clientX;
              gesture.lastY = point.clientY;
              const delay = performance.now() - event.timeStamp;
              if (delay >= 0 && delay < 60000)
                gesture.maxEventDelayMs = Math.max(gesture.maxEventDelayMs, Math.round(delay));
              if (event.type === 'touchmove') gesture.moves++;
              else {
                const { lastX: _lastX, lastY: _lastY, ...finished } = gesture;
                boundedPush(report.gestures, {
                  ...finished,
                  end: event.type,
                  endY: Math.round(scrollY),
                  dx: Math.round(gesture.dx),
                  dy: Math.round(gesture.dy),
                });
                gesture = null;
              }
            }
          };
          window.addEventListener('pagehide', stop, { signal: events.signal });
          timer = setTimeout(() => {
            if (!panel.isConnected) return stop();
            started = visibleSince = performance.now();
            report.start = position();
            report.minScrollY = report.maxScrollY = Math.round(scrollY);
            button.disabled = false;
            status.textContent =
              'Recording. Scroll down and back until it freezes, then return here and finish. Stops after two minutes.';
            button.addEventListener('click', finish, { once: true, signal: events.signal });
            document.addEventListener(
              'visibilitychange',
              () => {
                if (document.hidden) report.hiddenCount++;
                previous = 0;
                gesture = null;
                visibleSince = performance.now();
              },
              { signal: events.signal },
            );
            for (const type of ['touchstart', 'touchmove', 'touchend', 'touchcancel']) {
              document.addEventListener(type, touch, { passive: true, signal: events.signal });
            }
            window.addEventListener(
              'scroll',
              () => {
                report.scrollEvents++;
                report.minScrollY = Math.min(report.minScrollY, Math.round(scrollY));
                report.maxScrollY = Math.max(report.maxScrollY, Math.round(scrollY));
              },
              { passive: true, signal: events.signal },
            );
            const resize = (event) =>
              boundedPush(report.resizes, {
                atMs: Math.round(performance.now() - started),
                source: event.currentTarget === window ? 'window' : 'visualViewport',
                ...position(),
                visualHeight: Math.round(window.visualViewport?.height ?? innerHeight),
              });
            window.addEventListener('resize', resize, { signal: events.signal });
            window.visualViewport?.addEventListener('resize', resize, { signal: events.signal });
            if (timingType) {
              observer = new PerformanceObserver((list) => collectTimings(list.getEntries()));
              observer.observe({ type: timingType });
            }
            frame = requestAnimationFrame(sample);
            timer = setTimeout(finish, 120000);
          }, 15000);
        },
        { once: true },
      );
    })();
  </script>}
  <HomeHero
    tagline={homeContent.hero.tagline}
    image={homeContent.hero.image}
    imageAlt={homeContent.hero.image_alt}
    film={{ portraitUrl: heroFilmPortraitUrl, landscapeUrl: heroFilmLandscapeUrl }}
  />

  {videoTest && (
    <p class="layout-container mt-6 text-sm" role="status">
      Video playback test. Sample pre-order details; purchase links open the UAT Store.
      <strong class="block" data-home-scroll-check-note hidden></strong>
    </p>
  )}
  {videoTest && (
    <section
      class="layout-container mt-4 mb-6 space-y-3 text-sm"
      data-home-scroll-report
      hidden
      aria-label="Scrolling report"
    >
      <p role="status">
        Wait 15 seconds. Then scroll down and back until the freeze happens. This report stays on this page until you
        copy it.
      </p>
      <button type="button" class={buttonVariants({ variant: 'inverse' })} disabled>
        Finish and show report
      </button>
      <textarea
        hidden
        readonly
        rows="8"
        spellcheck="false"
        aria-label="Scrolling report text"
        class="w-full border p-3 font-mono text-xs"
      />
    </section>
  )}
  {/* The shell already registers load; a cold shell entry may never have registered idle. */}
  {preorderItems.length > 0 && (
    <StorePreorderShowcase client:load items={preorderItems} storeUrl={createProjectRelativeUrl('/store/')} />
  )}

  {homeNews && latestNewsArticles.length > 0 && (
    <section class="home-news-section layout-container mt-16" id="news">
      <div class="home-section-header home-section-header--split mb-6 sm:mb-8">
        <div class="home-section-header__lead">
          <h2 class="home-section-header__title">{homeNews.title}</h2>
          <span class="home-section-header__rule" aria-hidden="true" />
        </div>
        <a
          href={createProjectRelativeUrl(homeNews.link_url)}
          data-astro-prefetch
          class={buttonVariants({ variant: 'inverse' })}
        >
          {homeNews.link_text}
        </a>
      </div>
      <div class="home-news-grid home-swipe-row" id="home-news-row">
        {latestNewsArticles.map((newsArticle) => (
          <NewsCard item={newsArticle} grid="home" />
        ))}
      </div>
      <SwipeRowDots
        client:load
        rowId="home-news-row"
        count={latestNewsArticles.length}
        label="News position"
        className="mt-3 sm:hidden"
      />
    </section>
  )}

  {homeArtists && (
    <section class="artists-surface-section mt-12 py-14 sm:mt-20 sm:py-24" id="artists">
      <div class="layout-container">
        <div class="home-section-header home-section-header--centered mb-6 sm:mb-8">
          <span class="home-section-header__rule" aria-hidden="true" />
          <h2 class="home-section-header__title">{homeArtists.title}</h2>
          <span class="home-section-header__rule" aria-hidden="true" />
        </div>
        <div class="home-featured-roster-grid home-swipe-row" id="home-artists-row">
          {featuredArtistProfiles.map((artistProfile) => (
            <ArtistCard artist={artistProfile} variant="featured-roster" />
          ))}
        </div>
        <SwipeRowDots
          client:load
          rowId="home-artists-row"
          count={featuredArtistProfiles.length}
          label="Artists position"
          className="mt-3 sm:hidden"
        />
        <div class="mt-8 text-center">
          <a
            href={createProjectRelativeUrl(homeArtists.button_link)}
            data-astro-prefetch
            class={buttonVariants({ variant: 'inverse' })}
          >
            {homeArtists.button_text}
          </a>
        </div>
      </div>
    </section>
  )}

  <NewsletterSignup id="newsletter-signup-area" />
</SiteLayout>

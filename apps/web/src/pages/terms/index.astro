---
import InternalPageHero from '@/components/InternalPageHero.astro';
import DeliveryRates from '@/components/store/checkout/DeliveryRates';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { createProjectRelativeUrl } from '@/platform/config/site';
import PurchaseDocument from '@/platform/components/PurchaseDocument';
import { getPurchaseInformation } from '@/platform/lib/purchase-information';

interface Props {
  information?: ReturnType<typeof getPurchaseInformation>;
}
const information = Astro.props.information === undefined ? getPurchaseInformation() : Astro.props.information;
---

<SiteLayout
  pageTitle="Purchase and delivery information"
  pageDescription="Delivery, returns and purchase help for BlackBox Records orders."
>
  <InternalPageHero sectionLabel="Store" title="Purchase and delivery information" />
  <section class="layout-container space-y-6 py-10" aria-label="Delivery information">
    <div class="max-w-2xl space-y-5 text-sm leading-7">
      <DeliveryRates />
      <p>
        <a
          class="inline-flex min-h-11 items-center underline underline-offset-4"
          href={createProjectRelativeUrl('/withdrawal/')}
        >
          Withdraw from an order
        </a>{' '}
        — submit an online declaration and receive a dated acknowledgement. You can also email{' '}
        <a class="underline" href="mailto:orders@blackboxrecordsathens.com">
          orders@blackboxrecordsathens.com
        </a>
        .
      </p>
      {information ? (
        <PurchaseDocument kind="terms" information={information} />
      ) : (
        <>
          <section id="delivery" class="scroll-mt-28 space-y-3">
            <h2 class="font-display text-3xl">Locker delivery</h2>
            <p>
              Delivery is to a BOX NOW locker in Greece, including supported island destinations, with no island
              surcharge. We arrange your locker with you before dispatch. A street address collected at payment does not
              mean home delivery.
            </p>
            <p>
              Delivery is charged by the total product quantity in your cart. We absorb packaging and carrier cost
              differences for accepted orders; there is no later delivery top-up.
            </p>
          </section>
          <section id="returns" class="scroll-mt-28 space-y-3">
            <h2 class="font-display text-3xl">Returns and refunds</h2>
            <p>
              For returns or a damaged item,{' '}
              <a class="underline" href="#support">
                contact BlackBox
              </a>
              .
            </p>
          </section>
          <section id="support" class="scroll-mt-28 space-y-3">
            <h2 class="font-display text-3xl">Purchase help</h2>
            <p>
              For delivery timing, locker arrangements, returns or a damaged item,
              <a class="underline" href={createProjectRelativeUrl('/about/')}>
                contact BlackBox
              </a>
              .
            </p>
          </section>
        </>
      )}
      <p>
        <a class="underline" href={createProjectRelativeUrl('/store/')}>
          Back to Store
        </a>
      </p>
    </div>
  </section>
</SiteLayout>

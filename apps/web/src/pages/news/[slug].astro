---
import NewsDetailContent from '@/components/editorial/NewsDetailContent.astro';
import { getEntry } from '@/lib/content-reader';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { createNewsDetailStaticPaths, type NewsArticleEntry } from '@/lib/catalog-data';

export async function getStaticPaths() {
  return createNewsDetailStaticPaths();
}

interface Props {
  item: NewsArticleEntry;
}

const item = Astro.props.item ?? (await getEntry('news', Astro.params.slug ?? ''));
if (!item) return new Response(null, { status: 404 }); // null body: Astro renders the 404 page
---

<SiteLayout pageTitle={item.data.title} pageDescription={item.data.summary} layoutType="news" pageDate={item.data.date}>
  <NewsDetailContent item={item} />
</SiteLayout>

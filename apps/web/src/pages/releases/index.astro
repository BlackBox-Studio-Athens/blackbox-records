---
import SiteLayout from '@/layouts/SiteLayout.astro';
import ReleaseCard from '@/components/editorial/ReleaseCard.astro';
import ReleaseCatalogPresentation from '@/components/editorial/ReleaseCatalogPresentation';
import { getReleaseCommerceLink } from '@/components/editorial/release-commerce';
import { listArtistProfiles, listReleaseCatalog, mapArtistProfilesById } from '@/lib/catalog-data';

const [artistProfiles, releaseCatalogEntries] = await Promise.all([listArtistProfiles(), listReleaseCatalog()]);
const artistProfileById = mapArtistProfilesById(artistProfiles);
const commerceLinks = await Promise.all(releaseCatalogEntries.map(getReleaseCommerceLink));
---

<SiteLayout pageTitle="Releases" pageDescription="Releases and label catalog.">
  <header class="layout-container releases-page-intro">
    <p class="releases-page-intro__eyebrow">Catalog</p>
    <h1 class="releases-page-intro__title internal-page-hero__title">Releases</h1>
  </header>
  {releaseCatalogEntries.length > 0 && (
    <div id="releases-merchandising" class="layout-container releases-page-showcase-container">
      <div class="releases-page-layout releases-page-layout--single-column" data-release-layout>
        <section class="releases-catalog-section" aria-labelledby="releases-catalog-heading" data-release-catalog>
          <h2 id="releases-catalog-heading" class="releases-catalog-section__heading">
            Our Releases
          </h2>
          <div class="releases-catalog-grid grid gap-5 md:grid-cols-2 xl:grid-cols-3" data-release-grid>
            {releaseCatalogEntries.map((releaseEntry, index) => (
              <ReleaseCard
                release={releaseEntry}
                artist={artistProfileById.get(releaseEntry.data.artist.id)}
                commerceLink={commerceLinks[index]}
                imageLoading={index === 0 ? 'eager' : 'lazy'}
                imagePriority={index === 0}
                variant="releases"
              />
            ))}
          </div>
        </section>
      </div>
      <ReleaseCatalogPresentation rootId="releases-merchandising" client:load />
    </div>
  )}
</SiteLayout>

<style is:global>
  #releases-merchandising [data-release-badges] {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
  }
  #releases-merchandising [data-release-badges]:empty {
    display: none;
  }
  #releases-merchandising [data-release-badges] :is(.store-item-card__release-status, .preorder-badge) {
    display: inline-block;
    align-self: flex-start;
    max-width: 100%;
    border: 0;
    padding: 0.35rem 0.5rem 0.3rem;
    background-color: color-mix(in oklch, var(--foreground) 8%, transparent);
    color: var(--foreground);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.4;
    white-space: normal;
    text-wrap: balance;
    overflow-wrap: break-word;
    text-transform: uppercase;
  }
  #releases-merchandising [data-release-badges] .preorder-badge {
    background-color: var(--preorder-accent-surface);
    color: var(--preorder-accent-active);
  }
  #releases-merchandising .release-card-artwork-link {
    display: block;
    color: inherit;
  }
  #releases-merchandising .release-card-artwork-link .release-card-artwork {
    transform: scale(1.026);
    transition: none;
  }
  #releases-merchandising .release-card-title-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklch, var(--foreground) 45%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }
  #releases-merchandising .release-card-title-link:focus-visible {
    color: var(--foreground);
    text-decoration-color: var(--foreground);
    outline: 2px solid var(--foreground);
    outline-offset: 4px;
  }
  #releases-merchandising .release-card-artwork-link:focus-visible {
    outline: 2px solid var(--foreground);
    outline-offset: -2px;
  }
  @media (hover: hover) {
    #releases-merchandising .release-card-artwork-link:hover:not(:focus-visible) {
      outline: 1px solid var(--foreground);
      outline-offset: -1px;
    }
    #releases-merchandising .release-card-title-link:hover {
      color: var(--foreground);
      text-decoration-color: var(--foreground);
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    #releases-merchandising .release-card-artwork-link .release-card-artwork {
      transition: transform 0.42s cubic-bezier(0.22, 1, 0.36, 1);
    }
    #releases-merchandising .release-card-artwork-link:is(:hover, :focus-visible) .release-card-artwork {
      transform: scale(1.048);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #releases-merchandising .release-card-artwork-link .release-card-artwork {
      transform: none;
    }
  }
  #releases-merchandising .releases-latest-feature__copy {
    container-type: inline-size;
  }
  #releases-merchandising .releases-latest-feature__title {
    font-size: clamp(2.35rem, 16cqi, 4.85rem);
  }
  @media (width < 64rem) {
    #releases-merchandising .releases-latest-feature__upcoming {
      display: flex;
      flex-wrap: wrap;
    }
    #releases-merchandising .releases-latest-feature__upcoming-artwork-link {
      flex: 0 1 8.5rem;
    }
    #releases-merchandising .releases-latest-feature__upcoming-copy {
      flex: 1 1 7rem;
      container-type: inline-size;
    }
    #releases-merchandising .releases-latest-feature__upcoming-title {
      font-size: min(17cqi, clamp(1.9rem, 8vw, 2.55rem));
    }
  }
</style>

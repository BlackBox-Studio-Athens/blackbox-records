---
import SiteLayout from '@/layouts/SiteLayout.astro';
import ReleaseCard from '@/components/editorial/ReleaseCard.astro';
import ReleaseCatalogPresentation from '@/components/editorial/ReleaseCatalogPresentation';
import { getReleaseCommerceLink } from '@/components/editorial/release-commerce';
import { listArtistProfiles, listReleaseCatalog, mapArtistProfilesById } from '@/lib/catalog-data';

const [artistProfiles, releaseCatalogEntries] = await Promise.all([listArtistProfiles(), listReleaseCatalog()]);
const artistProfileById = mapArtistProfilesById(artistProfiles);
const commerceLinks = await Promise.all(releaseCatalogEntries.map(getReleaseCommerceLink));
---

<SiteLayout pageTitle="Releases" pageDescription="Releases and label catalog.">
  <header class="layout-container releases-page-intro">
    <p class="releases-page-intro__eyebrow">Catalog</p>
    <h1 class="releases-page-intro__title internal-page-hero__title">Releases</h1>
  </header>
  {releaseCatalogEntries.length > 0 && (
    <div id="releases-merchandising" class="layout-container releases-page-showcase-container">
      <div class="releases-page-layout releases-page-layout--single-column" data-release-layout>
        <section class="releases-catalog-section" aria-labelledby="releases-catalog-heading" data-release-catalog>
          <h2 id="releases-catalog-heading" class="releases-catalog-section__heading">
            Our Releases
          </h2>
          <div class="releases-catalog-grid grid gap-5 md:grid-cols-2 xl:grid-cols-3" data-release-grid>
            {releaseCatalogEntries.map((releaseEntry, index) => (
              <ReleaseCard
                release={releaseEntry}
                artist={artistProfileById.get(releaseEntry.data.artist.id)}
                commerceLink={commerceLinks[index]}
                imageLoading={index === 0 ? 'eager' : 'lazy'}
                imagePriority={index === 0}
                variant="releases"
              />
            ))}
          </div>
        </section>
      </div>
      <ReleaseCatalogPresentation rootId="releases-merchandising" client:load />
    </div>
  )}
</SiteLayout>

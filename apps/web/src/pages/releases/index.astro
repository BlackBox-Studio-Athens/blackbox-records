---
import SiteLayout from '@/layouts/SiteLayout.astro';
import ReleaseCard from '@/components/editorial/ReleaseCard.astro';
import ReleaseCatalogPresentation, {
  selectReleaseMerchandisingEntries,
} from '@/components/editorial/ReleaseCatalogPresentation';
import { getReleaseCommerceLink, getReleasePresentationEntry } from '@/components/editorial/release-commerce';
import { listArtistProfiles, listReleaseCatalog, mapArtistProfilesById } from '@/lib/catalog-data';
import ReleaseShowLine from '@/components/shows/ReleaseShowLine.astro';
import { getUpcomingLiveShow } from '@/lib/live-show';

const [artistProfiles, releaseCatalogEntries] = await Promise.all([listArtistProfiles(), listReleaseCatalog()]);
const artistProfileById = mapArtistProfilesById(artistProfiles);
const upcomingShow = await getUpcomingLiveShow();
const showReleaseIds = new Set(upcomingShow?.headliners.map((act) => act.releaseId).filter(Boolean));
const commerceLinks = await Promise.all(releaseCatalogEntries.map(getReleaseCommerceLink));
const { principal, remainder } = selectReleaseMerchandisingEntries(
  releaseCatalogEntries.map((release, index) => ({
    ...getReleasePresentationEntry(release, commerceLinks[index]),
    release,
    commerceLink: commerceLinks[index],
  })),
);
---

<SiteLayout pageTitle="Releases" pageDescription="Releases and label catalog.">
  <h1 class="sr-only">Releases</h1>
  {releaseCatalogEntries.length > 0 && (
    <div id="releases-merchandising" class="layout-container releases-page-showcase-container">
      <div class="releases-page-layout" data-release-layout>
        {principal.map(({ release, commerceLink }, index) => (
          <ReleaseCard
            release={release}
            artist={artistProfileById.get(release.data.artist.id)}
            commerceLink={commerceLink}
            imageLoading={index === 0 ? 'eager' : 'lazy'}
            imagePriority={index === 0}
            variant="releases"
            role={index === 0 ? 'lead' : 'supporting'}
          >
            {upcomingShow && showReleaseIds.has(release.id) && (
              <ReleaseShowLine slot="after-summary" show={upcomingShow} />
            )}
          </ReleaseCard>
        ))}
        <section
          class="releases-catalog-section"
          aria-labelledby="releases-catalog-heading"
          data-release-catalog
          hidden={remainder.length === 0}
        >
          <h2 id="releases-catalog-heading" class="sr-only">
            More releases
          </h2>
          <div class="releases-catalog-grid grid sm:grid-cols-2 lg:grid-cols-3" data-release-grid>
            {remainder.map(({ release, commerceLink }) => (
              <ReleaseCard
                release={release}
                artist={artistProfileById.get(release.data.artist.id)}
                commerceLink={commerceLink}
                variant="releases"
              >
                {upcomingShow && showReleaseIds.has(release.id) && (
                  <ReleaseShowLine slot="after-summary" show={upcomingShow} />
                )}
              </ReleaseCard>
            ))}
          </div>
        </section>
      </div>
      <ReleaseCatalogPresentation rootId="releases-merchandising" client:load />
    </div>
  )}
</SiteLayout>

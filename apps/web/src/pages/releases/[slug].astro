---
import { tracklistGroups } from '@blackbox/content-model';
import ReleaseDetailContent from '@/components/editorial/ReleaseDetailContent.astro';
import { getEntry } from '@/lib/content-reader';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { getLabelSettings } from '@/lib/site-data';
import { createAbsoluteSiteUrl, createCanonicalUrl, createProjectRelativeUrl } from '@/platform/config/site';
import { createMusicPageMetadata } from '@/pages/_metadata';
import { createMusicAlbumStructuredData } from '@/platform/lib/structured-data';
import {
  createReleaseDetailStaticPaths,
  resolveArtistProfileForRelease,
  resolveReleaseArtistDisplayName,
  type ReleaseCatalogEntry,
} from '@/lib/catalog-data';

export async function getStaticPaths() {
  return createReleaseDetailStaticPaths();
}

interface Props {
  release: ReleaseCatalogEntry;
}

const release = Astro.props.release ?? (await getEntry('releases', Astro.params.slug ?? ''));
if (!release) return new Response(null, { status: 404 }); // null body: Astro renders the 404 page
const releaseArtist = await resolveArtistProfileForRelease(release);
const artistName = resolveReleaseArtistDisplayName(release, releaseArtist);
const metadata = createMusicPageMetadata({
  title: release.data.title,
  artist: artistName,
  summary: release.data.summary,
  intent: 'release',
});
const album = createMusicAlbumStructuredData({
  name: release.data.title,
  url: createCanonicalUrl(Astro.url, Astro.site),
  image: new URL(release.data.cover_image.src, Astro.site ?? Astro.url).href,
  label: (await getLabelSettings()).label_name,
  labelUrl: createAbsoluteSiteUrl('/'),
  artist: {
    name: artistName,
    url: releaseArtist
      ? new URL(createProjectRelativeUrl(`/artists/${releaseArtist.data.slug}/`), Astro.site ?? Astro.url).href
      : undefined,
  },
  releaseDate: release.data.release_date,
  tracks: tracklistGroups(release.data.tracklist, release.data.tracklist?.format).flatMap((group) => group.tracks),
});
---

<SiteLayout
  pageTitle={metadata.title}
  pageDescription={metadata.description}
  structuredData={album}
  breadcrumbs={[
    { name: 'Home', url: createAbsoluteSiteUrl('/') },
    { name: 'Releases', url: createAbsoluteSiteUrl('/releases/') },
    { name: release.data.title, url: createCanonicalUrl(Astro.url, Astro.site) },
  ]}
>
  <ReleaseDetailContent release={release} />
</SiteLayout>

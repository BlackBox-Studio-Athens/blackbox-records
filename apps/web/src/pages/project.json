{
  "name": "web-pages",
  "tags": ["application", "scope:web"],
  "implicitDependencies": [
    "checkout-web",
    "player",
    "store-cart",
    "storefront-catalog",
    "ui-foundation",
    "web-artists",
    "web-editorial",
    "web-layouts",
    "web-platform",
    "web-store"
  ],
  "targets": {
    "test": {
      "command": "pnpm --filter @blackbox/web exec vitest run --config vitest.modules.config.ts --project=web-pages",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/apps/web/vitest*.ts",
        "{workspaceRoot}/apps/web/src/content/**/*",
        "{workspaceRoot}/apps/web/public/**/*"
      ]
    }
  },
  "metadata": {
    "boundaries": {
      "status": "closed",
      "exports": [],
      "namedInterfaces": {},
      "dependsOn": [
        "app-shell",
        "player",
        "ui-foundation",
        "storefront-catalog",
        "web-content-files",
        "web-editorial",
        "store-cart",
        "checkout-web",
        "web-platform",
        "web-layouts",
        "web-artists",
        "web-store"
      ],
      "workspaceInterfaces": {
        "@blackbox/content-model": ["."],
        "@blackbox/api-client": ["./public"]
      }
    }
  }
}

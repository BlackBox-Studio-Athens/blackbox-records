---
import Prose from '@/components/Prose.astro';
import { Image } from 'astro:assets';
import { buttonVariants } from '@/components/ui/button';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { resolveLinkAttributes } from '@/platform/config/site';
import { getServicesContent } from '@/lib/site-data';
import { editorialImageQuality, largestImageWidth } from '@/platform/lib/editorial-image';

const servicesContent = await getServicesContent();
const serviceImageWidths = [360, 720, 1080];
// Tile width in .layout-container: one column, then three 1.5rem-gapped columns from 48rem, capped at 72rem.
const serviceImageSizes =
  '(min-width: 72rem) 21.75rem, (min-width: 64rem) calc((100vw - 7rem) / 3), (min-width: 48rem) calc((100vw - 6rem) / 3), (min-width: 40rem) calc(100vw - 3rem), calc(100vw - 2rem)';
const { services: servicesListSection, process: processSection, inquiry: inquirySection } = servicesContent;
const stepIndex = (index: number) => String(index + 1).padStart(2, '0');
---

<SiteLayout
  pageTitle="Services"
  pageDescription="Share your demo, book tours, print merch, and press vinyl with BlackBox."
>
  <div data-tone="services">
    <section class="layout-container services-page-intro">
      <p class="services-page-intro__eyebrow">What We Do</p>
      <h1 class="services-page-intro__title internal-page-hero__title">{servicesContent.hero.title}</h1>
      <Prose class="services-page-intro__copy" value={servicesContent.hero.intro} data-content-path="hero.intro" />
      <a
        href="#services-inquiry"
        data-services-inquiry-target-service="General"
        data-scroll-to-target="services-inquiry"
        class={buttonVariants({ size: 'lg' })}
      >
        {servicesContent.hero.cta_text}
      </a>
    </section>

    {servicesListSection && (
      <section class="layout-container services-tiles" aria-label="Services">
        {servicesListSection.items.map((service, index) => {
          const partnerLinkAttributes = service.partner_url ? resolveLinkAttributes(service.partner_url) : null;

          return (
            <article class="services-tile" id={service.id}>
              <Image
                src={service.image}
                alt={service.image_alt}
                class="services-tile__image"
                widths={serviceImageWidths}
                width={largestImageWidth(service.image, serviceImageWidths)}
                sizes={serviceImageSizes}
                quality={editorialImageQuality}
                priority={index === 0}
              />
              <div class="services-tile__body">
                <p class="services-tile__index" aria-hidden="true">
                  {stepIndex(index)}
                </p>
                <h2 class="brand-card-title">{service.title}</h2>
                <div class="services-tile__summary">
                  <Prose value={service.summary} />
                  {service.partner_name && partnerLinkAttributes && (
                    <>
                      In partnership with{' '}
                      <a
                        class="services-inline-link"
                        href={partnerLinkAttributes.href}
                        rel={partnerLinkAttributes.rel}
                        target={partnerLinkAttributes.target}
                      >
                        {service.partner_name}
                      </a>
                      .
                    </>
                  )}
                </div>
                <ul class="services-tile__bullets">
                  {service.bullets.map((bullet) => (
                    <li>
                      <Prose value={bullet} />
                    </li>
                  ))}
                </ul>
                <Prose class="services-tile__note" value={service.contact_note} />
                <a
                  href="#services-inquiry"
                  data-services-inquiry-target-service={service.title}
                  data-scroll-to-target="services-inquiry"
                  class="services-inline-link services-tile__action"
                >
                  Ask about {service.title}
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          );
        })}
      </section>
    )}

    {inquirySection && (
      <section class="services-demos" aria-labelledby="services-demos-title">
        <div class="layout-container services-demos__inner">
          <div class="services-demos__text">
            <h2 class="services-section-title" id="services-demos-title">
              Demos
            </h2>
            <p class="services-copy">For demos, send a listening link and a few words about your band or project.</p>
          </div>
          <a
            href="#services-inquiry"
            data-services-inquiry-target-service="Share your demo"
            data-scroll-to-target="services-inquiry"
            class={buttonVariants({ variant: 'outline', size: 'lg' })}
          >
            Share your demo
          </a>
        </div>
      </section>
    )}

    {processSection && (
      <section class="layout-container services-process" aria-labelledby="services-process-title">
        <div class="services-process__header">
          <h2 class="services-section-title" id="services-process-title">
            {processSection.title}
          </h2>
          <Prose class="services-copy" value={processSection.intro} data-content-path="process.intro" />
        </div>
        <ol class="services-process__steps">
          {processSection.steps.map((step, index) => (
            <li class="services-process__step">
              <span class="services-process__index" aria-hidden="true">
                {stepIndex(index)}
              </span>
              <h3 class="services-process__title">{step.title}</h3>
              <Prose class="services-copy" value={step.body} />
            </li>
          ))}
        </ol>
      </section>
    )}

    {inquirySection && (
      <section class="layout-container services-inquiry" id="services-inquiry" aria-labelledby="services-inquiry-title">
        <div class="services-inquiry__header">
          <h2 class="services-section-title" id="services-inquiry-title">
            {inquirySection.title}
          </h2>
          <Prose class="services-copy" value={inquirySection.intro} data-content-path="inquiry.intro" />
        </div>
        <div data-services-inquiry-form />
      </section>
    )}
  </div>
</SiteLayout>

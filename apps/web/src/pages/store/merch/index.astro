---
import StoreCollectionPage from '@/layouts/StoreCollectionPage.astro';
import { createProjectRelativeUrl } from '@/platform/config/site';
import RedirectLayout from '@/layouts/RedirectLayout.astro';
import { getDiscoverableStoreCatalogCategories, getStoreCatalogCategory } from '@/lib/store-categories';
import { listStoreCollectionEntries, selectStoreCollectionEntries } from '@/lib/store-collection';

const allEntries = await listStoreCollectionEntries();
const collectionEntries = selectStoreCollectionEntries(allEntries, 'merch');
const discoverableCategories = getDiscoverableStoreCatalogCategories(allEntries.flatMap((entry) => entry.categoryIds));
const redirectUrl = createProjectRelativeUrl('/store/');
---

{collectionEntries.length === 0 ? (
  <RedirectLayout
    pageTitle="Merch"
    pageDescription="No BlackBox Records merch is currently available."
    redirectUrl={redirectUrl}
  >
    <p class="text-sm leading-relaxed text-muted-foreground">
      No merch is currently available.{' '}
      <a class="underline underline-offset-4" href={redirectUrl}>
        Browse Store
      </a>
      .
    </p>
  </RedirectLayout>
) : (
  <StoreCollectionPage
    category={getStoreCatalogCategory('merch')}
    entries={collectionEntries}
    discoverableCategories={discoverableCategories}
  />
)}

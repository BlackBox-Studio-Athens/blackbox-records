---
import { tracklistGroups } from '@blackbox/content-model';
import EditorialContent from '@/components/detail/EditorialContent.astro';
import { formatDayMonthYear } from '@/utils/content';
import Prose from '@/components/Prose.astro';
import { Image } from 'astro:assets';
import { getEntry } from '@/lib/content-reader';

import MusicStreamingServiceListenTrigger from '@/components/music/MusicStreamingServiceListenTrigger.astro';
import StoreOfferPriceDisplay from '@/components/store/StoreOfferPriceDisplay';
import StoreItemPurchaseActions from '@/components/store/StoreItemPurchaseActions';
import PurchaseInformation from '@/components/PurchaseInformation';
import { createProjectRelativeUrl } from '@/config/site';
import SiteLayout from '@/layouts/SiteLayout.astro';
import {
  createReleaseDetailPath,
  resolveArtistProfileForRelease,
  resolveReleaseArtistDisplayName,
} from '@/lib/catalog-data';
import { getStorePageEntryBySlug } from '@/lib/store-page-data';
import {
  createCartLineItemSnapshotForStorePage,
  createPricedCartSeedForStorePage,
  type StorePageEntry,
  createStorePageStaticPaths,
} from '@/lib/store-page-data';

export async function getStaticPaths() {
  return createStorePageStaticPaths();
}

interface Props {
  entry: StorePageEntry;
}

const entry = Astro.props.entry ?? (await getStorePageEntryBySlug(Astro.params.slug ?? ''));
if (!entry) return new Response('Not found', { status: 404 });
const { storeItem, primaryAvailability } = entry;
const cartItem = createCartLineItemSnapshotForStorePage(storeItem, primaryAvailability, storeItem.image.src);
const cartSeed = createPricedCartSeedForStorePage(storeItem, primaryAvailability, storeItem.image.src);
const sourceRelease = storeItem.sourceKind === 'release' ? await getEntry('releases', storeItem.sourceId) : null;

if (storeItem.sourceKind === 'release' && !sourceRelease) {
  throw new Error(`Missing Release source entry for Store Item ${storeItem.slug}: ${storeItem.sourceId}.`);
}

const sourceReleaseArtist = sourceRelease ? await resolveArtistProfileForRelease(sourceRelease) : undefined;
const sourceReleaseArtistName = sourceRelease
  ? resolveReleaseArtistDisplayName(sourceRelease, sourceReleaseArtist)
  : undefined;
const embeddedPlayerData = storeItem.embeddedPlayerData;
const sourceReleaseUrl = sourceRelease ? createReleaseDetailPath(sourceRelease) : null;
const sourceReleaseArtistUrl = sourceReleaseArtist
  ? createProjectRelativeUrl(`/artists/${sourceReleaseArtist.data.slug}/`)
  : null;
const distroSource = storeItem.sourceKind === 'distro' ? await getEntry('distro', storeItem.sourceId) : null;

if (storeItem.sourceKind === 'distro' && !distroSource) {
  throw new Error(`Missing Distro source entry for Store Item ${storeItem.slug}: ${storeItem.sourceId}.`);
}

const gallery = distroSource?.data.gallery ?? [];
const trackGroups = tracklistGroups(
  sourceRelease?.data.tracklist ?? distroSource?.data.tracklist,
  primaryAvailability?.optionLabel || distroSource?.data.format || distroSource?.data.group,
);
const hasBody =
  sourceRelease &&
  (sourceRelease.data.editorial_body
    ? sourceRelease.data.editorial_body.length > 0
    : Boolean(sourceRelease.body?.trim()));
const releaseDate = sourceRelease?.data.release_date ?? distroSource?.data.release_date;
const credits = sourceRelease?.data.credits ?? [];
const hasInfo = storeItem.summary || hasBody || releaseDate || credits.length > 0;
---

<SiteLayout
  mainClass="store-item-page"
  pageTitle={`${storeItem.title} | Store`}
  pageDescription={storeItem.summary || `${storeItem.title} available through the BlackBox native storefront.`}
>
  <section class="layout-container pt-6 pb-6">
    <a
      href={createProjectRelativeUrl('/store/')}
      data-astro-prefetch
      class="mb-5 inline-flex min-h-11 items-center text-xs text-muted-foreground underline underline-offset-4 hover:text-foreground"
      >Back to Store</a
    >
    <div class="store-item-composition">
      <div class="store-item-purchase" data-store-purchase-group>
        <div class="store-item-identity">
          <h1 class="brand-display-title break-words text-foreground">{storeItem.title}</h1>
          <p class="text-sm uppercase tracking-[0.13em] text-muted-foreground">{storeItem.subtitle}</p>
          {
            primaryAvailability?.optionLabel && (
              <p class="text-sm font-semibold text-foreground" data-store-item-option>
                {primaryAvailability.optionLabel}
              </p>
            )
          }
          {
            (embeddedPlayerData || sourceReleaseUrl || sourceReleaseArtistUrl) && (
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2 pt-1" data-store-item-listening-context>
                {embeddedPlayerData && (
                  <MusicStreamingServiceListenTrigger
                    embeddedPlayerData={embeddedPlayerData}
                    includeCardAttribute
                    tone="accent"
                    variant="standalone"
                  />
                )}
                <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs uppercase tracking-[0.12em] text-muted-foreground">
                  {sourceReleaseUrl && (
                    <a
                      href={sourceReleaseUrl}
                      data-astro-prefetch
                      class="underline decoration-border underline-offset-4 transition-colors hover:text-foreground"
                    >
                      Release
                    </a>
                  )}
                  {sourceReleaseArtistUrl && (
                    <a
                      href={sourceReleaseArtistUrl}
                      data-astro-prefetch
                      class="underline decoration-border underline-offset-4 transition-colors hover:text-foreground"
                    >
                      {sourceReleaseArtistName}
                    </a>
                  )}
                </div>
              </div>
            )
          }
        </div>
        <StoreOfferPriceDisplay
          client:load
          storeItemSlug={storeItem.slug}
          className="block font-display text-3xl tracking-[0.08em] uppercase text-foreground"
        />
        <StoreItemPurchaseActions client:load cartItem={cartItem} cartSeed={cartSeed} />
        {
          primaryAvailability?.canBuy && (
            <p class="text-sm leading-relaxed text-muted-foreground">
              Add it to the cart to review this item before checkout.
            </p>
          )
        }
        <PurchaseInformation />
      </div>
      <div class="store-item-artwork">
        <Image
          src={storeItem.image}
          alt={storeItem.imageAlt}
          class="store-item-detail__image aspect-square h-auto w-full object-contain"
          priority
          widths={[720, 1080, 1440, 1800]}
          sizes="(min-width: 768px) 26rem, calc(100vw - 32px)"
        />
      </div>
    </div>
    <div class="store-item-information">
      {
        hasInfo && (
          <section aria-labelledby="store-item-info" data-store-item-description>
            <h2 id="store-item-info">Info</h2>
            {storeItem.summary && (
              <Prose value={storeItem.summary} rich={storeItem.summaryRich} data-content-path="summary" />
            )}
            {hasBody && sourceRelease && (
              <div class="prose">
                <EditorialContent entry={sourceRelease} />
              </div>
            )}
            {(releaseDate || credits.length > 0) && (
              <dl class="store-item-facts">
                {releaseDate && (
                  <div>
                    <dt>Release date</dt>
                    <dd>{formatDayMonthYear(releaseDate)}</dd>
                  </div>
                )}
                {credits.map((credit) => (
                  <div>
                    <dt>{credit.role}</dt>
                    <dd>{credit.name}</dd>
                  </div>
                ))}
              </dl>
            )}
          </section>
        )
      }
      {
        trackGroups.length > 0 && (
          <section aria-labelledby="store-item-tracklist" data-content-path="tracklist">
            <h2 id="store-item-tracklist">Tracklist</h2>
            {trackGroups.map((group) => (
              <div class="store-track-group">
                {group.heading && <h3>{group.heading}</h3>}
                <ol role="list" class="store-item-tracklist">
                  {group.tracks.map((track) => (
                    <li>
                      <span class="store-track-position">{track.position}</span>
                      <span>{track.title}</span>
                      {track.duration && <span class="store-track-duration">{track.duration}</span>}
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </section>
        )
      }
    </div>
  </section>

  {
    gallery.length > 0 && (
      <section class="layout-container pb-14 pt-6" aria-labelledby="store-item-more-views">
        <h2
          id="store-item-more-views"
          class="mb-5 text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground"
        >
          More views
        </h2>
        <div class="grid items-start gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {gallery.map(({ image, image_alt }) => (
            <div class="overflow-hidden border border-border/60 bg-background/55">
              <Image
                src={image}
                alt={image_alt}
                loading="lazy"
                widths={[480, 720, 960, 1200]}
                sizes="(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw"
                class="h-auto w-full"
              />
            </div>
          ))}
        </div>
      </section>
    )
  }
</SiteLayout>

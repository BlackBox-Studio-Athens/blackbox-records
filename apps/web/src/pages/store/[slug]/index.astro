---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';

import StoreOfferPriceDisplay from '@/components/store/StoreOfferPriceDisplay';
import StoreItemPurchaseActions from '@/components/store/StoreItemPurchaseActions';
import PurchaseInformation from '@/components/PurchaseInformation';
import { createProjectRelativeUrl } from '@/config/site';
import SiteLayout from '@/layouts/SiteLayout.astro';
import {
  createCartLineItemSnapshotForStorePage,
  createPricedCartSeedForStorePage,
  type StorePageEntry,
  createStorePageStaticPaths,
} from '@/lib/store-page-data';

export async function getStaticPaths() {
  return createStorePageStaticPaths();
}

interface Props {
  entry: StorePageEntry;
}

const { entry } = Astro.props;
const { storeItem, primaryAvailability } = entry;
const metadataLabel = storeItem.metadata.join(' · ');
const cartItem = createCartLineItemSnapshotForStorePage(storeItem, primaryAvailability, storeItem.image.src);
const cartSeed = createPricedCartSeedForStorePage(storeItem, primaryAvailability, storeItem.image.src);
const distroSource = storeItem.sourceKind === 'distro' ? await getEntry('distro', storeItem.sourceId) : null;

if (storeItem.sourceKind === 'distro' && !distroSource) {
  throw new Error(`Missing Distro source entry for Store Item ${storeItem.slug}: ${storeItem.sourceId}.`);
}

const gallery = distroSource?.data.gallery ?? [];
const isDistroCd = distroSource?.data.group === 'CDs';
---

<SiteLayout
  pageTitle={`${storeItem.title} | Store`}
  pageDescription={storeItem.summary || `${storeItem.title} available through the BlackBox native storefront.`}
>
  <section class="layout-container pt-14 pb-6">
    <a
      href={createProjectRelativeUrl('/store/')}
      data-astro-prefetch
      class="mb-5 inline-flex min-h-11 items-center text-xs text-muted-foreground underline underline-offset-4 hover:text-foreground"
      >Back to Store</a
    >
    <div class="grid items-start gap-8 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="min-w-0 space-y-5 lg:col-start-2 lg:row-start-1" data-store-purchase-group>
        <div class="space-y-3">
          <h1 class="brand-display-title break-words text-foreground">{storeItem.title}</h1>
          <p class="text-sm uppercase tracking-[0.13em] text-muted-foreground">{storeItem.subtitle}</p>
          {
            primaryAvailability?.optionLabel && (
              <p class="text-sm font-semibold text-foreground" data-store-item-option>
                {primaryAvailability.optionLabel}
              </p>
            )
          }
        </div>
        <StoreOfferPriceDisplay
          client:load
          storeItemSlug={storeItem.slug}
          className="block font-display text-3xl tracking-[0.08em] uppercase text-foreground"
        />
        <StoreItemPurchaseActions client:load cartItem={cartItem} cartSeed={cartSeed} />
        {
          primaryAvailability?.canBuy && (
            <p class="text-sm leading-relaxed text-muted-foreground">
              Add it to the cart to review this item before checkout.
            </p>
          )
        }
        <PurchaseInformation />
      </div>
      <div class="min-w-0 overflow-hidden border border-border/60 bg-background/55 lg:col-start-1 lg:row-start-1">
        <Image
          src={storeItem.image}
          alt={storeItem.imageAlt}
          class:list={[
            'store-item-detail__image w-full',
            isDistroCd ? 'aspect-square h-auto object-contain' : 'aspect-[4/5] h-auto object-cover',
          ]}
          data-store-cd-image={isDistroCd ? '' : undefined}
          priority
          widths={[720, 1080, 1440, 1800]}
          sizes="(min-width: 1024px) 40vw, 100vw"
        />
      </div>
    </div>
    <div class="max-w-[70ch] space-y-4 pt-8 text-sm leading-7 text-muted-foreground" data-store-item-description>
      {
        metadataLabel && (
          <p>
            <span class="font-semibold">
              {storeItem.sourceKind === 'release' ? 'Release details' : 'Item details'}:{' '}
            </span>
            {metadataLabel}
          </p>
        )
      }
      {storeItem.summary && <p class="max-w-2xl text-sm leading-relaxed text-muted-foreground">{storeItem.summary}</p>}
    </div>
  </section>

  {
    gallery.length > 0 && (
      <section class="layout-container pb-14 pt-6" aria-labelledby="store-item-more-views">
        <h2
          id="store-item-more-views"
          class="mb-5 text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground"
        >
          More views
        </h2>
        <div class="grid items-start gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {gallery.map(({ image, image_alt }) => (
            <div class="overflow-hidden border border-border/60 bg-background/55">
              <Image
                src={image}
                alt={image_alt}
                loading="lazy"
                widths={[480, 720, 960, 1200]}
                sizes="(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw"
                class="h-auto w-full"
              />
            </div>
          ))}
        </div>
      </section>
    )
  }
</SiteLayout>

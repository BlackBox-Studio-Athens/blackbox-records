---
import CheckoutOrderSummary from '@/components/store/checkout/CheckoutOrderSummary';
import CheckoutOfferStatus from '@/components/store/checkout/CheckoutOfferStatus';
import StoreItemPurchaseActions from '@/components/store/checkout/StoreItemPurchaseActions';
import StoreOfferPriceDisplay, { STORE_OFFER_PRICE_DISPLAY_COPY } from '@/components/store/StoreOfferPriceDisplay';
import { createProjectRelativeUrl } from '@/platform/config/site';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { getStorePageEntryBySlug } from '@/components/store/store-page-data';
import {
  createPricedCartSeedForStorePage,
  type StorePageEntry,
  createStorePageStaticPaths,
} from '@/components/store/store-page-data';

export async function getStaticPaths() {
  return createStorePageStaticPaths();
}

interface Props {
  entry: StorePageEntry;
}

const entry = Astro.props.entry ?? (await getStorePageEntryBySlug(Astro.params.slug ?? ''));
if (!entry) return new Response('Not found', { status: 404 });
const { storeItem, primaryAvailability } = entry;
const priceLabel = STORE_OFFER_PRICE_DISPLAY_COPY.loading;
const availabilityLabel = primaryAvailability?.availability.label || 'Unavailable';
const canBuy = primaryAvailability?.canBuy ?? false;
const fallbackCartSeed = createPricedCartSeedForStorePage(storeItem, primaryAvailability, storeItem.image.src);
const initialCheckoutAvailability = {
  canBuy: true,
  label: 'Cart checkout',
  optionLabel: null,
  priceDisplay: priceLabel,
};
const summaryItem = {
  availabilityLabel,
  canBuy,
  image: storeItem.image.src,
  imageAlt: storeItem.imageAlt,
  itemHref: storeItem.storePath,
  optionLabel: primaryAvailability?.optionLabel ?? null,
  priceDisplay: priceLabel,
  storeItemSlug: storeItem.slug,
  subtitle: storeItem.subtitle,
  title: storeItem.title,
  variantId: primaryAvailability?.variantId ?? '',
};
---

<SiteLayout
  pageTitle={`${storeItem.title} Checkout Compatibility | Store`}
  pageDescription={`Compatibility checkout entry for ${storeItem.title} by ${storeItem.subtitle}.`}
  robots="noindex"
>
  <section class="layout-container pt-8 pb-8">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <h1 class="font-display text-4xl tracking-[0.08em] uppercase text-foreground">Checkout</h1>
      <a
        href={createProjectRelativeUrl('/store/')}
        data-astro-prefetch
        class="text-[11px] font-semibold uppercase tracking-[0.18em] text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline"
      >
        Continue Shopping
      </a>
    </div>

    <div class="grid min-w-0 grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_24rem] xl:grid-cols-[minmax(40rem,1fr)_27rem]">
      <div class="min-w-0 lg:hidden">
        <details class="group min-w-0 border border-border/70 bg-card/45" open>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-4 text-[11px] font-semibold uppercase tracking-[0.18em] text-foreground marker:hidden sm:px-5">
            <span class="min-w-0">Order Summary</span>
            <StoreOfferPriceDisplay
              client:load
              storeItemSlug={storeItem.slug}
              className="min-w-0 text-right font-display text-xl tracking-[0.08em] sm:text-2xl"
            />
          </summary>
          <div class="min-w-0 border-t border-border/70 p-3 sm:p-4">
            <CheckoutOrderSummary client:load {...summaryItem} />
          </div>
        </details>
      </div>

      <div class="grid min-w-0 gap-4">
        <CheckoutOfferStatus
          client:load
          initialAvailability={initialCheckoutAvailability}
          showReviewSiteMarker={import.meta.env.SHOW_REVIEW_SITE_MARKER === 'true'}
        />

        <div class="grid gap-3 border border-border/70 bg-background/55 p-4">
          <StoreItemPurchaseActions
            client:load
            cartItem={null}
            cartSeed={fallbackCartSeed}
            purchaseHint="Recover this item by adding it to the cart, then continue through cart checkout."
          />
        </div>
      </div>

      <aside class="hidden lg:block">
        <div class="sticky top-[calc(var(--header-height)+2rem)]">
          <CheckoutOrderSummary client:load {...summaryItem} />
        </div>
      </aside>
    </div>
  </section>
</SiteLayout>

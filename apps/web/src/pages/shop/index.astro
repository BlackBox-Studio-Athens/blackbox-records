---
import { buttonVariants } from '@/components/ui/button';
import RedirectLayout from '@/layouts/RedirectLayout.astro';
import { createProjectRelativeUrl } from '@/platform/config/site';

const redirectUrl = createProjectRelativeUrl('/store/');
---

<RedirectLayout pageTitle="Store" pageDescription="Continue to the BlackBox Records store." redirectUrl={redirectUrl}>
  <p class="font-display text-4xl tracking-[0.08em] uppercase text-foreground">Redirecting to store...</p>
  <p class="mt-3 text-sm uppercase tracking-[0.12em] text-muted-foreground">
    The native store now lives at <span class="text-foreground">/store/</span>.
  </p>
  <p class="mt-6">
    <a href={redirectUrl} class={buttonVariants()}>
      Continue
    </a>
  </p>
</RedirectLayout>

{
  "name": "@blackbox/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean:dev-cache": "node -e \"const fs=require('node:fs');for (const p of ['.astro','node_modules/.astro','node_modules/.vite']) fs.rmSync(p,{recursive:true,force:true});\"",
    "dev": "astro dev --root .",
    "dev:static": "node --import tsx scripts/start-static-site-dev.mjs",
    "dev:bg": "node scripts/start-static-site-dev.mjs --background",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs",
    "dev:stop": "astro dev stop",
    "dev:clean": "pnpm clean:dev-cache && astro dev --root .",
    "assets:check": "tsx scripts/check-assets.ts",
    "cache:policy:check": "tsx scripts/check-static-cache-policy.ts",
    "cache:policy:hosted-audit": "tsx scripts/check-hosted-cache-policy.ts",
    "brand-font:check": "tsx scripts/check-brand-font.ts",
    "image-markup:check": "tsx scripts/check-image-markup.ts",
    "prd:holding:prepare": "tsx scripts/prepare-prd-holding.ts",
    "prd:holding:check": "tsx scripts/check-prd-holding.ts",
    "build": "astro build --root . && pnpm cache:policy:check && pnpm brand-font:check && pnpm image-markup:check",
    "preview": "astro preview --root .",
    "check": "node ../../scripts/feedback-guard.mjs @blackbox/web:check && astro check --root .",
    "test:lightweight": "node ../../scripts/feedback-guard.mjs @blackbox/web:test:lightweight && vitest run --config vitest.config.ts",
    "test:request": "node ../../scripts/feedback-guard.mjs @blackbox/web:test:request && vitest run --config vitest.request.config.ts",
    "test": "node ../../scripts/feedback-guard.mjs @blackbox/web:test && vitest run --config vitest.modules.config.ts",
    "test:unit": "node ../../scripts/feedback-guard.mjs @blackbox/web:test:unit && vitest run --config vitest.modules.config.ts",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@blackbox/api-client": "workspace:*",
    "@blackbox/content-model": "workspace:*",
    "@portabletext/react": "8.0.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@sindresorhus/slugify": "^3.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.3.5",
    "astro-portabletext": "1.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "2.0.1",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "robot3": "^1.2.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "lenis": "1.3.26",
    "motion": "13.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "^24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "msw": "2.15.0",
    "shadcn": "4.21.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "typecheck": {
        "command": "pnpm --filter @blackbox/web check",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/apps/web/**/*"
        ]
      },
      "build": {
        "command": "pnpm build:web",
        "cache": false
      },
      "lint": {
        "command": "pnpm exec eslint apps/web --max-warnings=0 --no-warn-ignored"
      }
    },
    "implicitDependencies": [
      "storefront-catalog",
      "web-platform",
      "ui-foundation",
      "checkout-web",
      "store-cart",
      "player",
      "app-shell",
      "web-pages",
      "web-layouts",
      "web-test-support"
    ],
    "tags": [
      "scope:web"
    ],
    "namedInputs": {
      "default": [
        "{workspaceRoot}/apps/web/**/*",
        "toolchain"
      ]
    }
  }
}

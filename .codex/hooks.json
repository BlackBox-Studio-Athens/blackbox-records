{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/webstorm-workflow.mjs\"",
            "commandWindows": "node .codex/hooks/webstorm-workflow.mjs",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|mcp__(webstorm|intellij)__(apply_patch|create_new_file|reformat_file|rename_refactoring)|mcp__webstorm__execute_tool)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/webstorm-workflow.mjs\"",
            "commandWindows": "node .codex/hooks/webstorm-workflow.mjs",
            "timeout": 3,
            "statusMessage": "Checking WebStorm workflow requirements"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(mcp__(webstorm|intellij)__rename_refactoring|mcp__webstorm__execute_tool)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/webstorm-workflow.mjs\"",
            "commandWindows": "node .codex/hooks/webstorm-workflow.mjs",
            "timeout": 3
          }
        ]
      }
    ]
  }
}

{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/webstorm-workflow.mjs\"",
            "commandWindows": "node .codex/hooks/webstorm-workflow.mjs",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|mcp__intellij__(apply_patch|create_new_file|reformat_file|execute_run_configuration|execute_tool))$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/webstorm-workflow.mjs\"",
            "commandWindows": "node .codex/hooks/webstorm-workflow.mjs",
            "timeout": 3,
            "statusMessage": "Checking WebStorm workflow requirements"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch|mcp__intellij__(apply_patch|create_new_file|reformat_file|rename_refactoring|execute_run_configuration|execute_tool))$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/webstorm-workflow.mjs\"",
            "commandWindows": "node .codex/hooks/webstorm-workflow.mjs",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/webstorm-workflow.mjs\"",
            "commandWindows": "node .codex/hooks/webstorm-workflow.mjs",
            "timeout": 300
          }
        ]
      }
    ]
  }
}

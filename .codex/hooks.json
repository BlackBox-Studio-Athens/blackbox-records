{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/webstorm-workflow.mjs\"",
            "commandWindows": "node .codex/hooks/webstorm-workflow.mjs",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-check",
            "commandWindows": "C:/Users/SVall/.local/bin/graphify.exe hook-check",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-hooks/command-guard.mjs\"",
            "commandWindows": "node scripts/agent-hooks/command-guard.mjs",
            "timeout": 10,
            "statusMessage": "Checking feedback policy"
          }
        ]
      }
    ]
  }
}

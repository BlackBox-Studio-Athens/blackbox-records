{
  "name": "@blackbox/api-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./public": "./src/public-client.ts",
    "./internal": "./src/internal-client.ts",
    "./test/msw-handlers": "./src/test/msw-handlers.ts"
  },
  "scripts": {
    "generate": "pnpm exec tsx scripts/generate-api-client.ts",
    "check": "node ../../scripts/feedback-guard.mjs @blackbox/api-client:check && tsc --noEmit --incremental --tsBuildInfoFile ../../.codex-artifacts/typecheck/api-client.tsbuildinfo -p tsconfig.json",
    "test": "node ../../scripts/feedback-guard.mjs @blackbox/api-client:test && vitest run"
  },
  "dependencies": {
    "openapi-typescript-fetch": "^2.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "msw": "2.15.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "test": {
        "command": "pnpm --filter @blackbox/api-client test",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/apps/backend/openapi/**/*"
        ]
      },
      "test-watch": {
        "command": "pnpm --filter @blackbox/api-client exec vitest --watch",
        "continuous": true,
        "cache": false
      },
      "typecheck": {
        "command": "pnpm --filter @blackbox/api-client check"
      },
      "lint": {
        "command": "pnpm exec eslint packages/api-client --max-warnings=0 --no-warn-ignored"
      }
    },
    "tags": [
      "module",
      "scope:api-client"
    ]
  }
}

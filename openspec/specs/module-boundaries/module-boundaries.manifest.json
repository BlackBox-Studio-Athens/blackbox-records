{
  "version": 2,
  "status": "active",
  "strategy": "typescript-native-modulith",
  "coverage": {
    "scope": "all-claimed-roots",
    "eslint": "import-bearing-files",
    "audit": "all-claimed-roots"
  },
  "ownershipGranularity": "native-nx-project-roots",
  "contractNotes": {
    "performance-resume": "Native project.json contracts provide lightweight checkout presentation, the lazy newsletter form and bundled public font assets, permit checkout-core to consume @blackbox/api-client/public delivery constants, and permit backend-runtime to create a commerce-persistence binding scope.",
    "international-order-notice": "store-cart provides InternationalOrderNotice.tsx to Store pages, layouts and checkout through its native project.json contract. The browser country gate and email template remain presentation-only; store-cart acquires no checkout-client or payment dependency."
  },
  "compatibilityFacades": "disallowed",
  "entrypointPolicy": {
    "default": "root-first",
    "allowedNamedEntrypoints": ["api.ts", "spi.ts"],
    "namedEntrypointRules": {
      "api.ts": "secondary-consumer-api-only",
      "spi.ts": "provider-implemented-contracts-only"
    },
    "disallowedModuleDirectoryNames": ["ports", "adapters"],
    "approvedModuleDirectoryNameExceptions": {},
    "workspacePackageExportsArePreferredForRealPackages": true
  },
  "verification": {
    "eslint": {
      "tool": "eslint-plugin-boundaries",
      "primaryRule": "boundaries/dependencies",
      "classificationRule": "boundaries/no-unknown-files",
      "mode": "strict-on-covered-module-roots",
      "ciGate": "pnpm check"
    },
    "dependencyGraph": {
      "tool": "dependency-cruiser",
      "severity": "error",
      "checks": ["no-circular", "allowed-dependencies", "no-deep-cross-module-imports", "package-export-only-access"]
    },
    "manifestAudit": {
      "tool": "scripts/audit-module-boundaries.ts",
      "ciGate": "pnpm check",
      "architectureTest": "apps/backend/test/architecture/module-boundaries-manifest.test.ts"
    }
  },
  "workspaceBoundaries": {
    "@blackbox/web": {
      "level": "workspace-package",
      "packageJson": "apps/web/package.json"
    },
    "@blackbox/staff": {
      "level": "workspace-package",
      "packageJson": "apps/staff/package.json"
    },
    "@blackbox/backend": {
      "level": "workspace-package",
      "packageJson": "apps/backend/package.json"
    },
    "@blackbox/api-client": {
      "level": "workspace-package",
      "packageJson": "packages/api-client/package.json",
      "exports": {
        ".": "packages/api-client/src/index.ts",
        "./public": "packages/api-client/src/public-client.ts",
        "./internal": "packages/api-client/src/internal-client.ts"
      },
      "deepImportBypassPatterns": ["@blackbox/api-client/src/**", "@blackbox/api-client/src/generated/**"]
    },
    "@blackbox/content-model": {
      "description": "Pure editorial, rich-text, native revision and immutable snapshot validation shared by CMS and static builds.",
      "level": "workspace-package",
      "exports": {
        ".": "packages/content-model/src/index.ts"
      },
      "packageJson": "packages/content-model/package.json",
      "deepImportBypassPatterns": ["@blackbox/content-model/src/**"]
    }
  }
}
